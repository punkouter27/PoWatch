@implements IDisposable
@using System.Globalization
@inject SensingSession Sensing
@inject DrawerState Drawers
@inject NavigationManager Navigation

@* One row: brand, section keys, then status, Start/Stop, bell and Settings at the right. The AI model
   choices are a strip on Live; section keys become the phone's bottom tab bar. *@
<header class="term-header" data-test="term-header">
    <a class="term-brand" href="" aria-label="PoWatch home">
        PoWatch
    </a>

    <NavBar />

    @* Only the state word is a live region: the uptime ticks every second and would otherwise be
       read out every second. *@
    <span class="term-status @(Sensing.IsRunning ? (Sensing.Live.Demo ? "term-status--demo" : "term-status--live") : string.Empty)"
          data-test="session-status"
          title="@(Sensing.Live.Demo ? "Numbers come from a scripted demo scene, not a real camera" : null)">
        <span aria-hidden="true">● </span><span role="status">@(Sensing.IsRunning ? "OBSERVING" : "STANDBY")</span>@if (Sensing.IsRunning)
        {
            <span class="term-status-detail"> · @Uptime</span>
        }
    </span>

    @if (Sensing.IsRunning)
    {
        <button class="term-button term-button--danger" @onclick="Sensing.StopAsync" data-test="header-stop">Stop</button>
    }
    else if (ShowStart)
    {
        <a class="term-button term-button--primary" href="?start=camera" data-test="header-start">Start</a>
    }

    <Tray />

    @* Unsent batches are invisible everywhere else: this is the one place that says the outbox has
       work, with a way to push it now (a chip, not a dialog — the queued ticks are not an error). *@
    @if (Sensing.Live.PendingBatches > 0)
    {
        <button type="button" class="term-outbox" @onclick="FlushOutboxAsync" data-test="outbox-chip"
                title="10-second batches waiting in this browser's outbox. They resend automatically; press to send now.">
            @Sensing.Live.PendingBatches queued
        </button>
    }
    @if (Sensing.Live.LostTicks > 0)
    {
        <span class="term-outbox term-outbox--lost" data-test="outbox-lost"
              title="Ticks dropped because the outbox was full (storage full or a very long offline stretch)">
            @Sensing.Live.LostTicks lost
        </span>
    }

    @* Dark or light, remembered in this browser (theme-controller.js); one press, no trip into Settings. *@
    <button type="button" class="term-icon-button" onclick="powatchTheme.toggle()"
            aria-label="Switch between dark and light" title="Dark / light" data-test="theme-toggle">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" /></svg>
    </button>

    <button type="button" class="term-icon-button @(SettingsOpen ? "term-icon-button--on" : null)" @onclick="ToggleSettings"
            aria-label="Settings" aria-expanded="@(SettingsOpen ? "true" : "false")" title="Settings: recording, people, alerts and sharing, advanced" data-test="settings-menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
    </button>

    @* Inside the header so it hangs from its bottom edge (terminal.css), like the bell's drawer. *@
    <Drawer Title="Settings" Open="@Drawers.IsOpen(DrawerState.Settings)" OnClose="Drawers.Close" Test="settings-drawer">
        <SettingsPanel Section="@Drawers.Section" />
    </Drawer>
</header>

@code {
    private Timer? _clock;

    /// <summary>False on Live, where the camera panel has its own start controls.</summary>
    [Parameter] public bool ShowStart { get; set; } = true;

    /// <summary>On the Settings page itself the gear just shows where you are.</summary>
    private bool OnSettingsPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("settings", StringComparison.OrdinalIgnoreCase);

    private bool SettingsOpen => OnSettingsPage || Drawers.IsOpen(DrawerState.Settings);

    private void ToggleSettings()
    {
        if (!OnSettingsPage) Drawers.Toggle(DrawerState.Settings);
    }

    private string Uptime => Sensing.Live.StartedUtc is { } started
        ? (DateTimeOffset.UtcNow - started).ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture)
        : "--:--:--";

    /// <summary>Send whatever is waiting instead of waiting for the next automatic pass.</summary>
    private Task FlushOutboxAsync() => Sensing.SendOutboxAsync();

    protected override void OnInitialized()
    {
        Sensing.Changed += OnChanged;
        Drawers.Changed += OnChanged;
        Navigation.LocationChanged += OnNavigated;
        // Only the uptime ticks, so only a running session needs a per-second render.
        _clock = new Timer(_ => { if (Sensing.IsRunning) InvokeAsync(StateHasChanged); }, null, 1000, 1000);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnNavigated(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => OnChanged();

    public void Dispose()
    {
        Sensing.Changed -= OnChanged;
        Drawers.Changed -= OnChanged;
        Navigation.LocationChanged -= OnNavigated;
        _clock?.Dispose();
    }
}
