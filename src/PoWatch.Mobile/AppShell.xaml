<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PoWatch.Mobile.Pages"
       x:Class="PoWatch.Mobile.AppShell"
       Title="PoWatch">

    <TabBar>
        <ShellContent Title="Live" Route="live" ContentTemplate="{DataTemplate pages:LivePage}" />
        <ShellContent Title="Journal" Route="journal" ContentTemplate="{DataTemplate pages:JournalPage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
