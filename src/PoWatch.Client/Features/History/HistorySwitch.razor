@* The Stories tab strip: every session, the week, the month. Plain links, so each has its own address. *@
<nav class="term-tabbar" aria-label="Stories" data-test="history-switch">
    @foreach (var (key, label, href, test) in Tabs)
    {
        <a class="term-tab @(Active == key ? "term-tab--on" : null)" href="@href" aria-current="@(Active == key ? "page" : null)" data-test="@test">@label</a>
    }
</nav>

@code {
    /// <summary>sessions, week or month; anything else (a session's own page) lights none.</summary>
    [Parameter] public string? Active { get; set; }

    private static readonly (string Key, string Label, string Href, string Test)[] Tabs =
    [
        ("sessions", "Sessions", "stories", "history-stories-link"),
        ("week", "Week", "stories?view=week", "story-view-week"),
        ("month", "Month", "stories?view=month", "story-view-month"),
    ];
}
