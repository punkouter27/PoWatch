@* The top of a day in the Journal: the day in a paragraph (the template first, a model's rewording when
   one arrives), its downloads and a share link. *@
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (Recap is null || Presence is not { SecondsObserved: > 0 })
{
    @if (Loaded)
    {
        <p class="term-empty">No recap: nothing was observed on this day.</p>
    }
    else
    {
        <Skeleton Heights="@([90, 220])" Span="term-span-4" />
    }
}
else
{
    <div class="history-recap" data-test="history-recap">
        @* Keyed on who wrote it: when a model's version replaces the template's, it eases in. *@
        <p class="recap-summary fx-rise" @key="Recap.Source">@Recap.Summary</p>
        @if (Recap.Highlights.Count > 0)
        {
            <ul class="recap-highlights">
                @foreach (var highlight in Recap.Highlights)
                {
                    <li>@highlight</li>
                }
            </ul>
        }
        <div class="history-recap-foot reader-actions">
            <span class="term-stat-hint">WRITTEN BY @Recap.Source.ToUpperInvariant()@(Rewriting ? " · A MODEL IS REWORDING IT…" : string.Empty)</span>
            <ExportMenu Test="day-export">
                <a class="term-menu-item" href="@PoWatchApiClient.DayRecapPdfUrl(Day, TimeZoneInfo.Local.Id)" download="PoWatch-@(DayKey).pdf" onclick="return powatchFiles.save(event, this)" data-test="history-recap-pdf"><span>Recap <i>this page, as a PDF</i></span><b>PDF</b></a>
                <a class="term-menu-item" href="@PoWatchApiClient.AllStatsUrl(StatsQuery.ForDay(Day))" download="PoWatch-@(DayKey).json" data-test="history-day-json"><span>Everything stored <i>every tick, event and stat of the day</i></span><b>JSON</b></a>
            </ExportMenu>
            @if (_share is null)
            {
                <button class="term-button" @onclick="ShareAsync" disabled="@_sharing" title="A read-only page of this recap that works without signing in, for 7 days" data-test="history-share">@(_sharing ? "Sharing…" : "Share ↗")</button>
            }
        </div>
        @if (_share is { } share)
        {
            <div class="history-share" data-test="history-share-link">
                <label class="visually-hidden" for="share-url">Link to this recap</label>
                <input id="share-url" readonly value="@ShareUrl(share)" onfocus="this.select()" />
                <button class="term-button" @onclick="() => CopyAsync(share)">@(_copied ? "Copied" : "Copy")</button>
                <button class="term-button term-button--danger" @onclick="() => TakeDownAsync(share)" title="The link stops working at once">Take down</button>
                <span class="term-stat-hint">WORKS WITHOUT SIGNING IN UNTIL @share.ExpiresUtc.ToLocalTime().ToString("d MMM", CultureInfo.CurrentCulture).ToUpperInvariant() · NO CAMERA IMAGES</span>
            </div>
        }
        @if (_shareError is not null)
        {
            <p class="live-error" role="alert">@_shareError</p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public DateOnly Day { get; set; }
    [Parameter] public RecapDto? Recap { get; set; }
    [Parameter] public PresenceStatsDto? Presence { get; set; }
    [Parameter] public bool Loaded { get; set; }
    [Parameter] public bool Rewriting { get; set; }

    private DateOnly? _shareDay;
    private ShareDto? _share;
    private bool _sharing;
    private bool _copied;
    private string? _shareError;

    private string DayKey => DisplayText.DayKey(Day);

    protected override void OnParametersSet()
    {
        // A link belongs to the day it was made for.
        if (Day != _shareDay) (_share, _shareError, _copied, _shareDay) = (null, null, false, Day);
    }

    private string ShareUrl(ShareDto share) => Navigation.BaseUri + share.Path;

    private async Task ShareAsync()
    {
        (_sharing, _shareError) = (true, null);
        _share = await Api.CreateShareAsync(Day, days: 7);
        if (_share is null) _shareError = "Could not make a link — nothing was observed that day, or the server did not answer.";
        _sharing = false;
    }

    private async Task CopyAsync(ShareDto share) => _copied = await JS.TryInvokeVoidAsync("navigator.clipboard.writeText", ShareUrl(share));

    private async Task TakeDownAsync(ShareDto share)
    {
        if (await Api.RevokeShareAsync(share.Token)) (_share, _copied) = (null, false);
        else _shareError = "Could not take the link down — try again, or from Settings.";
    }
}
