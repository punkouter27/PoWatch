@* A tiny inline SVG trend line. Supports an optional faint Baseline (e.g. usual day), a dashed Average
   reference line with an inline label, a vertical NowSlot hairline, and AxisLabels beneath. *@
<div class="term-spark-wrap">
    <svg class="term-spark @(Cyan ? "term-spark--cyan" : string.Empty)" viewBox="0 0 100 28" preserveAspectRatio="none"
         role="img" aria-label="@Label">
        @if (_baseline.Length > 0)
        {
            <polyline class="term-spark-base" points="@_baseline" />
        }
        @if (_avgY is { } avgY)
        {
            <line class="term-spark-avg" x1="0" y1="@avgY" x2="100" y2="@avgY" />
        }
        @if (_nowX is { } x)
        {
            <line class="term-spark-now" x1="@x" y1="0" x2="@x" y2="28" />
        }
        @if (_points.Length > 0)
        {
            <polyline points="@_points" />
        }
    </svg>
    @if (!string.IsNullOrEmpty(AverageLabel))
    {
        <span class="term-spark-avg-label">@AverageLabel</span>
    }
    @if (AxisLabels is { Length: > 0 })
    {
        <div class="term-spark-axis" aria-hidden="true">
            @foreach (var lbl in AxisLabels)
            {
                <span>@lbl</span>
            }
        </div>
    }
</div>

@code {
    private string _points = string.Empty;
    private string _baseline = string.Empty;
    private string? _nowX;
    private string? _avgY;

    [Parameter, EditorRequired] public IReadOnlyList<double> Values { get; set; } = [];

    /// <summary>Fixed top of the scale; the larger of both series' maxima when null.</summary>
    [Parameter] public double? Max { get; set; }

    /// <summary>A second series drawn faintly behind Values, on the same scale.</summary>
    [Parameter] public IReadOnlyList<double>? Baseline { get; set; }

    /// <summary>Optional average value drawn as a dashed horizontal reference line.</summary>
    [Parameter] public double? Average { get; set; }

    /// <summary>Optional compact text shown under the graph (e.g. "1m avg 61").</summary>
    [Parameter] public string? AverageLabel { get; set; }

    /// <summary>How many points span the full width; Values' own count when null. Set it to draw a partial day.</summary>
    [Parameter] public int? Slots { get; set; }

    /// <summary>Optional 0-based slot index to highlight with a vertical "now" hairline.</summary>
    [Parameter] public int? NowSlot { get; set; }

    /// <summary>Optional labels distributed evenly under the sparkline (e.g. ["00:00", "12:00", "23:00"]).</summary>
    [Parameter] public string[]? AxisLabels { get; set; }

    [Parameter] public bool Cyan { get; set; }
    [Parameter] public string Label { get; set; } = "Trend";

    protected override void OnParametersSet()
    {
        var max = Max ?? Math.Max(Math.Max(Values.DefaultIfEmpty().Max(), Baseline?.DefaultIfEmpty().Max() ?? 0), Average ?? 0);
        if (max <= 0) max = 1;
        var slots = Slots ?? Values.Count;
        _points = Line(Values, slots, max);
        _baseline = Baseline is null ? string.Empty : Line(Baseline, Slots ?? Baseline.Count, max);
        _nowX = NowSlot is { } n && slots >= 2
            ? FormattableString.Invariant($"{Math.Clamp(n, 0, slots - 1) * (100.0 / (slots - 1)):0.##}")
            : null;
        _avgY = Average is { } avg && double.IsFinite(avg)
            ? FormattableString.Invariant($"{27 - (Math.Clamp(avg / max, 0, 1) * 26):0.##}")
            : null;
    }

    private static string Line(IReadOnlyList<double> values, int slots, double max)
    {
        if (values.Count < 2 || slots < 2) return string.Empty;
        var step = 100.0 / (slots - 1);
        return string.Join(' ', values.Take(slots).Select((v, i) =>
            FormattableString.Invariant($"{i * step:0.##},{27 - (Math.Clamp(v / max, 0, 1) * 26):0.##}")));
    }
}
