<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Runs in the browser too: IsAotCompatible turns on the trim, AOT and single-file analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Form rules shared by the browser (inline errors) and the API (ValidationProblem): Validation/. -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
