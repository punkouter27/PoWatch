@inherits SettingsTab

@* Where the daily weather beside each day comes from (Open-Meteo); saved with the account, not the browser. *@
<TerminalPanel Title="Weather" Test="weather-settings" Flush="true">
    <Aside>SAVED WITH YOUR ACCOUNT</Aside>
    <ChildContent>
        @if (Profile is null)
        {
            <p class="term-empty">@ProfileMissing</p>
        }
        else
        {
            <div class="settings-place" data-test="weather-place">
                <span>Weather from <i>daily weather beside each day</i></span>
                @if (Profile.Place is { } place)
                {
                    <b>@place.Name.ToUpperInvariant()</b>
                    <button class="term-icon-button" @onclick="ClearPlaceAsync" disabled="@Saving" aria-label="Stop showing weather" title="Stop showing weather">✕</button>
                }
                else
                {
                    <b>OFF</b>
                }
            </div>
            <form class="settings-search" @onsubmit="SearchPlacesAsync">
                <label class="visually-hidden" for="place-search">Find a town or city</label>
                <input id="place-search" @bind="_placeQuery" placeholder="Find a town or city…" autocomplete="off" maxlength="80" data-test="place-search" />
                <button type="submit" class="term-button" disabled="@_searching" data-test="place-search-go">@(_searching ? "…" : "Find")</button>
            </form>
            @if (_places is { } places)
            {
                @if (places.Count == 0)
                {
                    <p class="term-stat-hint">NO PLACE BY THAT NAME</p>
                }
                <ul class="settings-results" data-test="place-results">
                    @foreach (var found in places)
                    {
                        <li><button class="term-menu-item" @onclick="() => SavePlaceAsync(found)" disabled="@Saving"><span>@found.Name <i>@found.Detail</i></span><b>USE</b></button></li>
                    }
                </ul>
            }
            @if (ProfileMessage is not null)
            {
                <p class="term-stat-hint settings-note" role="status">@ProfileMessage</p>
            }
        }
    </ChildContent>
</TerminalPanel>

@code {
    private string? _placeQuery;
    private bool _searching;
    private IReadOnlyList<PlaceDto>? _places;

    protected override Task OnInitializedAsync() => LoadProfileAsync();

    private async Task SearchPlacesAsync()
    {
        if (string.IsNullOrWhiteSpace(_placeQuery)) return;
        _searching = true;
        _places = await Api.SearchPlacesAsync(_placeQuery.Trim());
        _searching = false;
    }

    private async Task SavePlaceAsync(PlaceDto place)
    {
        await SaveProfileAsync(p => new() { RetentionDays = p.RetentionDays, Place = place, DigestEmail = p.DigestEmail }, $"Weather now comes from {place.Name}.");
        (_places, _placeQuery) = (null, null);
    }

    private Task ClearPlaceAsync() => SaveProfileAsync(p => new() { RetentionDays = p.RetentionDays, Place = null, DigestEmail = p.DigestEmail }, "Weather is off.");
}
