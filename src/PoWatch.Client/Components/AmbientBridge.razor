@* The room, felt rather than read: tells cues.js what just entered (each kind has its own chirp) and
   how many things are in frame (the hum), and tints the background with the room's light (--room-light).
   Renders nothing; works with Advanced off, and is silent when the sound level is off. *@
@implements IDisposable
@using System.Globalization
@using PoWatch.Shared.Services.Tracking
@inject SensingSession Sensing
@inject IJSRuntime JS

@code {
    private LiveSensingState? _live;
    private readonly Dictionary<string, int> _seen = new(StringComparer.OrdinalIgnoreCase);
    private int _seenTotal;
    private int _count = -1;
    private double? _light;

    protected override void OnInitialized() => Sensing.Changed += OnChanged;

    private void OnChanged()
    {
        if (!Sensing.IsRunning)
        {
            Reset();
            return;
        }

        var live = Sensing.Live;
        if (!ReferenceEquals(live, _live))
        {
            _live = live;
            _seen.Clear();
            _seenTotal = 0;
        }

        Announce(live);

        var count = live.PeopleNow + live.AnimalsNow;
        if (count != _count)
        {
            _count = count;
            _ = JS.TryInvokeVoidAsync("powatchCues.ambient", count);
        }

        // Light moves slowly and the tint is faint: only a visible step re-styles the page.
        if (live.Light is { } light && (_light is not { } last || Math.Abs(light - last) >= 0.03))
        {
            _light = light;
            _ = JS.TryInvokeVoidAsync("document.documentElement.style.setProperty", "--room-light", light.ToString("0.00", CultureInfo.InvariantCulture));
        }
    }

    /// <summary>
    /// ClassesSeen counts every entry by label, so its growth since the last change is what just came
    /// in. People and animals pair with the session's own "enter" cue (which knows the side); objects,
    /// which the session does not announce, get their own quiet tick.
    /// </summary>
    private void Announce(LiveSensingState live)
    {
        var total = live.ClassesSeen.Values.Sum();
        if (total == _seenTotal) return;
        _seenTotal = total;

        var presence = new List<string>();
        var objects = false;
        foreach (var (label, seen) in live.ClassesSeen)
        {
            var added = seen - _seen.GetValueOrDefault(label);
            _seen[label] = seen;
            if (added <= 0) continue;
            if (CentroidTracker.IsPresence(label)) presence.AddRange(Enumerable.Repeat(label, added));
            else objects = true;
        }

        if (presence.Count > 0) _ = JS.TryInvokeVoidAsync("powatchCues.entered", string.Join(',', presence));
        if (objects) _ = JS.TryInvokeVoidAsync("powatchCues.play", "enter:object", 0);
    }

    private void Reset()
    {
        if (_count < 0 && _light is null) return;
        _count = -1;
        _light = null;
        _ = JS.TryInvokeVoidAsync("powatchCues.ambient", -1);
        _ = JS.TryInvokeVoidAsync("document.documentElement.style.removeProperty", "--room-light");
    }

    public void Dispose() => Sensing.Changed -= OnChanged;
}
