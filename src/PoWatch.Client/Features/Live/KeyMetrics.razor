@* Live's headline numbers for the range beside your usual day, and how far today sits from it (σ).
   Head counts (now, peak, visits) are In frame's; the third headline number, activity, has its own panel. *@

<TerminalPanel Title="Key metrics" Class="@(Unusual ? "cell-metrics panel-alert" : "cell-metrics")" Test="live-metrics" Flush="true">
    <Aside>@(Unusual ? "UNUSUAL · " : null)@Range.ToUpperInvariant() vs USUAL</Aside>
    <ChildContent>
        <div class="metric-cards">
            <RadzenCard class="metric-card" data-test="metric-occupancy">
                <StatCell Label="Occupancy" Value="@DisplayText.Percent(Presence?.Occupancy)"
                          Hint="@($"Usual {DisplayText.Percent(Anomaly("occupancy")?.Mean)}")" Test="stats-occupancy">
                    <ZChip Z="@Anomaly("occupancy")?.Z" />
                </StatCell>
                <Sparkline Values="@OccupancyTrend" Max="1" Label="Occupancy over the session" />
            </RadzenCard>
            @if (!RateTooEarly)
            {
                <RadzenCard class="metric-card">
                    <StatCell Label="Visits per hour" Value="@DisplayText.Number(Presence?.VisitsPerHour, "0.0")"
                              Hint="@($"Usual {DisplayText.Number(Anomaly("visits/hour")?.Mean, "0.0")}")">
                        <ZChip Z="@Anomaly("visits/hour")?.Z" />
                    </StatCell>
                    <Sparkline Values="@VisitsTrend" Cyan="true" Label="Visits over the session" />
                </RadzenCard>
            }
            @if (Patterns is { TodayProfile.Count: 24, UsualProfile.Count: 24 } day && day.UsualProfile.Any(v => v > 0))
            {
                <RadzenCard class="metric-card" data-test="metric-day-shape">
                    <StatCell Label="Today vs usual" Value="@($"{DateTime.Now.Hour:00}:00")"
                              Hint="Occupancy by hour; the faint line is your usual day" />
                    <Sparkline Values="@day.TodayProfile.Take(DateTime.Now.Hour + 1).ToList()" Baseline="@day.UsualProfile" Slots="24"
                               Label="Today's occupancy by hour over your usual day" />
                </RadzenCard>
            }
        </div>
        <FactRow Test="metric-patterns" Facts="@([
            new("Rhythm", Rhythm, "How closely today's hour-by-hour curve follows your usual day: +1.00 is textbook, 0 unrelated, below 0 upside down"),
            new("Next busy", Patterns?.NextBusyHour is { } hour ? $"{hour:00}:00" : null, "The next hour that is usually busiest, from the last 28 days"),
            new("4-week trend", Trend, "How occupancy has been moving per day over the last 28 days"),
        ])" />
    </ChildContent>
</TerminalPanel>

@code {
    /// <summary>Visits an hour from a few minutes (342/h after 55 s) says nothing; the row waits for ten.</summary>
    private bool RateTooEarly => Presence is null || Presence.SecondsObserved < 600;

    [Parameter, EditorRequired] public string Range { get; set; } = "today";
    [Parameter] public PresenceStatsDto? Presence { get; set; }
    [Parameter] public PatternStatsDto? Patterns { get; set; }
    [Parameter] public IReadOnlyList<double> OccupancyTrend { get; set; } = [];
    [Parameter] public IReadOnlyList<double> VisitsTrend { get; set; } = [];

    private AnomalyDto? Anomaly(string metric) => Patterns?.Anomalies.FirstOrDefault(a => a.Metric == metric);

    /// <summary>Occupancy, or visits once the rate is shown, is 2σ or more from usual: the panel lights up.</summary>
    private bool Unusual => ZChip.IsUnusual(Anomaly("occupancy")?.Z) || (!RateTooEarly && ZChip.IsUnusual(Anomaly("visits/hour")?.Z));

    /// <summary>"+0.82 typical": today's curve against the usual one; null until today has a shape.</summary>
    private string? Rhythm => Patterns?.RhythmScore is { } r
        ? string.Create(CultureInfo.InvariantCulture, $"{r:+0.00;-0.00} {(r >= 0.8 ? "typical" : r >= 0.4 ? "loose" : r >= 0 ? "off-beat" : "flipped")}")
        : null;

    /// <summary>"↑ 0.4 pts/day" in occupancy percentage points; flat under 0.05.</summary>
    private string? Trend => Patterns is not { Calendar.Count: >= 7 } p
        ? null
        : Math.Abs(p.OccupancyTrendPerDay * 100) < 0.05
            ? "flat"
            : string.Create(CultureInfo.InvariantCulture, $"{(p.OccupancyTrendPerDay > 0 ? "↑" : "↓")} {Math.Abs(p.OccupancyTrendPerDay * 100):0.0} pts/day");
}
