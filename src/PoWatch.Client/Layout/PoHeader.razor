@using System.Security.Claims
@using PoWatch.Shared.Services
@implements IDisposable
@inject SensingSession Sensing
@inject DrawerState Drawers
@inject LiveHeaderState LiveHeader
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The page shell header (AGENTS.md, Page shell): the app name upper-left, the signed-in email (or
   the Sign in button) upper-right, on every page signed in and out. Bare (MainLayout signed out:
   sign-in, /diag, not-found) keeps just those; the full header consolidates the section keys,
   session label, recording controls, system health, AI models, Live panels menu, bell, and outbox. *@
<header class="term-header po-header" data-test="term-header">
    <a class="term-brand po-header__title" href="/" data-test="header-title">PoWatch</a>

    @if (!Bare)
    {
        <NavBar />

        @if (LiveHeader.IsLiveActive && !string.IsNullOrEmpty(LiveHeader.WindowLabel))
        {
            <span class="header-session-label term-stat-hint" data-test="stats-window" title="@LiveHeader.WindowLabel">@LiveHeader.WindowLabel</span>
        }
    }

    <span class="term-header-spacer" aria-hidden="true"></span>

    @if (!Bare)
    {
        <SessionControls />

        <a href="diag" class="term-button session-health" data-test="session-health" title="System status and diagnostics">
            @HealthLabel
        </a>

        <AiSelectors />

        @if (LiveHeader.IsLiveActive)
        {
            <details class="export-menu panels-menu" data-test="panels-menu">
                <summary class="term-button" title="Show, hide and reorder the panels">
                    <span class="panels-menu-label">Panels </span>@(LiveHeader.VisiblePanels.Count)/@LivePanels.All.Count ▾
                </summary>
                <div class="export-menu-items panels-menu-items">
                    <div class="panels-menu-all">
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Disabled="@(LiveHeader.Hidden.Count == 0)" Click="ShowAllPanelsAsync" data-test="panels-show-all">Show all</RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Disabled="@(LiveHeader.VisiblePanels.Count == 0)" Click="HideAllPanelsAsync" data-test="panels-hide-all">Hide all</RadzenButton>
                    </div>
                    @foreach (var id in LiveHeader.Order)
                    {
                        var shown = !LiveHeader.Hidden.Contains(id);
                        <div @key="id" class="panels-menu-row">
                            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" role="switch" aria-checked="@(shown ? "true" : "false")"
                                          Click="() => SetPanelHiddenAsync(id, shown)" data-test="@($"panel-toggle-{id}")">
                                <span>@LivePanels.Title(id)</span><b>@(shown ? "ON" : "OFF")</b>
                            </RadzenButton>
                            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-icon-button" Disabled="@(LiveHeader.Order[0] == id)" title="Move earlier" aria-label="@($"Move {LivePanels.Title(id)} earlier")"
                                          Click="() => StepPanelAsync(id, -1)" data-test="@($"panel-up-{id}")">↑</RadzenButton>
                            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-icon-button" Disabled="@(LiveHeader.Order[^1] == id)" title="Move later" aria-label="@($"Move {LivePanels.Title(id)} later")"
                                          Click="() => StepPanelAsync(id, 1)" data-test="@($"panel-down-{id}")">↓</RadzenButton>
                        </div>
                    }
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" Disabled="@LiveHeader.IsDefaultLayout" Click="ResetPanelsAsync" data-test="panels-reset">
                        <span>Reset <i>every panel, in the original order</i></span><b>↺</b>
                    </RadzenButton>
                </div>
            </details>
        }

        <Tray />

        @* Unsent batches are invisible everywhere else: this is the one place that says the outbox has
           work, with a way to push it now (a chip, not a dialog — the queued ticks are not an error). *@
        @if (Sensing.Live.PendingBatches > 0)
        {
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-outbox" Click="FlushOutboxAsync" data-test="outbox-chip"
                    title="10-second batches waiting in this browser's outbox. They resend automatically; press to send now.">
                @Sensing.Live.PendingBatches queued
            </RadzenButton>
        }
        @if (Sensing.Live.LostTicks > 0)
        {
            <span class="term-outbox term-outbox--lost" data-test="outbox-lost"
                  title="Ticks dropped because the outbox was full (storage full or a very long offline stretch)">
                @Sensing.Live.LostTicks lost
            </span>
        }
    }

    @* The sign-in page shows the title only: its one action is the card's button. Signed out, the
       actions are just Sign in. *@
    @if (!OnSignInPage)
    {
        <div class="po-header__actions">
            <AuthorizeView>
                <Authorized Context="auth">
                    <span class="po-header__email" title="@EmailOf(auth.User)" data-test="header-email">@EmailOf(auth.User)</span>
                    @* No settings gear (owner, 2026-11-23): /settings (recording, people, alerts, sign out) opens
                       from Ctrl+K, and the bell's "watch rules" and "name everyone" links open it in the drawer. *@
                </Authorized>
                <NotAuthorized>
                    <a class="po-link-btn filled small" href="login" data-test="header-sign-in">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }

    @if (!Bare)
    {
        @* Inside the header so it hangs from its bottom edge (terminal-shell.css), like the bell's drawer. *@
        <Drawer Title="Settings" Open="@Drawers.IsOpen(DrawerState.Settings)" OnClose="Drawers.Close" Test="settings-drawer">
            <SettingsPanel Section="@Drawers.Section" />
        </Drawer>
    }
</header>

@code {
    /// <summary>Signed out (MainLayout): the title and Sign in only; no section keys or session controls.</summary>
    [Parameter] public bool Bare { get; set; }

    private bool OnSignInPage => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals("/login", StringComparison.OrdinalIgnoreCase);

    private string HealthLabel =>
        Sensing.Live.LastError is not null || Sensing.Live.LostTicks > 0 ? "Needs attention"
        : Sensing.Live.PendingBatches > 0 ? "Saving queued"
        : Sensing.IsRunning ? (Sensing.Paused ? "Paused" : "Sensing active")
        : "System status";

    /// <summary>The header shows the email, never a display name; the name is a last resort.</summary>
    internal static string EmailOf(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("preferred_username")?.Value ?? user.Identity?.Name ?? "Signed in";

    /// <summary>Send whatever is waiting instead of waiting for the next automatic pass.</summary>
    private Task FlushOutboxAsync() => Sensing.SendOutboxAsync();

    private Task ShowAllPanelsAsync() => LiveHeader.OnShowAll?.Invoke() ?? Task.CompletedTask;
    private Task HideAllPanelsAsync() => LiveHeader.OnHideAll?.Invoke() ?? Task.CompletedTask;
    private Task SetPanelHiddenAsync(string id, bool hide) => LiveHeader.OnSetHidden?.Invoke(id, hide) ?? Task.CompletedTask;
    private Task StepPanelAsync(string id, int by) => LiveHeader.OnStep?.Invoke(id, by) ?? Task.CompletedTask;
    private Task ResetPanelsAsync() => LiveHeader.OnResetLayout?.Invoke() ?? Task.CompletedTask;

    protected override void OnInitialized()
    {
        Sensing.Changed += OnSensingChanged;
        Drawers.Changed += OnDrawersChanged;
        LiveHeader.Changed += OnChanged;
        Navigation.LocationChanged += OnNavigated;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnDrawersChanged()
    {
        if (Drawers.Open is not null) _ = JS.TryInvokeVoidAsync("powatchMenus.closeMenus");
        OnChanged();
    }

    private object? _shown;

    /// <summary>The session changes several times a second; the header only draws these (the clock redraws the uptime).</summary>
    private void OnSensingChanged()
    {
        var now = (Sensing.IsRunning, Sensing.Paused, Sensing.Live.Demo, Sensing.Live.PendingBatches, Sensing.Live.LostTicks, Sensing.Live.LastError);
        if (now.Equals(_shown)) return;
        _shown = now;
        OnChanged();
    }

    private void OnNavigated(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = JS.TryInvokeVoidAsync("powatchMenus.closeMenus");
        OnChanged();
    }

    public void Dispose()
    {
        Sensing.Changed -= OnSensingChanged;
        Drawers.Changed -= OnDrawersChanged;
        LiveHeader.Changed -= OnChanged;
        Navigation.LocationChanged -= OnNavigated;
    }
}
