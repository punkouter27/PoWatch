@* How much is moving right now, against the usual day; then, from the body points (body-overlay.js),
   what each person is doing, how much their limbs move over the session, and whether the left and right
   sides move evenly. Body readings are this session's only (docs/adr/0003-body-readings-on-device.md). *@
@using PoWatch.Shared.Services
@inject SensingSession Sensing

<TerminalPanel Title="Activity" Class="@(ZChip.IsUnusual(Anomaly("motion")?.Z) ? "cell-activity panel-alert" : "cell-activity")" Test="live-activity" Flush="true">
    <Aside>@(ZChip.IsUnusual(Anomaly("motion")?.Z) ? "UNUSUAL · " : null)NOW vs USUAL@(Sensing.IsRunning && B.FullBodySeen ? " · FULL BODY" : null)</Aside>
    <ChildContent>
        <div class="metric-cards">
            <RadzenCard class="metric-card">
                <StatCell Label="Activity level" Value="@(Sensing.IsRunning ? L.Motion.ToString("P1", CultureInfo.InvariantCulture) : "—")"
                          Hint="@(Sensing.IsRunning ? $"Now · usual daily mean {DisplayText.Percent(Anomaly("motion")?.Mean)}" : "Available while observing")" Test="metric-motion">
                    <ZChip Z="@Anomaly("motion")?.Z" />
                </StatCell>
                <Sparkline Values="@L.MotionHistory" Label="Activity over the last minute" />
            </RadzenCard>
        </div>
        <FactRow Test="activity-facts" Facts="@([
            new("Peak now", Sensing.IsRunning && L.MotionHistory.Count > 0 ? L.MotionHistory.Max().ToString("P0", CultureInfo.InvariantCulture) : null, "The most motion in the last minute"),
            new("Busiest at", Presence?.BusiestStartUtc is { } busiest ? DisplayText.LocalTime(busiest) : null, Presence is { } p ? $"The busiest stretch this session started here, at {p.BusiestMotion.ToString("P0", CultureInfo.InvariantCulture)} motion" : null),
            new("Longest still", Presence is { LongestStillSeconds: >= 1 } still ? DisplayText.Duration(still.LongestStillSeconds) : null, "The longest stretch with no motion at all"),
        ])" />
        @if (Sensing.IsRunning && !L.Demo)
        {
            <WhoList Rows="@Doing()" Label="What each body in view is doing" Test="body-activity" />
            @if (B.MeanEnergy is { } mean)
            {
                <div class="live-census" data-test="body-energy" title="How much arms and legs move, measured against the body's own size, averaged every 5 seconds while someone is in view">
                    <span class="live-heat-label">ENERGY</span>@EnergyWord(mean) · mean @mean.ToString("P0", CultureInfo.InvariantCulture)
                    <Sparkline Values="@B.EnergyHistory" Max="1" Label="Limb energy over this session" />
                </div>
            }
            <ShareBar Label="Person-time by activity this session" Test="body-activity-bar" Legend="false"
                      Parts="@([.. B.ActivitySeconds.OrderByDescending(p => p.Value).Select(p => new ShareBar.Part(Word(p.Key), p.Value))])" />
            @if (ActivityLine() is { } done)
            {
                <p class="live-census" data-test="body-activity-split" title="Person-time this session per activity, read from body points on this machine">
                    <span class="live-heat-label">DOING</span>@done
                </p>
            }
            @if (BalanceLine() is { } balance)
            {
                <p class="live-census" data-test="body-balance" title="Left side's share of how far each side's limbs moved this session (50/50 is even), counted only while both sides were seen; and the mean tilt of the shoulders">
                    <span class="live-heat-label">LEFT/RIGHT</span>@balance
                </p>
            }
        }
    </ChildContent>
</TerminalPanel>

@code {
    [Parameter] public PatternStatsDto? Patterns { get; set; }

    /// <summary>The session's presence numbers, for its busiest stretch and longest stillness.</summary>
    [Parameter] public PresenceStatsDto? Presence { get; set; }

    private LiveSensingState L => Sensing.Live;

    private BodyReadings B => Sensing.Bodies;

    private AnomalyDto? Anomaly(string metric) => Patterns?.Anomalies.FirstOrDefault(a => a.Metric == metric);

    private List<WhoList.Row> Doing() =>
        [.. B.InView.Select(b => new WhoList.Row($"Body {b.Slot}",
            $"{Word(b.Activity)} · energy {b.Energy.ToString("P0", CultureInfo.InvariantCulture)}{(b.FullBody ? null : " · upper body")}"))];

    private static string Word(BodyActivity activity) => activity.ToString().ToLowerInvariant();

    private static string EnergyWord(double energy) => energy switch
    {
        < 0.05 => "calm",
        < 0.15 => "settled",
        < 0.35 => "fidgety",
        _ => "lively",
    };

    /// <summary>"still 20m 10s · gesturing 3m 02s · walking 40s", longest first; null before a second was read.</summary>
    private string? ActivityLine()
    {
        var parts = B.ActivitySeconds.Where(p => p.Value >= 1).OrderByDescending(p => p.Value)
            .Select(p => $"{Word(p.Key)} {DisplayText.Duration(p.Value)}").ToList();
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    /// <summary>"arms 48/52 · legs 55/45 · left shoulder 3° lower"; null before either side has moved enough.</summary>
    private string? BalanceLine()
    {
        var ic = CultureInfo.InvariantCulture;
        var parts = new List<string>(3);
        if (B.ArmBalance is { } arms) parts.Add(string.Create(ic, $"arms {arms * 100:0}/{(1 - arms) * 100:0}"));
        if (B.LegBalance is { } legs) parts.Add(string.Create(ic, $"legs {legs * 100:0}/{(1 - legs) * 100:0}"));
        if (B.ShoulderTilt is { } tilt)
            parts.Add(Math.Abs(tilt) < 1.5 ? "shoulders level" : string.Create(ic, $"{(tilt > 0 ? "left" : "right")} shoulder {Math.Abs(tilt):0}° lower"));
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }
}
