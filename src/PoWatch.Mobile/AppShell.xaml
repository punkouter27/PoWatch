<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PoWatch.Mobile.Pages"
       x:Class="PoWatch.Mobile.AppShell"
       Title="PoWatch">

    <TabBar>
        <ShellContent Title="Sentry" Route="sentry" ContentTemplate="{DataTemplate pages:SentryPage}" />
        <ShellContent Title="Outbox" Route="outbox" ContentTemplate="{DataTemplate pages:OutboxPage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
