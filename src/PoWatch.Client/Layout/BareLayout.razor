@inherits LayoutComponentBase
@inject NavigationManager Nav

@* Sign-in and /diag: the Po shell header (title, email or Sign in, gear) without the app's controls,
   then the page. *@
<CascadingAuthenticationState>
    <PoHeader Bare="true" />
    <main tabindex="-1">
        <ErrorBoundary @key="new Uri(Nav.Uri).AbsolutePath">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <div class="po-error-panel" role="alert">
                    <h2>Something went wrong</h2>
                    <p>This page hit an unexpected error. Reload the page to try again.</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
        @* Fixed in the corner on wide screens, after the page's content on phones. *@
        <BuildVersion />
    </main>
</CascadingAuthenticationState>
