@implements IAsyncDisposable
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject IJSRuntime JS

@* The models at work, in one strip on Live above the panels: what turns the camera into words, what
   turns the microphone into words, and what writes the stories and answers Ask. Each is a dropdown, and
   its status says what is really running (Ollama on this PC, or the browser's own model standing in). *@
<div class="ai-models" data-test="ai-models" role="group" aria-label="AI models">
    <span class="ai-models-title" aria-hidden="true">MODELS</span>
    <div class="ai-model">
        <label for="ai-caption-model" title="Describes what the camera sees. Captions off saves the GPU.">SEES</label>
        <select id="ai-caption-model" @key="_captionRevision" value="@(Sensing.Captions ? Sensing.CaptionModel : "off")"
                @onchange="SelectCaptionAsync" data-test="ai-caption-model" aria-describedby="ai-caption-status">
            <option value="off">Captions off</option>
            @foreach (var model in CaptionModels.All)
            {
                <option value="@model.Key">@model.Label</option>
            }
        </select>
        <a id="ai-caption-status" class="ai-model-status @(CaptionWarn ? "ai-model-status--warn" : null)" href="system" title="@CaptionHint" data-test="ai-caption-status"><span role="status">@CaptionStatus</span></a>
        @* Ollama answered but lacks this model: hand over the exact command instead of making you guess. *@
        @if (PullCommand is { } pull)
        {
            <button type="button" class="ai-model-pull" @onclick="CopyPullAsync" data-test="ai-pull"
                    title="@(pull) — press to copy">@(_copied ? "COPIED" : "PULL")</button>
        }
    </div>
    <div class="ai-model">
        <label for="ai-hearing" title="Words (Whisper), sounds (AST) and voices (WavLM), all heard on this machine; never the audio itself.">HEARS</label>
        <select id="ai-hearing" value="@(Sensing.Listening ? "on" : "off")" @onchange="SelectHearingAsync" data-test="ai-hearing">
            <option value="on">WHISPER · AST · WAVLM</option>
            <option value="off">Listening off</option>
        </select>
        <span class="ai-model-status">@(Sensing.Listening ? "THIS BROWSER" : "OFF")</span>
    </div>
    <div class="ai-model">
        <label for="ai-chat-model" title="Writes recaps and stories, answers questions. Auto picks local Ollama when it answers, else a cloud model; a failing model hands over to the next configured one.">WRITES</label>
        <select id="ai-chat-model" @key="_chatRevision" value="@_models?.SelectedId" @onchange="SelectChatAsync"
                disabled="@(_models is null || _saving)" data-test="ai-chat-model" aria-describedby="ai-chat-status">
            @if (_models is null)
            {
                <option>@(_loadFailed ? "Unavailable" : "Loading models...")</option>
            }
            else
            {
                @foreach (var model in _models.Models)
                {
                    <option value="@model.Id">@model.Provider - @model.Model</option>
                }
            }
        </select>
        <span id="ai-chat-status" class="ai-model-status" role="status">
            @(_saving ? "SAVING..." : _models?.SelectedId switch { "Template" => "TEMPLATE", "Ollama" => "SERVER · OLLAMA", "Auto" => "SERVER · AUTO", null => "SERVER", _ => "SERVER · CLOUD" })
        </span>
    </div>
    @if (_error is not null)
    {
        <span class="ai-models-error" role="alert">@_error</span>
    }
    @if (_loadFailed)
    {
        <button class="term-button" @onclick="LoadModelsAsync">Retry AI</button>
    }
</div>

@code {
    private AiModelsDto? _models;
    private InferenceStatusPayload? _inference;
    private bool _saving;
    private bool _loadFailed;
    private int _captionRevision;
    private int _chatRevision;
    private bool _copied;
    private string? _error;
    private readonly CancellationTokenSource _stop = new();
    private Task _poll = Task.CompletedTask;

    private string CaptionStatus => !Sensing.Captions ? "OFF"
        : !Sensing.IsRunning ? "STARTS WITH THE CAMERA"
        : Sensing.Live.Demo ? "DEMO · AI IDLE"
        : _inference is null ? "WAITING FOR WORKER"
        : _inference.Device == "ollama" ? (_inference.ModelKey == Sensing.CaptionModel ? "LOCAL GPU · OLLAMA" : "SWITCH PENDING")
        // Any other backend is the in-browser model standing in: no Ollama answered, or it lacks the model.
        : _inference.LoadState switch
        {
            "ready" => $"{Fallback} · {BrowserModel} ON {(_inference.Device == "webgpu" ? "WEBGPU" : "CPU")}",
            "loading" => $"{Fallback} · LOADING {BrowserModel}...",
            "error" => "MODEL FAILED",
            _ => "WAITING FOR CAPTION"
        };

    /// <summary>Why the browser's model runs: Ollama is not there, or it has not pulled the chosen model.</summary>
    private string Fallback => _inference?.OllamaMissing is { Length: > 0 } ? "NOT IN OLLAMA" : "NO OLLAMA";

    private string BrowserModel => _inference?.ModelId?.Split('/')[^1].Replace("-base-ft", "", StringComparison.OrdinalIgnoreCase).ToUpperInvariant() ?? "BROWSER MODEL";

    /// <summary>The exact command that makes Ollama able to run the chosen caption model, when it cannot.</summary>
    private string? PullCommand => _inference?.OllamaMissing is { Length: > 0 } missing ? $"ollama pull {missing}" : null;

    /// <summary>Copies the pull command. There is nothing to install from here, so the clipboard is the handover.</summary>
    private async Task CopyPullAsync()
    {
        if (PullCommand is not { } command) return;
        await JS.TryInvokeVoidAsync("navigator.clipboard.writeText", command);
        _copied = true;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(2));
        _copied = false;
        StateHasChanged();
    }

    /// <summary>The chosen model is not what runs: worth a second look.</summary>
    private bool CaptionWarn => Sensing.Captions && Sensing.IsRunning && !Sensing.Live.Demo
        && _inference is { } i && (i.LoadState == "error" || (i.Device != "ollama" && i.LoadState == "ready"));

    private string CaptionHint => _inference?.LoadError is { Length: > 0 } error ? error
        : _inference?.OllamaMissing is { Length: > 0 } missing ? $"Ollama answered but has no {missing}, so the browser's own model captions instead. Run: ollama pull {missing}"
        : "Camera captions stay on this device: Ollama runs the model on this PC, or the browser does when Ollama is off. A switch applies after the current caption finishes. Open System for details.";

    protected override async Task OnInitializedAsync()
    {
        Sensing.Changed += OnChanged;
        await LoadModelsAsync();
        _poll = PollAsync(_stop.Token);
    }

    private async Task LoadModelsAsync()
    {
        _models = await Api.GetAiModelsAsync(_stop.Token);
        _loadFailed = _models is null;
        _error = _loadFailed ? "Could not load server AI models." : null;
    }

    private async Task SelectCaptionAsync(ChangeEventArgs args)
    {
        var model = args.Value?.ToString();
        if (model is null || (model != "off" && !CaptionModels.All.Any(m => m.Key == model)))
        {
            _error = "Choose one of the offered camera models.";
            return;
        }
        try
        {
            if (model != "off")
                await JS.InvokeVoidAsync("localStorage.setItem", CaptionModels.Key, model);
            await JS.InvokeVoidAsync("localStorage.setItem", MainLayout.CaptionsKey, model == "off" ? "off" : "on");
            if (model != "off") Sensing.CaptionModel = model;
            Sensing.Captions = model != "off";
            _error = null;
        }
        catch (JSException)
        {
            _captionRevision++;
            _error = "Could not save the camera AI choice in this browser.";
        }
    }

    private async Task SelectHearingAsync(ChangeEventArgs args)
    {
        var on = args.Value?.ToString() != "off";
        Sensing.Listening = on;
        await JS.TryInvokeVoidAsync("localStorage.setItem", MainLayout.ListeningKey, on ? "on" : "off");
    }

    private async Task SelectChatAsync(ChangeEventArgs args)
    {
        if (_saving || args.Value?.ToString() is not { } id) return;
        _saving = true;
        var saved = await Api.SelectAiModelAsync(id, _stop.Token);
        if (saved is not null) _models = saved;
        if (saved is null) _chatRevision++;
        _error = saved is null ? "Could not switch server AI. Your previous model is still selected." : null;
        _saving = false;
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            do
            {
                if (Sensing.IsRunning && !Sensing.Live.Demo && Sensing.Captions)
                {
                    _inference = await JS.TryInvokeAsync<InferenceStatusPayload>("powatchInference.getInferenceDiagnostics");
                    await InvokeAsync(StateHasChanged);
                }
            } while (await timer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Sensing.Changed -= OnChanged;
        await _stop.CancelAsync();
        await _poll;
        _stop.Dispose();
    }
}
