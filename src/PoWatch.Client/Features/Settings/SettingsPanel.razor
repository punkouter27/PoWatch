@* Every optional choice in four tabs: what is recorded (listening, sound cues, the weather beside each day),
   who is known, what reaches you or others (watch rules, the weekly email, shared links), and Advanced,
   where the niche and the dangerous live (this browser's reset, data kept, export, System,
   sign out, delete everything). The theme is the header's own button; the AI models are a strip on Live. One column: it opens in the gear's
   drawer, and as the /settings page (?section= opens a tab; older section names open where their panels
   went). Each panel loads what it shows when it opens. *@
<div class="settings-stack" data-test="settings-page">
    <nav class="term-tabbar settings-tabs" aria-label="Settings sections">
        @foreach (var (key, label) in Sections)
        {
            <button type="button" class="term-tab @(_section == key ? "term-tab--on" : null)" aria-pressed="@(_section == key ? "true" : "false")"
                    @onclick="() => _section = key" data-test="@($"settings-tab-{key}")">@label</button>
        }
    </nav>

    @* A panel that throws shows a retry box in place of itself; the tab bar and the rest of Settings
       keep working. Keyed on the tab, so moving to another tab clears the failed one. *@
    <ErrorBoundary @ref="_boundary" @key="_section">
        <ChildContent>
            @switch (_section)
            {
                case "recording":
                    <RecordingSettings />
                    <WeatherSettings />
                    break;
                case "people":
                    <KnownRegulars />
                    break;
                case "alerts":
                    <AlertSettings />
                    <SharingSettings />
                    break;
                default:
                    <LookSettings />
                    <AccountSettings />
                    break;
            }
        </ChildContent>
        <ErrorContent>
            <div class="panel-error" role="alert" data-test="settings-error">
                <span>This settings panel hit an error.</span>
                <button type="button" class="term-button" @onclick="() => _boundary?.Recover()">Retry</button>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</div>

@code {
    private static readonly (string Key, string Label)[] Sections =
    [
        ("recording", "Recording"), ("people", "People"), ("alerts", "Alerts"), ("advanced", "Advanced"),
    ];

    /// <summary>Section names from older links, and the tab their panels sit on now.</summary>
    private static readonly Dictionary<string, string> Moved = new(StringComparer.OrdinalIgnoreCase)
    {
        ["sharing"] = "alerts", ["account"] = "advanced", ["look"] = "advanced",
    };

    /// <summary>The tab to open on: recording, people, alerts or advanced.</summary>
    [Parameter] public string? Section { get; set; }

    private string _section = "recording";
    private string? _applied;
    private ErrorBoundary? _boundary;

    // Only a new Section moves the tab: the drawer re-renders with the same one while you click around.
    protected override void OnParametersSet()
    {
        if (Section == _applied) return;
        _applied = Section;
        if (Section is { } section && Sections.Any(t => t.Key == section)) _section = section;
        else if (Section is { } old && Moved.TryGetValue(old, out var moved)) _section = moved;
    }
}
