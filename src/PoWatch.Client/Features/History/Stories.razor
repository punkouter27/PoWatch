@page "/history"
@using System.Globalization
@inject PoWatchApiClient Api
@inject NavigationManager Navigation

<PageTitle>PoWatch | History</PageTitle>

@* History tells what happened. Sessions: every session, newest first, with the story of the whole
   session and, under it, its ten-minute chapters, newest first; each card asks for its story, which
   writes whatever is still due (a session closed without Stop gets its story here). Week and Month:
   one story of the whole period. The tab is in the address (?view=week). The day view is one click away. *@
<div class="history-page">
    <div class="history-bar">
        <HistorySwitch Stories="true" />
        <span class="history-switch" role="group" aria-label="Stories of" data-test="story-views">
            @foreach (var (view, label) in Views)
            {
                <button type="button" class="term-button @(View == view ? "term-button--on" : null)" aria-pressed="@(View == view ? "true" : "false")"
                        @onclick="() => Show(view)" data-test="@($"story-view-{view}")">@label</button>
            }
        </span>
    </div>
    @if (View is "week" or "month")
    {
        <div class="story-feed">
            <PeriodStory Kind="@View" Day="@PeriodDay" />
        </div>
    }
    else
    {
    <div class="story-feed" data-test="story-feed">
        @if (_sessions is null)
        {
            <Skeleton Heights="@([180, 180])" />
        }
        else if (_sessions.Count == 0)
        {
            <p class="term-empty" data-test="story-feed-empty">No sessions yet, so no stories. <TryDemo /></p>
        }
        else
        {
            @foreach (var session in _sessions)
            {
                <TerminalPanel Title="@Heading(session)" Class="story-card" Test="story-card">
                    <Aside>
                        @SessionDto.Tag(session.Id) · @(session.IsRunning ? "RUNNING" : DisplayText.Duration(session.DurationSeconds))
                        <a class="term-link" href="@DayLink(session)" title="This day's numbers, recap and replay">day →</a>
                    </Aside>
                    <ChildContent>
                        <SessionStory SessionId="@session.Id" NewestFirst="true" ChaptersOpen="true" />
                        <SessionTranscript SessionId="@session.Id" />
                    </ChildContent>
                </TerminalPanel>
            }
            @if (_sessions.Count >= _take && _take < MaxTake)
            {
                <button type="button" class="term-button story-more" @onclick="OlderAsync" data-test="story-more">Older sessions</button>
            }
        }
    </div>
    }
</div>

@code {
    private static readonly (string View, string Label)[] Views = [("sessions", "Sessions"), ("week", "Week"), ("month", "Month")];

    [SupplyParameterFromQuery(Name = "view")] public string? ViewParameter { get; set; }

    /// <summary>A day in the week or month shown (?date=yyyy-MM-dd); text, so a bad link cannot break the page.</summary>
    [SupplyParameterFromQuery(Name = "date")] public string? DateParameter { get; set; }

    private DateOnly? PeriodDay =>
        DateOnly.TryParseExact(DateParameter, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) ? day : null;

    private string View => ViewParameter is "week" or "month" ? ViewParameter : "sessions";

    private void Show(string view) => Navigation.NavigateTo(view == "sessions" ? "history" : $"history?view={view}");

    private const int Page = 10;

    /// <summary>The server lists at most this many of the latest sessions.</summary>
    private const int MaxTake = 100;

    private int _take = Page;
    private IReadOnlyList<SessionDto>? _sessions;

    protected override async Task OnInitializedAsync() => _sessions = await Api.ListSessionsAsync(_take);

    private async Task OlderAsync()
    {
        _take = Math.Min(MaxTake, _take + Page);
        _sessions = await Api.ListSessionsAsync(_take);
    }

    private static string Heading(SessionDto session)
    {
        var start = session.StartedUtc.ToLocalTime();
        var end = (session.EndedUtc ?? DateTimeOffset.Now).ToLocalTime();
        return $"{start.ToString("ddd d MMM · HH:mm", CultureInfo.CurrentCulture)}–{end.ToString("HH:mm", CultureInfo.CurrentCulture)}";
    }

    private static string DayLink(SessionDto session) =>
        $"history/{session.StartedUtc.ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";
}
