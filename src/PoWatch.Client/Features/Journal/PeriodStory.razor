@inject PoWatchApiClient Api

@* The story of a whole week or month (PeriodStoryService), with the days it was told from under it,
   newest first. ◀ ▶ step back and forth a week or a month at a time. *@
<TerminalPanel Title="@Heading" Class="reader story-card" Test="period-story">
    <ChildContent>
        @if (_loading)
        {
            <p class="term-empty">Writing the @Kind's story…</p>
        }
        else if (_story is null)
        {
            <p class="term-empty">The @Kind's story could not be loaded.</p>
        }
        else
        {
            <div class="session-story">
                @foreach (var paragraph in _story.Story.Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <p class="session-story-text" data-test="period-story-text">@paragraph</p>
                }
                @if (_story.Days.Count > 0)
                {
                    <details class="session-story-chapters" open>
                        <summary>@_story.Days.Count DAYS · NEWEST FIRST</summary>
                        <ol>
                            @foreach (var day in _story.Days)
                            {
                                <li><a class="num" href="@StoryLinks.Day(day.Date)" title="Open this day">@day.Date.ToString("ddd d MMM", CultureInfo.CurrentCulture)</a> @day.Text</li>
                            }
                        </ol>
                    </details>
                }
            </div>
        }
    </ChildContent>
</TerminalPanel>

@code {
    /// <summary>"week" or "month".</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "week";

    /// <summary>Any day in the period (?date=); today when null.</summary>
    [Parameter] public DateOnly? Day { get; set; }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private (string, DateOnly)? _shown;
    private bool _loading = true;
    private PeriodStoryDto? _story;

    private bool Month => Kind == "month";

    private string Heading => _story is null
        ? (Month ? "The month" : "The week")
        : Month
            ? _story.From.ToString("MMMM yyyy", CultureInfo.CurrentCulture)
            : $"Week of {_story.From.ToString("ddd d MMM", CultureInfo.CurrentCulture)} – {_story.To.ToString("ddd d MMM", CultureInfo.CurrentCulture)}";

    protected override async Task OnParametersSetAsync()
    {
        var day = Day is { } d && d <= Today ? d : Today;
        if ((Kind, day) == _shown) return;
        _shown = (Kind, day);
        await LoadAsync(day);
    }

    private async Task LoadAsync(DateOnly day)
    {
        (_loading, _story) = (true, null);
        var kind = Kind;
        var story = await Api.GetPeriodStoryAsync(Month, day, TimeZoneInfo.Local.Id);
        if ((kind, day) != _shown) return;
        (_story, _loading) = (story, false);
    }
}
