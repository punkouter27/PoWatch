@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SensingSession Sensing
@inject DrawerState Drawers
@inject UiPrefs Prefs

<a href="#main-content" class="skip-link">Skip to main content</a>

<div class="term-shell">
    <TerminalHeader ShowStart="@(!_live)" />

    @* App.razor moves focus here after every navigation, so keyboard and screen-reader users land in the page. *@
    <main class="term-body" id="main-content" tabindex="-1">
        <AwayCard />
        @* Keyed on the section, not the full URI: a query change (?range=, ?start=) or a deeper
           segment (/history/2026-10-03) must not rebuild the page. *@
        <ErrorBoundary @key="Section(Nav.Uri)">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                @* Without a boundary a single component exception tears down the whole render tree
                   and leaves a blank page with no way back. *@
                <div class="po-error-panel term-panel" role="alert">
                    <h2>Something went wrong</h2>
                    <p>This page hit an unexpected error. Reload the page to try again.</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@* The camera feed lives here, not on the Live page, so it keeps playing (and the session keeps
   sampling) on every page; Live docks it over its camera panel. *@
<video @ref="_feed" class="term-feed" autoplay muted playsinline aria-label="Live camera feed"></video>
<FxBridge />
<FirstRunTour />
<BuildStamp />
@* Host for chart hover tooltips; without it RadzenChart never shows one. *@
<RadzenChartTooltip />
@* Host for DialogService confirmations (deleting data, keeping less of it). *@
<RadzenDialog />

@code {
    private bool _live = true;
    private ElementReference _feed;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _live = IsLive(Nav.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Sensing.Feed = _feed;
        await JS.TryInvokeVoidAsync("powatchMenus.setup");
        await Prefs.LoadAsync(JS);
        // Remembered per browser: whether camera sessions also run the caption model.
        if (await JS.TryInvokeAsync<string>("localStorage.getItem", CaptionsKey) == "off") Sensing.Captions = false;
        Sensing.CaptionModel = CaptionModels.Normalize(await JS.TryInvokeAsync<string>("localStorage.getItem", CaptionModels.Key));
        await Sensing.SendOutboxAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _live = IsLive(e.Location);
        // A drawer belongs to the page it was opened over.
        Drawers.Close();
        InvokeAsync(StateHasChanged);
    }

    public const string CaptionsKey = "powatch:captions";

    private static bool IsLive(string uri) => Section(uri).Length == 0;

    /// <summary>The first path segment: "" for Live, "history", "regulars", …</summary>
    private static string Section(string uri) => new Uri(uri).AbsolutePath.Trim('/').Split('/')[0];

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
