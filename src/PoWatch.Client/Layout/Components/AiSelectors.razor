@implements IAsyncDisposable
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject IJSRuntime JS

@* The models at work, consolidated into one dropdown in the top nav bar: what finds things in frame,
   what turns the camera into words, what turns the microphone into words, and what writes the stories.
   Each status says what is really running (Ollama on this PC, or the browser's own model standing in),
   and a browser model shows its load as it happens (ModelLoad): download, first run, then WebGPU or CPU. *@
<details class="export-menu ai-nav-menu" data-test="ai-config">
    <summary class="term-button ai-config-summary @(_error is not null || _loadFailed || CaptionWarn ? "ai-config-summary--warn" : null)"
             data-test="ai-config-toggle"
             title="@($"AI & listening · Captions {(Sensing.Captions ? "on" : "off")} · Listening {(Sensing.Listening ? "on" : "off")}")">
        <span class="ai-nav-dot @(Sensing.Captions || Sensing.Listening ? "ai-nav-dot--on" : null)" aria-hidden="true"></span>
        <span>AI</span>
        @foreach (var pending in _loads.Where(s => s.Phase is "downloading" or "warming" or "lost" or "failed"))
        {
            <ModelLoad Status="@pending" Prefix="@(pending.Name switch { "detector" => "Camera", "faces" => "Faces", _ => "Listening" })" />
        }
        <span aria-hidden="true">▾</span>
    </summary>
    <div class="export-menu-items ai-nav-popover">
        <div class="ai-nav-head">
            <span>AI &amp; listening</span>
            <span class="term-stat-hint">Captions @(Sensing.Captions ? "on" : "off") · Listening @(Sensing.Listening ? "on" : "off")</span>
        </div>
        <div class="ai-models" data-test="ai-models" role="group" aria-label="AI models">
            <span class="ai-models-title" aria-hidden="true">MODELS</span>
            <div class="ai-model">
                <span class="ai-model-label" title="Finds people, pets and things in each frame, about once a second, on this machine.">DETECTS</span>
                @if (Sensing.IsRunning && !Sensing.Live.Demo)
                {
                    <ModelLoad Status="@Load("detector")" Prefix="@DetectorName" Test="ai-detector-status" />
                }
                else
                {
                    <span class="ai-model-status" data-test="ai-detector-status">@(Sensing.Live.Demo && Sensing.IsRunning ? "DEMO · AI IDLE" : "STARTS WITH THE CAMERA")</span>
                }
            </div>
            <div class="ai-model">
                <label for="ai-caption-model" title="Describes what the camera sees. Captions off saves the GPU.">SEES</label>
                <CaptionModelSelect Id="ai-caption-model" Test="ai-caption-model" DescribedBy="ai-caption-status" OnError="e => _error = e" />
                <a id="ai-caption-status" class="ai-model-status @(CaptionWarn ? "ai-model-status--warn" : null)" href="diag" title="@CaptionHint" data-test="ai-caption-status">
                    @if (BrowserCaptionLoad is { } load)
                    {
                        <ModelLoad Status="@load" Prefix="@($"{Fallback} · {BrowserModel}")" Test="ai-caption-load" />
                    }
                    else
                    {
                        <span role="status">@CaptionStatus</span>
                    }
                </a>
                @* Ollama answered but lacks this model: hand over the exact command instead of making you guess. *@
                @if (PullCommand is { } pull)
                {
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain ai-model-pull" Click="CopyPullAsync" data-test="ai-pull"
                            title="@($"{pull} — press to copy")">@(_copied ? "COPIED" : "PULL")</RadzenButton>
                }
            </div>
            <div class="ai-model">
                <label for="ai-hearing" title="Words (Whisper), sounds (AST) and voices (WavLM), all heard on this machine; never the audio itself.">HEARS</label>
                <RadzenDropDown TValue="string" Data="@HearingKeys" Value="@(Sensing.Listening ? "on" : "off")" Change="@(v => SelectHearingAsync(v as string))"
                                Name="ai-hearing" data-test="ai-hearing" data-value="@(Sensing.Listening ? "on" : "off")"
                                InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "What the microphone listens with" })">
                    <Template Context="key">@PickOption.Render((object)key, k => k == "on" ? "WHISPER · AST · WAVLM" : "Listening off")</Template>
                    <ValueTemplate Context="key">@PickOption.Text((object)key, k => k == "on" ? "WHISPER · AST · WAVLM" : "Listening off")</ValueTemplate>
                </RadzenDropDown>
                @if (Sensing.Listening && Sensing.IsRunning && !Sensing.Live.Demo && Load("hearing") is { } hearing)
                {
                    <ModelLoad Status="@hearing" Prefix="@(hearing.Model == "voice" ? "VOICES" : "WORDS · SOUNDS")" CpuByDesign="true" Test="ai-hearing-status" />
                }
                else
                {
                    <span class="ai-model-status" data-test="ai-hearing-status">@(Sensing.Listening ? "THIS BROWSER" : "OFF")</span>
                }
            </div>
            <div class="ai-model">
                <label for="ai-chat-model" title="Writes recaps and stories, answers questions. Auto picks local Ollama when it answers, else a cloud model; a failing model hands over to the next configured one.">WRITES</label>
                <RadzenDropDown TValue="string" @key="_chatRevision" Data="@ChatKeys" Value="@_models?.SelectedId" Change="@(v => SelectChatAsync(v as string))"
                                Disabled="@(_models is null || _saving)" Placeholder="@(_loadFailed ? "Unavailable" : "Loading models...")"
                                Name="ai-chat-model" data-test="ai-chat-model" data-value="@_models?.SelectedId"
                                InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Server AI model", ["aria-describedby"] = "ai-chat-status" })">
                    <Template Context="id">@PickOption.Render((object)id, ChatLabel)</Template>
                    <ValueTemplate Context="id">@PickOption.Text((object)id, ChatLabel)</ValueTemplate>
                </RadzenDropDown>
                <span id="ai-chat-status" class="ai-model-status" role="status">
                    @(_saving ? "SAVING..." : _models?.SelectedId switch { "Template" => "TEMPLATE", "Ollama" => "SERVER · OLLAMA", "Auto" => "SERVER · AUTO", null => "SERVER", _ => "SERVER · CLOUD" })
                </span>
            </div>
        </div>
        @if (_error is not null || _loadFailed || CaptionWarn)
        {
            <div class="ai-models-error" role="alert">
                @(_error ?? (_loadFailed ? "Could not load the AI choices." : CaptionHint))
                @if (_loadFailed)
                {
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Click="LoadModelsAsync">Retry AI</RadzenButton>
                }
            </div>
        }
    </div>
</details>
@* A GPU model that ended up on the CPU says so once per page, with why: otherwise it only looks slow. *@
@if (_cpuNotice is not null)
{
    <div class="term-toast term-toast--info" role="status" data-test="model-cpu-notice">@_cpuNotice</div>
}

@code {
    private AiModelsDto? _models;
    private InferenceStatusPayload? _inference;
    private List<ModelLoadPayload> _loads = [];
    private string? _cpuNotice;
    private DateTimeOffset _cpuNoticeUntil;
    private static readonly HashSet<string> s_cpuNoticed = [];
    private static readonly TimeSpan CpuNoticeFor = TimeSpan.FromSeconds(10);
    private bool _saving;
    private bool _loadFailed;
    private int _chatRevision;
    private bool _copied;
    private string? _error;
    private readonly CancellationTokenSource _stop = new();
    private Task _poll = Task.CompletedTask;

    private string CaptionStatus => !Sensing.Captions ? "OFF"
        : !Sensing.IsRunning ? "STARTS WITH THE CAMERA"
        : Sensing.Live.Demo ? "DEMO · AI IDLE"
        : _inference is null ? "WAITING FOR WORKER"
        : _inference.Device == "ollama" ? (_inference.ModelKey == Sensing.CaptionModel ? "LOCAL GPU · OLLAMA" : "SWITCH PENDING")
        // Any other backend is the in-browser model standing in: no Ollama answered, or it lacks the model.
        : _inference.LoadState switch
        {
            "ready" => $"{Fallback} · {BrowserModel} ON {(_inference.Device == "webgpu" ? "WEBGPU" : "CPU")}",
            "loading" => $"{Fallback} · LOADING {BrowserModel}...",
            "error" => "MODEL FAILED",
            _ => "WAITING FOR CAPTION"
        };

    private ModelLoadPayload? Load(string name) => _loads.Find(l => l.Name == name);

    private string DetectorName => Load("detector")?.Model switch
    {
        { } m when m.Contains("rfdetr", StringComparison.OrdinalIgnoreCase) => "RF-DETR NANO",
        { } m when m.Contains("rtdetr", StringComparison.OrdinalIgnoreCase) => "RT-DETR V2",
        _ => "DETECTOR",
    };

    /// <summary>The in-browser caption model's load, when it is the one captioning (no Ollama answered).</summary>
    private ModelLoadPayload? BrowserCaptionLoad => Sensing.Captions && Sensing.IsRunning && !Sensing.Live.Demo
        && _inference is { } i && i.Device != "ollama" && i.LoadState != "idle"
        ? Load("caption")
        : null;

    /// <summary>
    /// Raises the CPU notice for the first GPU model this page sees land on the CPU. Static, so leaving
    /// Live and coming back does not repeat it; a reload does.
    /// </summary>
    private bool NoticeCpuFallback()
    {
        var now = DateTimeOffset.UtcNow;
        var changed = false;
        if (_cpuNotice is not null && now >= _cpuNoticeUntil)
        {
            _cpuNotice = null;
            changed = true;
        }
        foreach (var load in _loads)
        {
            if (load is not { Phase: "ready", Device: "wasm", Reason: { Length: > 0 } reason } || !s_cpuNoticed.Add(load.Name)) continue;
            var what = load.Name == "detector" ? "The object detector" : "The caption model";
            _cpuNotice = $"{what} is running on the CPU, not the GPU, because {reason}. It still works, just several times slower.";
            _cpuNoticeUntil = now + CpuNoticeFor;
            changed = true;
        }
        return changed;
    }

    /// <summary>Why the browser's model runs: Ollama is not there, or it has not pulled the chosen model.</summary>
    /// <summary>Why the browser captions: you picked a browser model, or it stands in for an Ollama one.</summary>
    private string Fallback => _inference?.ModelKey is { } key && key == Sensing.CaptionModel ? "THIS BROWSER"
        : _inference?.OllamaMissing is { Length: > 0 } ? "NOT IN OLLAMA" : "NO OLLAMA";

    private string BrowserModel => _inference?.ModelId?.Split('/')[^1].Replace("-base-ft", "", StringComparison.OrdinalIgnoreCase).ToUpperInvariant() ?? "BROWSER MODEL";

    /// <summary>The exact command that makes Ollama able to run the chosen caption model, when it cannot.</summary>
    private string? PullCommand => _inference?.OllamaMissing is { Length: > 0 } missing ? $"ollama pull {missing}" : null;

    /// <summary>Copies the pull command. There is nothing to install from here, so the clipboard is the handover.</summary>
    private async Task CopyPullAsync()
    {
        if (PullCommand is not { } command) return;
        await JS.TryInvokeVoidAsync("navigator.clipboard.writeText", command);
        _copied = true;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(2));
        _copied = false;
        StateHasChanged();
    }

    /// <summary>The caption model failed to load. Ollama is optional: the browser's model standing in for it
    /// is normal, and the status beside the picker already names it.</summary>
    private bool CaptionWarn => Sensing.Captions && Sensing.IsRunning && !Sensing.Live.Demo
        && _inference is { LoadState: "error" };

    private string CaptionHint => _inference?.LoadError is { Length: > 0 } error ? error
        : _inference?.OllamaMissing is { Length: > 0 } missing ? $"Ollama answered but has no {missing}, so the browser's own model captions instead. Run: ollama pull {missing}"
        : "Camera captions stay on this device: Ollama runs the model on this PC, or the browser does when Ollama is off. A switch applies after the current caption finishes. Open System for details.";

    protected override async Task OnInitializedAsync()
    {
        Sensing.Changed += OnChanged;
        await LoadModelsAsync();
        _poll = PollAsync(_stop.Token);
    }

    private async Task LoadModelsAsync()
    {
        _models = await Api.GetAiModelsAsync(_stop.Token);
        _loadFailed = _models is null;
        _error = _loadFailed ? "Could not load server AI models." : null;
    }


    private static readonly string[] HearingKeys = ["on", "off"];

    private string[] ChatKeys => _models is null ? [] : [.. _models.Models.Select(m => m.Id)];

    private string ChatLabel(string id) => _models?.Models.FirstOrDefault(m => m.Id == id) is { } model ? $"{model.Provider} - {model.Model}" : id;

    private async Task SelectHearingAsync(string? value)
    {
        await Sensing.SetListeningAsync(value != "off");
    }

    private async Task SelectChatAsync(string? id)
    {
        if (_saving || id is null) return;
        _saving = true;
        var saved = await Api.SelectAiModelAsync(id, _stop.Token);
        if (saved is not null) _models = saved;
        if (saved is null) _chatRevision++;
        _error = saved is null ? "Could not switch server AI. Your previous model is still selected." : null;
        _saving = false;
    }

    private async Task PollAsync(CancellationToken ct)
    {
        // Every second, so a download's bar moves; the caption worker is asked every third tick, as before.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var tick = 0;
        try
        {
            do
            {
                if (!Sensing.IsRunning || Sensing.Live.Demo)
                {
                    // Stopped: a notice about the session's models goes with it.
                    if (_cpuNotice is not null)
                    {
                        _cpuNotice = null;
                        await InvokeAsync(StateHasChanged);
                    }
                    continue;
                }
                var changed = false;
                if (await JS.TryInvokeAsync<List<ModelLoadPayload>>("powatchModels.snapshot") is { } loads && !loads.SequenceEqual(_loads))
                {
                    _loads = loads;
                    changed = true;
                }
                if (Sensing.Captions && tick++ % 3 == 0)
                {
                    _inference = await JS.TryInvokeAsync<InferenceStatusPayload>("powatchInference.getInferenceDiagnostics");
                    changed = true;
                }
                // The just-loaded glow (ModelLoad) ends on a render after its few seconds.
                var glowing = _loads.Any(l => l.Phase == "ready" && DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - l.At < 6000);
                changed |= NoticeCpuFallback();
                if (changed || glowing) await InvokeAsync(StateHasChanged);
            } while (await timer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Sensing.Changed -= OnChanged;
        await _stop.CancelAsync();
        await _poll;
        _stop.Dispose();
    }
}
