<div class="moment-filters" role="group" aria-label="@Label">
    @foreach (var (key, label, _) in TimelineEntry.Filters)
    {
        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(Value == key ? "pw-plain term-button term-button--on" : "pw-plain term-button")"
                aria-pressed="@(Value == key ? "true" : "false")" Click="() => ValueChanged.InvokeAsync(key)"
                data-test="@($"{TestPrefix}-filter-{key}")">@label</RadzenButton>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string Value { get; set; } = "all";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Show only";
    [Parameter] public string TestPrefix { get; set; } = "timeline";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
