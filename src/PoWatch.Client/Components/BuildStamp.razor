@using System.Reflection
@* The day this build was made (yyMMdd), shown on System so a bug report can say which build it came from. *@
@if (Stamp.Length > 0)
{
    <span class="build-stamp" title="Build date (yyMMdd)" data-test="build-stamp">BUILD @Stamp</span>
}

@code {
    private static readonly string Stamp = typeof(BuildStamp).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildDate")?.Value ?? string.Empty;
}
