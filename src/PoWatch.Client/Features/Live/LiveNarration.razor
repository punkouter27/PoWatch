@* Under Live's camera: what the session saw, said and heard, and who came and went, as one feed of lines,
   newest first, under a minimap of the whole session. While recording it is the browser's own narration (LiveSensingState); for a session that
   has stopped it is what the server kept of it (the replay's events). *@
@using System.Globalization
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@implements IDisposable

<div class="live-lines" data-test="live-narration">
    @{ var lines = Lines().ToList(); }
    <div class="live-lines-head">
        <span>NARRATION</span>
        <span class="term-stat-hint">@Status</span>
        <TranscriptLink Entries="@lines" Title="@TranscriptTitle" FileName="@TranscriptFile" />
    </div>
    @if (Sensing.Live.LastError is { } error && Recording)
    {
        <p class="live-error" role="status">@error</p>
    }
    @if (lines.Count == 0)
    {
        <p class="term-empty" data-test="narration-empty">@Empty</p>
    }
    else
    {
        <SessionMinimap Lines="@lines" List="@_list" Start="@(Started ?? lines[^1].AtUtc)" End="@(Recording ? DateTimeOffset.UtcNow : _endedUtc ?? lines[0].AtUtc)" Live="@Recording" OnPick="@LightAsync" />
        <ol class="moment-list" aria-live="polite" data-test="narration-lines" @ref="_list">
            @foreach (var entry in lines)
            {
                <MomentLine @key="entry" Entry="@entry" Lit="@(ReferenceEquals(entry, _lit))" />
            }
        </ol>
    }
</div>

@code {
    /// <summary>The session Live is about (Guid.Empty before the first one).</summary>
    [Parameter] public Guid SessionId { get; set; }

    private Guid _loaded;
    private DateTimeOffset? _startedUtc;
    private DateTimeOffset? _endedUtc;
    private ElementReference _list;
    private TimelineEntry? _lit;
    private List<TimelineEntry> _kept = [];
    private bool _wasRecording;
    private DateTimeOffset _lastRender;

    private LiveSensingState L => Sensing.Live;

    private DateTimeOffset? Started => Recording ? L.Session?.StartedUtc : _startedUtc;

    private string TranscriptTitle => $"PoWatch · session {(Started ?? DateTimeOffset.Now).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)}";

    private string TranscriptFile => $"powatch-session-{(Started ?? DateTimeOffset.Now).ToLocalTime().ToString("yyyy-MM-dd-HHmm", CultureInfo.InvariantCulture)}.txt";

    private bool Recording => Sensing.IsRunning && L.Session?.Id == SessionId;

    private string Status => Recording
        ? $"{(L.Demo || L.AudioStatus == "listening" ? "LISTENING" : (L.AudioStatus ?? "NOT LISTENING").ToUpperInvariant())} · {(L.LastCaptionUtc is { } seen ? $"LAST SEEN {seen.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture)}" : "WAITING FOR THE FIRST CAPTION")}"
        : SessionId == Guid.Empty ? "NOTHING YET" : "AS KEPT · NEWEST FIRST";

    private string Empty => Recording
        ? "Watching and listening. The first lines appear as soon as something is seen, said or heard."
        : SessionId == Guid.Empty
            ? "Press Start: everything the camera sees and the microphone hears is written here."
            : "Nothing was written down in this session.";

    /// <summary>Newest first: the browser's lines while recording, else what the server kept.</summary>
    private IEnumerable<TimelineEntry> Lines() => Recording ? L.Narration.Reverse() : _kept;

    protected override void OnInitialized() => Sensing.Changed += OnSensingChanged;

    /// <summary>Sensing fires several times a second; four renders a second keep up with the words.</summary>
    private void OnSensingChanged()
    {
        var recording = Recording;
        if (_wasRecording && !recording)
        {
            // Stopped: this browser heard all of it, so its lines stand until the page reloads.
            _kept = [.. L.Narration.Reverse()];
            _endedUtc = DateTimeOffset.UtcNow;
        }
        else if (recording == _wasRecording && DateTimeOffset.UtcNow - _lastRender < TimeSpan.FromMilliseconds(250))
        {
            return;
        }
        (_wasRecording, _lastRender) = (recording, DateTimeOffset.UtcNow);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>A minimap pin picked this line: light it for a moment and a half.</summary>
    private async Task LightAsync(TimelineEntry entry)
    {
        _lit = entry;
        await Task.Delay(1600);
        if (ReferenceEquals(_lit, entry)) _lit = null;
    }

    public void Dispose() => Sensing.Changed -= OnSensingChanged;

    protected override async Task OnParametersSetAsync()
    {
        _wasRecording = Recording;
        if (SessionId == _loaded || SessionId == Guid.Empty || Recording) return;
        (_loaded, _kept) = (SessionId, []);
        var id = SessionId;
        if (await Api.GetSessionAsync(id) is not { } session) return;
        (_startedUtc, _endedUtc) = (session.StartedUtc, session.EndedUtc);
        // A session's lines are its days' events inside its own start and end.
        var end = session.EndedUtc ?? DateTimeOffset.UtcNow;
        var days = new List<DateOnly>();
        for (var day = DateOnly.FromDateTime(session.StartedUtc.LocalDateTime); day <= DateOnly.FromDateTime(end.LocalDateTime); day = day.AddDays(1))
            days.Add(day);
        var replays = await Task.WhenAll(days.Select(d => Api.GetReplayAsync(d)));
        if (id != SessionId) return;
        _kept = replays.SelectMany(r => r?.Events ?? [])
            .Where(e => e.AtUtc >= session.StartedUtc && e.AtUtc <= end)
            .Select(TimelineEntry.From).OfType<TimelineEntry>()
            .OrderByDescending(e => e.AtUtc)
            .ToList();
    }
}
