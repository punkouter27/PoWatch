@inherits StatsTabBase<EnvironmentStatsDto>
@inject SensingSession Sensing

@if (HasReadings || Data?.WeirdestCaption is not null || (!Query.IsEmpty && (Loading || Data is null)))
{
<TerminalPanel Title="Room insights" Class="cell-env" Test="live-environment" Flush="true">
    <ChildContent>
        @if (HasReadings)
        {
            <div class="term-stats">
                @if (L.Light is not null)
                {
                    <StatCell Label="Light" Value="@Light" Hint="@Lights" Test="metric-light" />
                }
                @if (!string.IsNullOrEmpty(L.LastSound))
                {
                    <StatCell Label="Last sound" Value="@Sound" Hint="@SoundHint" Test="metric-sound" />
                }
            </div>
        }
        @if (Data?.WeirdestCaption is { } caption)
        {
            <p class="stats-weird" data-test="weirdest-caption" title="The caption least like the others in this session">@Local(Data.WeirdestAtUtc, "HH:mm:ss") — “@caption”</p>
        }
        else if (Loading)
        {
            <Skeleton Heights="@([60])" />
        }
        else if (!Query.IsEmpty && Data is null)
        {
            <p class="live-error" role="status">Could not load this session's insights. Check System status or try again shortly.</p>
        }
    </ChildContent>
</TerminalPanel>
}

@code {
    private LiveSensingState L => Sensing.Live;
    private bool HasReadings => Sensing.IsRunning && (L.Light is not null || !string.IsNullOrEmpty(L.LastSound));

    protected override Task<EnvironmentStatsDto?> LoadAsync(StatsQuery query) => Api.GetEnvironmentAsync(query);
    protected override bool ShouldRender() => true;

    private string Light => L.Light is { } light ? light.ToString("P0", CultureInfo.InvariantCulture) : "—";

    /// <summary>Rough daylight guess from mean brightness: enough to say whether the lights are on.</summary>
    private string Lights => L.Light switch
    {
        null => "NO READING",
        > 0.35 => "LIGHTS ON",
        > 0.12 => "DIM",
        _ => "DARK",
    };

    private string Sound => string.IsNullOrEmpty(L.LastSound) ? "—" : L.LastSound!;

    private string SoundHint => Sensing.Listening ? (L.AudioStatus ?? "listening").ToUpperInvariant() : "NOT LISTENING";
}
