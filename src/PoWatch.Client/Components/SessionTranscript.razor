@using System.Globalization
@inject PoWatchApiClient Api

@* Word for word what the microphone heard in a session (Whisper, on this machine), apart from the story
   it feeds. Nothing is shown when nothing was said. *@
@if (_lines is { Count: > 0 } lines)
{
    <details class="session-transcript" data-test="session-transcript" open="@Open">
        <summary>HEARD · @(lines.Count == 1 ? "1 LINE" : $"{lines.Count} LINES")</summary>
        <ol>
            @foreach (var line in lines)
            {
                <li><span class="num">@line.AtUtc.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture)</span> @(line.Speaker is { } who ? $"{who}: " : null)“@line.Text”</li>
            }
        </ol>
    </details>
}

@code {
    [Parameter, EditorRequired] public Guid SessionId { get; set; }

    [Parameter] public bool Open { get; set; }

    private Guid _loaded;
    private IReadOnlyList<HeardLineDto>? _lines;

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId == _loaded) return;
        (_loaded, _lines) = (SessionId, null);
        var id = SessionId;
        var lines = await Api.GetTranscriptAsync(id);
        if (id == SessionId) _lines = lines;
    }
}
