<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Do NOT set IsTrimmable on this assembly: routable @page components are discovered via
         reflection (RouteTableFactory), so member-level trimming deletes every page and the router
         404s all routes in the published app (this took prod down on 2026-07-22). Framework
         assemblies are still trimmed by the default Blazor WASM publish. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Trim-safe options/config binding (clears IL2026 on Configure/Get). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- IL2111: emitted by the framework Router source generator for NotFoundPage; not user-addressable. -->
    <NoWarn>$(NoWarn);IL2111</NoWarn>
    <!-- Offline shell: the build lists every published file with its hash for service-worker.published.js. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- The [JSImport]/[JSExport] source generators emit unsafe code (replay grids, detector boxes). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoWatch.Shared\PoWatch.Shared.csproj" />
  </ItemGroup>

</Project>
