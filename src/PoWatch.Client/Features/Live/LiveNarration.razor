@* Under Live's camera: what the session saw, said and heard, and who came and went, as one feed of lines,
   newest first, with live keyword search, collapsed consecutive repeats, icon badges, inline thumbnails,
   and an explicit paused-scroll banner. *@
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="live-lines" data-test="live-narration">
    @{
        var all = Lines().ToList();
        var filtered = all.Where(e => TimelineEntry.Passes(e, _filter) && MatchesSearch(e)).ToList();
        var collapsed = CollapseRepeats(filtered);
    }
    <div class="live-lines-head">
        <span class="term-stat-hint">@Status</span>
        <TranscriptLink Entries="@filtered" Title="@TranscriptTitle" FileName="@TranscriptFile" />
    </div>
    <FactRow Test="narration-facts" Facts="@([
        new("Per minute", PerMinute(all), "Lines written per minute over the session"),
        new("Saw", Count(all, "caption", "moment"), "Scene descriptions and notable moments"),
        new("Said", Count(all, "speech"), "Speech heard and transcribed"),
        new("Heard", Count(all, "sound"), "Sounds recognised"),
        new("Comings", Count(all, "enter", "exit"), "Arrivals and departures"),
        new("Longest quiet", QuietGap(all), "The longest wait between two lines"),
    ])" />
    <div class="narration-controls">
        <TimelineFilters @bind-Value="_filter" TestPrefix="narration" Label="Filter narration" />
        <div class="narration-search">
            <RadzenTextBox class="pw-plain narration-search-input" Value="@SearchQuery"
                           Placeholder="Search narration…" aria-label="Search narration"
                           @oninput="OnSearchInput" data-test="narration-search" />
            @if (!string.IsNullOrEmpty(SearchQuery))
            {
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain narration-search-clear"
                              Click="ClearSearchAsync" title="Clear search" aria-label="Clear search" data-test="narration-search-clear">×</RadzenButton>
            }
        </div>
    </div>
    @if (Sensing.Live.LastError is { } error && Recording)
    {
        <p class="live-error" role="status">@error</p>
    }
    @if (collapsed.Count == 0)
    {
        <p class="term-empty" data-test="narration-empty">@(all.Count > 0 ? "No matching events yet." : Empty)</p>
    }
    else
    {
        <SessionMinimap Lines="@filtered" List="@_list" Start="@(Started ?? filtered[^1].AtUtc)" End="@(Recording ? DateTimeOffset.UtcNow : _endedUtc ?? filtered[0].AtUtc)" Live="@Recording" OnPick="@LightAsync" />
        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button narration-new" data-narration-new hidden>Scroll paused · Jump to latest ↑</RadzenButton>
        <ol class="moment-list" data-test="narration-lines" @ref="_list" @key="@($"{_filter}:{SearchQuery}")">
            @foreach (var (entry, count) in collapsed)
            {
                <MomentLine @key="entry" Entry="@entry" RepeatCount="@count" Lit="@(ReferenceEquals(entry, _lit))" />
            }
        </ol>
    }
</div>

@code {
    /// <summary>The session Live is about (Guid.Empty before the first one).</summary>
    [Parameter] public Guid SessionId { get; set; }

    /// <summary>Live keyword filter (also set when clicking a word in Room insights or a regular in Regulars).</summary>
    [Parameter] public string SearchQuery { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }

    private Guid _loaded;
    private DateTimeOffset? _startedUtc;
    private DateTimeOffset? _endedUtc;
    private ElementReference _list;
    private TimelineEntry? _lit;
    private List<TimelineEntry> _kept = [];
    private bool _wasRecording;
    private DateTimeOffset _lastRender;
    private string _filter = "all";
    private ElementReference _watchedList;

    private LiveSensingState L => Sensing.Live;

    private DateTimeOffset? Started => Recording ? L.Session?.StartedUtc : _startedUtc;

    private string TranscriptTitle => $"PoWatch · session {(Started ?? DateTimeOffset.Now).ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)}";

    private string TranscriptFile => $"powatch-session-{(Started ?? DateTimeOffset.Now).ToLocalTime().ToString("yyyy-MM-dd-HHmm", CultureInfo.InvariantCulture)}.txt";

    private bool Recording => Sensing.IsRunning && L.Session?.Id == SessionId;

    private string Status => Recording
        ? $"{(L.Demo || L.AudioStatus == "listening" ? "LISTENING" : (L.AudioStatus ?? "NOT LISTENING").ToUpperInvariant())} · {(L.LastCaptionUtc is { } seen ? $"LAST SEEN {seen.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture)}" : "WAITING FOR THE FIRST CAPTION")}"
        : SessionId == Guid.Empty ? "NOTHING YET" : "AS KEPT · NEWEST FIRST";

    private string Empty => Recording
        ? "Watching and listening. The first lines appear as soon as something is seen, said or heard."
        : SessionId == Guid.Empty
            ? "Press Start: everything the camera sees and the microphone hears is written here."
            : "Nothing was written down in this session.";

    private Task OnSearchInput(ChangeEventArgs e) => SearchQueryChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private Task ClearSearchAsync() => SearchQueryChanged.InvokeAsync(string.Empty);

    private bool MatchesSearch(TimelineEntry entry)
    {
        if (string.IsNullOrWhiteSpace(SearchQuery)) return true;
        var q = SearchQuery.Trim();
        return entry.Sentence.Contains(q, StringComparison.OrdinalIgnoreCase)
            || entry.Text.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (entry.Who?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    /// <summary>Collapses consecutive identical captions within 3 minutes into one line with a ×N repeat count.</summary>
    private static List<(TimelineEntry Entry, int Count)> CollapseRepeats(List<TimelineEntry> entries)
    {
        var result = new List<(TimelineEntry Entry, int Count)>(entries.Count);
        foreach (var entry in entries)
        {
            if (result.Count > 0
                && entry.Kind == "caption"
                && result[^1].Entry.Kind == "caption"
                && string.Equals(result[^1].Entry.Text, entry.Text, StringComparison.OrdinalIgnoreCase)
                && Math.Abs((result[^1].Entry.AtUtc - entry.AtUtc).TotalMinutes) <= 3)
            {
                result[^1] = (result[^1].Entry, result[^1].Count + 1);
            }
            else
            {
                result.Add((entry, 1));
            }
        }
        return result;
    }

    private static string? Count(List<TimelineEntry> lines, params string[] kinds) =>
        lines.Count == 0 ? null : lines.Count(e => kinds.Contains(e.Kind)).ToString(CultureInfo.InvariantCulture);

    /// <summary>Lines a minute from the session's start; null before a minute has passed.</summary>
    private string? PerMinute(List<TimelineEntry> lines)
    {
        if (lines.Count == 0 || Started is not { } start) return null;
        var minutes = ((Recording ? DateTimeOffset.UtcNow : _endedUtc ?? lines[0].AtUtc) - start).TotalMinutes;
        return minutes < 1 ? null : (lines.Count / minutes).ToString("0.0", CultureInfo.InvariantCulture);
    }

    /// <summary>The widest gap between two neighbouring lines (they arrive newest first); null under two lines.</summary>
    private static string? QuietGap(List<TimelineEntry> lines) =>
        lines.Count < 2 ? null : DisplayText.Duration(lines.Zip(lines.Skip(1), (a, b) => (a.AtUtc - b.AtUtc).TotalSeconds).Max());

    /// <summary>Newest first: the browser's lines while recording, else what the server kept.</summary>
    private IEnumerable<TimelineEntry> Lines() => Recording ? L.Narration.Reverse() : _kept;

    protected override void OnInitialized() => Sensing.Changed += OnSensingChanged;

    /// <summary>Sensing fires several times a second; four renders a second keep up with the words.</summary>
    private void OnSensingChanged()
    {
        var recording = Recording;
        if (_wasRecording && !recording)
        {
            // Stopped: this browser heard all of it, so its lines stand until the page reloads.
            _kept = [.. L.Narration.Reverse()];
            _endedUtc = DateTimeOffset.UtcNow;
        }
        else if (recording == _wasRecording && DateTimeOffset.UtcNow - _lastRender < TimeSpan.FromMilliseconds(250))
        {
            return;
        }
        (_wasRecording, _lastRender) = (recording, DateTimeOffset.UtcNow);
        InvokeAsync(StateHasChanged);
    }

    /// <summary>A minimap pin picked this line: light it for a moment and a half.</summary>
    private async Task LightAsync(TimelineEntry entry)
    {
        _lit = entry;
        await Task.Delay(1600);
        if (ReferenceEquals(_lit, entry)) _lit = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_list.Equals(_watchedList)) return;
        await JS.TryInvokeVoidAsync("powatchMenus.releaseNarration", _watchedList);
        _watchedList = _list;
        await JS.TryInvokeVoidAsync("powatchMenus.watchNarration", _list);
    }

    public async ValueTask DisposeAsync()
    {
        Sensing.Changed -= OnSensingChanged;
        await JS.TryInvokeVoidAsync("powatchMenus.releaseNarration", _watchedList);
    }

    protected override async Task OnParametersSetAsync()
    {
        _wasRecording = Recording;
        if (SessionId == _loaded || SessionId == Guid.Empty || Recording) return;
        (_loaded, _kept) = (SessionId, []);
        var id = SessionId;
        if (await Api.GetSessionAsync(id) is not { } session) return;
        (_startedUtc, _endedUtc) = (session.StartedUtc, session.EndedUtc);
        // A session's lines are its days' events inside its own start and end.
        var end = session.EndedUtc ?? DateTimeOffset.UtcNow;
        var days = new List<DateOnly>();
        for (var day = DateOnly.FromDateTime(session.StartedUtc.LocalDateTime); day <= DateOnly.FromDateTime(end.LocalDateTime); day = day.AddDays(1))
            days.Add(day);
        var replays = await Task.WhenAll(days.Select(d => Api.GetReplayAsync(d)));
        if (id != SessionId) return;
        _kept = replays.SelectMany(r => r?.Events ?? [])
            .Where(e => e.AtUtc >= session.StartedUtc && e.AtUtc <= end)
            .Select(TimelineEntry.From).OfType<TimelineEntry>()
            .OrderByDescending(e => e.AtUtc)
            .ToList();
    }
}
