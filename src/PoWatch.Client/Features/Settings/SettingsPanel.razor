@* Every optional choice in three tabs: what is recorded and heard (the models, listening, sound cues),
   who is known, and everything else about your account (look, alerts, shared links, your data). Browser
   choices start on the values that suit most rooms and are remembered here; "Show power features" (Look,
   under Account) shows the extras here and across the app, and anything already switched on stays visible
   without it. One column: it opens in the gear's drawer, and as the /settings page (?section= opens a
   tab; the old alerts, sharing and look sections open Account). Each panel loads what it shows when it opens. *@
<div class="settings-stack" data-test="settings-page">
    <nav class="term-tabbar settings-tabs" aria-label="Settings sections">
        @foreach (var (key, label) in Sections)
        {
            <button type="button" class="term-tab @(_section == key ? "term-tab--on" : null)" aria-pressed="@(_section == key ? "true" : "false")"
                    @onclick="() => _section = key" data-test="@($"settings-tab-{key}")">@label</button>
        }
    </nav>

    @switch (_section)
    {
        case "recording":
            <RecordingSettings />
            break;
        case "people":
            <KnownRegulars />
            break;
        default:
            <LookSettings />
            <AlertSettings />
            <SharingSettings />
            <AccountSettings />
            break;
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Sections =
    [
        ("recording", "Recording"), ("people", "People"), ("account", "Account"),
    ];

    /// <summary>The sections that were tabs of their own and now sit under Account, for old links.</summary>
    private static readonly string[] UnderAccount = ["alerts", "sharing", "look"];

    /// <summary>The tab to open on: recording, people or account (alerts, sharing and look open account).</summary>
    [Parameter] public string? Section { get; set; }

    private string _section = "recording";

    protected override void OnParametersSet()
    {
        if (Section is { } section && Sections.Any(t => t.Key == section)) _section = section;
        else if (UnderAccount.Contains(Section)) _section = "account";
    }
}
