@using System.Security.Claims
@implements IDisposable
@inject SensingSession Sensing
@inject DrawerState Drawers
@inject NavigationManager Navigation

@* The page shell header (AGENTS.md, Page shell): the app name upper-left, the signed-in email (or
   the Sign in button) and the settings gear upper-right, on every page signed in and out. Bare (MainLayout signed out:
   sign-in, /diag, not-found) keeps just those; the full header adds the section keys, the caption model, recording
   controls, the bell and the outbox chips. Section keys become the phone's bottom tab bar. *@
<header class="term-header po-header" data-test="term-header">
    <a class="term-brand po-header__title" href="/" data-test="header-title">PoWatch</a>

    @if (!Bare)
    {
        <NavBar />
    }

    <span class="term-header-spacer" aria-hidden="true"></span>

    @if (!Bare)
    {
        @* The camera's caption model, one pick away on every page (the same dropdown as Live's AI strip). *@
        <label class="term-nav-model" title="Which model describes what the camera sees">
            <span aria-hidden="true">SEES</span>
            <CaptionModelSelect Test="nav-caption-model" />
        </label>

        @if (ShowStart)
        {
            <SessionControls />
        }

        <Tray />

        @* Unsent batches are invisible everywhere else: this is the one place that says the outbox has
           work, with a way to push it now (a chip, not a dialog — the queued ticks are not an error). *@
        @if (Sensing.Live.PendingBatches > 0)
        {
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-outbox" Click="FlushOutboxAsync" data-test="outbox-chip"
                    title="10-second batches waiting in this browser's outbox. They resend automatically; press to send now.">
                @Sensing.Live.PendingBatches queued
            </RadzenButton>
        }
        @if (Sensing.Live.LostTicks > 0)
        {
            <span class="term-outbox term-outbox--lost" data-test="outbox-lost"
                  title="Ticks dropped because the outbox was full (storage full or a very long offline stretch)">
                @Sensing.Live.LostTicks lost
            </span>
        }
    }

    @* The sign-in page shows the title only: its one action is the card's button. Signed out, the
       actions are just Sign in (settings needs a sign-in, so the gear is for signed-in users). *@
    @if (!OnSignInPage)
    {
        <div class="po-header__actions">
            <AuthorizeView>
                <Authorized Context="auth">
                    <span class="po-header__email" title="@EmailOf(auth.User)" data-test="header-email">@EmailOf(auth.User)</span>
                    @* No settings gear (owner, 2026-11-23): /settings (recording, people, alerts, sign out) opens
                       from Ctrl+K, and the bell's "watch rules" and "name everyone" links open it in the drawer. *@
                </Authorized>
                <NotAuthorized>
                    <a class="po-link-btn filled small" href="login" data-test="header-sign-in">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }

    @if (!Bare)
    {
        @* Inside the header so it hangs from its bottom edge (terminal-shell.css), like the bell's drawer. *@
        <Drawer Title="Settings" Open="@Drawers.IsOpen(DrawerState.Settings)" OnClose="Drawers.Close" Test="settings-drawer">
            <SettingsPanel Section="@Drawers.Section" />
        </Drawer>
    }
</header>

@code {
    /// <summary>False on Live, where the camera panel has its own start controls.</summary>
    [Parameter] public bool ShowStart { get; set; } = true;

    /// <summary>Signed out (MainLayout): the title and Sign in only; no section keys or session controls.</summary>
    [Parameter] public bool Bare { get; set; }

    private bool OnSignInPage => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals("/login", StringComparison.OrdinalIgnoreCase);

    /// <summary>The header shows the email, never a display name; the name is a last resort.</summary>
    internal static string EmailOf(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("preferred_username")?.Value ?? user.Identity?.Name ?? "Signed in";

    /// <summary>Send whatever is waiting instead of waiting for the next automatic pass.</summary>
    private Task FlushOutboxAsync() => Sensing.SendOutboxAsync();

    protected override void OnInitialized()
    {
        Sensing.Changed += OnSensingChanged;
        Drawers.Changed += OnChanged;
        Navigation.LocationChanged += OnNavigated;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private object? _shown;

    /// <summary>The session changes several times a second; the header only draws these (the clock redraws the uptime).</summary>
    private void OnSensingChanged()
    {
        var now = (Sensing.IsRunning, Sensing.Live.Demo, Sensing.Live.PendingBatches, Sensing.Live.LostTicks);
        if (now.Equals(_shown)) return;
        _shown = now;
        OnChanged();
    }

    private void OnNavigated(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => OnChanged();

    public void Dispose()
    {
        Sensing.Changed -= OnSensingChanged;
        Drawers.Changed -= OnChanged;
        Navigation.LocationChanged -= OnNavigated;
    }
}
