@* Room-wide pixel motion (against the usual daily mean) clearly separated from on-device body movement
   (limb energy, unified activity breakdown bar, visual left/right balance meter, and partial-body note). *@
@using PoWatch.Shared.Services
@implements IAsyncDisposable
@inject SensingSession Sensing
@inject IJSRuntime JS

<TerminalPanel Title="Activity" Class="@(ZChip.IsUnusual(Anomaly("motion")?.Z) ? "cell-activity panel-alert" : "cell-activity")" Test="live-activity" Flush="true">
    <Aside>@(ZChip.IsUnusual(Anomaly("motion")?.Z) ? "UNUSUAL · " : null)@(Sensing.IsRunning ? L.SceneActivity.ToUpperInvariant() : "NOW vs USUAL")@(Sensing.IsRunning && B.FullBodySeen ? " · FULL BODY" : null)</Aside>
    <ChildContent>
        <p class="panel-subhead">ROOM MOTION</p>
        <div class="metric-cards">
            <RadzenCard class="metric-card">
                <StatCell Label="Activity level" Value="@(Sensing.IsRunning ? L.Motion.ToString("P1", CultureInfo.InvariantCulture) : "—")"
                          Hint="@(Sensing.IsRunning ? $"Now · usual daily mean {DisplayText.Percent(Anomaly("motion")?.Mean)}" : "Available while observing")" Test="metric-motion">
                    <ZChip Z="@Anomaly("motion")?.Z" Today="@(Sensing.IsRunning ? L.Motion : null)" Mean="@Anomaly("motion")?.Mean" />
                </StatCell>
                <Sparkline Values="@(Sensing.IsRunning && L.MotionMinutes.Points.Count > 1 ? L.MotionMinutes.Points : L.MotionHistory)"
                           Baseline="@UsualMotionLine()"
                           Average="@L.MotionMinutes.Average"
                           AverageLabel="@(L.MotionMinutes.Average is { } ma ? $"1m avg {ma:P1}" : null)"
                           Label="Activity per minute with average and usual daily mean" />
            </RadzenCard>
        </div>
        <FactRow Test="activity-facts" Facts="@([
            new("Peak now", Sensing.IsRunning && L.MotionHistory.Count > 0 ? L.MotionHistory.Max().ToString("P0", CultureInfo.InvariantCulture) : null, "The most motion in the last minute"),
            new("Busiest at", Presence?.BusiestStartUtc is { } busiest ? DisplayText.LocalTime(busiest) : null, Presence is { } p ? $"The busiest stretch this session started here, at {p.BusiestMotion.ToString("P0", CultureInfo.InvariantCulture)} motion" : null),
            new("Longest still", Presence is { LongestStillSeconds: >= 1 } still ? DisplayText.Duration(still.LongestStillSeconds) : null, "The longest stretch with no motion at all"),
        ])" />
        @if (Sensing.IsRunning && !L.Demo)
        {
            <p class="panel-subhead">BODY MOVEMENT</p>
            <canvas class="pose-3d-canvas" @ref="_pose3dCanvas" aria-label="3D ergonomic pose avatar mirror"></canvas>
            <WhoList Rows="@Doing()" Label="What each body in view is doing" Test="body-activity" />
            @if (B.InView.Any(b => !b.FullBody))
            {
                <p class="term-stat-hint partial-body-hint" data-test="body-partial-hint">Legs out of frame — leg balance paused.</p>
            }
            @if (B.MeanEnergy is { } mean)
            {
                <div class="live-census" data-test="body-energy" title="How much arms and legs move, measured against the body's own size, averaged per minute while someone is in view">
                    <span class="live-heat-label">ENERGY</span>@EnergyWord(mean) · mean @mean.ToString("P0", CultureInfo.InvariantCulture)
                    <Sparkline Values="@(B.EnergyMinutes.Points.Count > 1 ? B.EnergyMinutes.Points : B.EnergyHistory)" Max="1"
                               Average="@mean"
                               AverageLabel="@($"1m avg {mean:P0}")"
                               Label="Limb energy per minute over this session" />
                </div>
            }
            <ShareBar Label="Person-time by activity this session" Test="body-activity-bar" Legend="true"
                      Parts="@([.. B.ActivitySeconds.Where(p => p.Value >= 1).OrderByDescending(p => p.Value).Select(p => new ShareBar.Part(Word(p.Key), p.Value, Note: DisplayText.Duration(p.Value)))])" />
            @if (B.ArmBalance is not null || B.LegBalance is not null || B.ShoulderTilt is not null)
            {
                <div class="balance-block" data-test="body-balance">
                    @if (B.ArmBalance is { } arms)
                    {
                        var pct = Math.Clamp((int)Math.Round(arms * 100), 0, 100);
                        <div class="balance-row" title="@($"Arms {pct}% left / {100 - pct}% right")">
                            <span class="live-heat-label">ARMS</span>
                            <span class="balance-side">L</span>
                            <div class="balance-track"><span class="balance-dot" style="left: @pct%"></span></div>
                            <span class="balance-side">R</span>
                            <span class="meter-val">@pct/@(100 - pct)</span>
                        </div>
                    }
                    @if (B.LegBalance is { } legs)
                    {
                        var pct = Math.Clamp((int)Math.Round(legs * 100), 0, 100);
                        <div class="balance-row" title="@($"Legs {pct}% left / {100 - pct}% right")">
                            <span class="live-heat-label">LEGS</span>
                            <span class="balance-side">L</span>
                            <div class="balance-track"><span class="balance-dot" style="left: @pct%"></span></div>
                            <span class="balance-side">R</span>
                            <span class="meter-val">@pct/@(100 - pct)</span>
                        </div>
                    }
                    @if (B.ShoulderTilt is { } tilt)
                    {
                        <div class="balance-row">
                            <span class="live-heat-label">SHOULDERS</span>
                            <span class="tilt-icon" style="transform: rotate(@((-tilt).ToString("0.#", CultureInfo.InvariantCulture))deg)" aria-hidden="true">━</span>
                            <span class="meter-val">@(Math.Abs(tilt) < 1.5 ? "Level" : FormattableString.Invariant($"{(tilt > 0 ? "Left" : "Right")} {Math.Abs(tilt):0}° lower"))</span>
                        </div>
                    }
                </div>
            }
        }
    </ChildContent>
</TerminalPanel>

@code {
    [Parameter] public PatternStatsDto? Patterns { get; set; }

    /// <summary>The session's presence numbers, for its busiest stretch and longest stillness.</summary>
    [Parameter] public PresenceStatsDto? Presence { get; set; }

    private LiveSensingState L => Sensing.Live;

    private BodyReadings B => Sensing.Bodies;
    private ElementReference _pose3dCanvas;
    private bool _pose3dMounted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var want = Sensing.IsRunning && !L.Demo;
        if (want != _pose3dMounted)
        {
            _pose3dMounted = want;
            if (want) await JS.TryInvokeVoidAsync("powatchPose3d.mount", _pose3dCanvas);
            else await JS.TryInvokeVoidAsync("powatchPose3d.release");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_pose3dMounted) await JS.TryInvokeVoidAsync("powatchPose3d.release");
    }

    private AnomalyDto? Anomaly(string metric) => Patterns?.Anomalies.FirstOrDefault(a => a.Metric == metric);

    private IReadOnlyList<double>? UsualMotionLine()
    {
        if (Anomaly("motion")?.Mean is not { } mean || mean <= 0 || L.MotionHistory.Count < 2) return null;
        return [mean, mean];
    }

    private List<WhoList.Row> Doing() =>
        [.. B.InView.Select(b => new WhoList.Row($"Body {b.Slot}",
            $"{Word(b.Activity)} · energy {b.Energy.ToString("P0", CultureInfo.InvariantCulture)}{(b.FullBody ? null : " · upper body")}"))];

    private static string Word(BodyActivity activity) => activity.ToString().ToLowerInvariant();

    private static string EnergyWord(double energy) => energy switch
    {
        < 0.05 => "calm",
        < 0.15 => "settled",
        < 0.35 => "fidgety",
        _ => "lively",
    };
}
