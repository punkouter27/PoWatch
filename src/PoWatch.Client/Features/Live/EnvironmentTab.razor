@inherits StatsTabBase<EnvironmentStatsDto>

@* One cell for the room itself: the light curve on top, then its colours and what the captions said. *@
<TerminalPanel Title="Environment" Class="cell-env dash-wide" Test="@(Data is null ? null : "stats-environment")">
    <Aside>@(Data is null ? null : $"{Data.Switches.Count} SWITCHES · {Data.CaptionCount} CAPTIONS")@(Data?.SunriseUtc is { } up ? $" · SUN {Local(up, "HH:mm")}–{Local(Data.SunsetUtc, "HH:mm")}" : string.Empty)</Aside>
    <ChildContent>
        @if (Data is null)
        {
            <StatsPending Loading="@Loading" Empty="No environment stats yet." />
        }
        else
        {
            <RadzenChart aria-label="Brightness over the range">
                <RadzenAreaSeries Data="@_light" CategoryProperty="@nameof(LightPoint.At)" ValueProperty="@nameof(LightPoint.Luminance)" Title="Brightness" />
                <RadzenValueAxis Min="0" Max="1" FormatString="{0:0.00}" />
                <RadzenCategoryAxis Formatter="@AxisLabel" />
                <RadzenLegend Visible="false" />
            </RadzenChart>
            @if (Data.Palette.Count > 0)
            {
                <div class="term-swatches" aria-label="The range's dominant colours">
                    @foreach (var color in Data.Palette)
                    {
                        <span style="background: #@color.Rgb.ToString("x6", System.Globalization.CultureInfo.InvariantCulture); flex: @Number(color.Share * 100, "0.#");"
                              title="#@color.Rgb.ToString("x6", System.Globalization.CultureInfo.InvariantCulture) · @Percent(color.Share)"></span>
                    }
                </div>
            }
            @if (Data.Words.Count == 0)
            {
                <p class="term-empty">Captions are read for a session or today; nothing yet.</p>
            }
            else
            {
                <div class="stats-cloud" aria-label="Most common words in captions">
                    @foreach (var word in Data.Words.Take(16))
                    {
                        <span style="font-size: @Number(11 + (7.0 * word.Count / _maxWord), "0")px" title="@word.Count×">@word.Word</span>
                    }
                </div>
            }
            @if (Data.WeirdestCaption is { } weird)
            {
                <p class="stats-weird" data-test="weirdest-caption"><b>WEIRDEST</b> @Local(Data.WeirdestAtUtc, "HH:mm:ss") — “@weird”</p>
            }
        }
    </ChildContent>
</TerminalPanel>

@code {
    public sealed record LightPoint(DateTime At, double Luminance);

    private List<LightPoint> _light = [];
    private bool _days;
    private int _maxWord = 1;

    protected override async Task<EnvironmentStatsDto?> LoadAsync(StatsQuery query)
    {
        var data = await Api.GetEnvironmentAsync(query);
        _light = data?.LightCurve.Select(p => new LightPoint(p.AtUtc.LocalDateTime, p.Luminance)).ToList() ?? [];
        // A day reads by the clock, longer ranges by the date: "16 Oct 06:54" on every tick ran together.
        _days = _light.Count > 1 && (_light[^1].At - _light[0].At).TotalHours > 26;
        _maxWord = Math.Max(1, data?.Words.Select(w => w.Count).DefaultIfEmpty(1).Max() ?? 1);
        return data;
    }

    private string AxisLabel(object value) => value is DateTime t
        ? t.ToString(_days ? "d MMM" : "HH:mm", System.Globalization.CultureInfo.CurrentCulture)
        : string.Empty;
}
