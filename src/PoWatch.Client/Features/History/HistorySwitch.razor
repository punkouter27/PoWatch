@using System.Globalization

@* History's one tab strip: the stories (every session, the week, the month) and the day view
   (calendar, recap, replay). Plain links, so each view has its own address. *@
<nav class="history-tabbar" aria-label="History" data-test="history-switch">
    @foreach (var (key, label, href, test) in Tabs)
    {
        <a class="history-tab @(Active == key ? "history-tab--on" : null)" href="@href" aria-current="@(Active == key ? "page" : null)" data-test="@test">@label</a>
    }
</nav>

@code {
    /// <summary>sessions, week, month or days.</summary>
    [Parameter] public string Active { get; set; } = "sessions";

    private static IEnumerable<(string Key, string Label, string Href, string Test)> Tabs =>
    [
        ("sessions", "Sessions", "history", "history-stories-link"),
        ("week", "Week", "history?view=week", "story-view-week"),
        ("month", "Month", "history?view=month", "story-view-month"),
        ("days", "Days", $"history/{DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}", "history-days-link"),
    ];
}
