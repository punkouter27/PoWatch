@page "/history/{Day}"
@using System.Globalization
@using PoWatch.Shared.Services.Recaps
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UiPrefs Prefs
@implements IDisposable

<PageTitle>PoWatch | History</PageTitle>

@* Master-detail in one viewport: on the left the year, the chosen day's numbers beside its week, and
   its sessions; on the right two tabs: the recap with its motion and captions, and the replay with the
   day's moments and time-lapse under it. On a desktop each column scrolls on its own, never the page. The day is in the address
   (/history/2026-10-03), so it survives a reload and Back/Forward walk the days you looked at. ◀ ▶ and
   the arrow keys step a day (menus.js); the calendar button jumps to any day. *@
<div class="history-page">
<HistorySwitch Active="days" />
<div class="history-grid">
    <div class="history-col">
        <TerminalPanel Title="The year" Test="history-calendar">
            <Aside>
                @(_patterns?.Calendar.Count ?? 0) DAYS · CLICK ONE TO OPEN IT
                @if (Prefs.Advanced)
                {
                    <span class="history-view" role="group" aria-label="Year view">
                        <button class="term-button @(_year3d ? null : "term-button--on")" aria-pressed="@(_year3d ? "false" : "true")" @onclick="() => SetYearViewAsync(false)" data-test="year-2d">2D</button>
                        <button class="term-button @(_year3d ? "term-button--on" : null)" aria-pressed="@(_year3d ? "true" : "false")" @onclick="() => SetYearViewAsync(true)" data-test="year-3d">3D</button>
                    </span>
                }
            </Aside>
            <ChildContent>
                @if (_year3d && Prefs.Advanced)
                {
                    <YearSkyline Values="@_skyValues" Wet="@_skyWet" Labels="@_skyLabels" Selected="@CellFor(_day)" OnPick="@(i => { if (DayFor(i) is { } d) Go(d); })" />
                }
                else
                {
                    <HeatGrid Values="@_calendarCells" Columns="53" Rows="7" Label="Daily occupancy over the last year"
                              Selected="@CellFor(_day)" OnCellClick="@(i => { if (DayFor(i) is { } d) Go(d); })"
                              CellTitle="@((i, v) => CellLabel(i, v))" />
                }
                @if (_weather?.Insight is { } insight)
                {
                    <p class="history-insight" data-test="weather-insight">@insight.Sentence</p>
                }
            </ChildContent>
        </TerminalPanel>

        <TerminalPanel Title="The day" Class="history-day-panel" Test="history-day-stats">
            <Aside>
                <span class="history-nav" data-test="history-toolbar">
                    <button class="term-button" @onclick="() => Move(-1)" aria-label="Previous day" title="Previous day (←)" data-test="history-prev">◀</button>
                    <span class="history-day" data-test="history-day">@_day.ToString("ddd d MMM yyyy", CultureInfo.CurrentCulture)</span>
                    <RadzenDatePicker TValue="DateOnly" Value="@_day" ValueChanged="@((DateOnly d) => Go(d))" ShowInput="false"
                                      Max="@Today.ToDateTime(TimeOnly.MinValue)" class="history-pick" aria-label="Pick a day" title="Pick a day" />
                    <button class="term-button" @onclick="() => Move(1)" disabled="@(_day >= Today)" aria-label="Next day" title="Next day (→)" data-test="history-next">▶</button>
                    <button class="term-button" @onclick="() => Go(Today)" disabled="@(_day == Today)" aria-label="Go to today">Today</button>
                </span>
            </Aside>
            <ChildContent>
                @if (!_loaded)
                {
                    <Skeleton Heights="@([0])" Span="term-span-4 history-skel-day" />
                }
                else if (_presence is null || _presence.SecondsObserved == 0)
                {
                    <p class="term-empty" data-test="history-empty">Nothing was observed on this day. <TryDemo /></p>
                }
                else
                {
                    <div class="history-numbers">
                        <Dial Value="@_presence.Occupancy" Label="occupied" />
                        <div class="term-stats">
                            <StatCell Label="Occupancy" Value="@_presence.Occupancy.ToString("0.0%", CultureInfo.InvariantCulture)" Test="history-occupancy" />
                            <StatCell Label="Observed" Value="@DisplayText.Duration(_presence.SecondsObserved)" />
                            <StatCell Label="Visits" Value="@_presence.Visits.ToString(CultureInfo.InvariantCulture)" />
                            <StatCell Label="Peak at once" Value="@_presence.PeakConcurrency.ToString(CultureInfo.InvariantCulture)" />
                            <StatCell Label="Busiest" Value="@(_presence.BusiestStartUtc?.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture) ?? "—")" />
                            <StatCell Label="Longest empty" Value="@DisplayText.Duration(_presence.LongestEmptySeconds)" />
                        </div>
                    </div>
                }
                @if (WeatherOn(_day) is { } weather)
                {
                    <p class="history-weather" data-test="history-weather" title="Weather at @_weather!.Place?.Name">@DisplayText.Weather(weather)</p>
                }

                @* The day's week against the week before: one row of numbers and the sentence. *@
                <div class="history-week" data-test="history-week">
                    <h3 class="history-sub">
                        The week · @WeekStart(_day).ToString("d MMM", CultureInfo.CurrentCulture) – @WeekStart(_day).AddDays(6).ToString("d MMM", CultureInfo.CurrentCulture) vs the week before
                    </h3>
                    @if (_week is null)
                    {
                        <Skeleton Heights="@([0])" Span="term-span-4 history-skel-week" />
                    }
                    else
                    {
                        <div class="term-stats history-week-stats">
                            <StatCell Label="Occupancy" Value="@_week.ThisWeek.Occupancy.ToString("0%", CultureInfo.InvariantCulture)" Hint="@Change(_week.ThisWeek.Occupancy, _week.LastWeek.Occupancy)" Test="week-occupancy" />
                            <StatCell Label="Observed" Value="@DisplayText.Duration(_week.ThisWeek.SecondsObserved)" Hint="@($"was {DisplayText.Duration(_week.LastWeek.SecondsObserved)}")" />
                            <StatCell Label="Visits" Value="@_week.ThisWeek.Visits.ToString(CultureInfo.InvariantCulture)" Hint="@($"was {_week.LastWeek.Visits}")" />
                            <StatCell Label="Busiest day" Value="@(_week.ThisWeek.BusiestDay?.ToString("ddd", CultureInfo.CurrentCulture) ?? "—")"
                                      Hint="@(_week.ThisWeek.BusiestDay is null ? null : _week.ThisWeek.BusiestOccupancy.ToString("0% occupied", CultureInfo.InvariantCulture))" />
                        </div>
                        @if (_week.Headline is { } headline)
                        {
                            <p class="history-week-headline" data-test="week-headline" title="Written by the server's AI model from the numbers below">✦ @headline</p>
                        }
                        <p class="history-week-summary" data-test="week-summary">@_week.Summary</p>
                    }
                </div>
            </ChildContent>
        </TerminalPanel>

        <DaySessions Sessions="@_sessions" Loaded="@_loaded" />
    </div>

    <RadzenTabs @bind-SelectedIndex="_tab" RenderMode="TabRenderMode.Server" class="history-tabs" data-test="history-tabs">
        <Tabs>
            <RadzenTabsItem Text="Recap">
                <DayRecap Day="@_day" Recap="@_recap" Presence="@_presence" Captions="@_environment" Loaded="@_loaded" Rewriting="@_rewriting" />
            </RadzenTabsItem>

            <RadzenTabsItem Text="Replay">
                <DayReplay Day="@_day" StartAt="@_replayAt" />
                <DayMoments Day="@_day" Sessions="@_sessions" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</div>
</div>
