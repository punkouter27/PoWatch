@inherits StatsTabBase<SpaceStatsDto>

<TerminalPanel Title="Space" Class="cell-space" Test="@(Data is null ? null : "stats-space")">
    <Aside>@(Data is null ? null : $"BUSIEST DOOR: {Data.BusiestEdge.ToUpperInvariant()}")</Aside>
    <ChildContent>
        @if (Data is null)
        {
            <StatsPending Loading="@Loading" Empty="No space stats for this range yet." />
        }
        else
        {
            <div class="stats-heats">
                <figure>
                    <HeatGrid Values="@Data.MotionHeat" Label="Motion across the frame" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0} of the hottest")" />
                    <figcaption title="The cell with the most motion">MOTION · @(Data.HottestCell >= 0 ? $"MOSTLY {Cell(Data.HottestCell)}" : "NONE YET")</figcaption>
                </figure>
                <figure>
                    <HeatGrid Values="@Data.PresenceHeat" Label="Where tracked people and animals were centred" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0}")" />
                    <figcaption title="Where people and animals were centred most">PEOPLE · @(Data.FavouriteSpotCell >= 0 ? $"MOSTLY {Cell(Data.FavouriteSpotCell)}" : "NOBODY YET")</figcaption>
                </figure>
            </div>
        }
    </ChildContent>
</TerminalPanel>

@code {
    protected override Task<SpaceStatsDto?> LoadAsync(StatsQuery query) => Api.GetSpaceAsync(query);

    /// <summary>Spreadsheet-style cell name: columns A–P, rows 1–9.</summary>
    private static string Cell(int index) => $"{(char)('A' + (index % 16))}{(index / 16) + 1}";
}
