<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoWatch.Mobile.Pages.OutboxPage"
             Title="Offline Sync">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Durable Outbox &amp; Sessions" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="SyncSummaryLabel" Text="Loading..." />
            <HorizontalStackLayout Spacing="10">
                <Button Text="Sync Outbox Now" Clicked="OnSyncNowClicked" />
                <Button Text="Refresh Sessions" Clicked="OnRefreshClicked" />
            </HorizontalStackLayout>
            <Label Text="Queued Batches" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="OutboxList" Spacing="6" />
            <Label Text="Recent Server Sessions" FontAttributes="Bold" Margin="0,10,0,0" />
            <VerticalStackLayout x:Name="SessionsList" Spacing="6" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
