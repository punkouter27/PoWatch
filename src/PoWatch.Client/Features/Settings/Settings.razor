@page "/settings"

<PageTitle>Settings · PoWatch</PageTitle>

@* The gear opens these in a drawer over any page; this address is for links and bookmarks. *@
<div class="settings-page">
    <SettingsPanel Section="@SectionParameter" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "section")] public string? SectionParameter { get; set; }
}
