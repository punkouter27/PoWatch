@* A Terminal panel: accent bar, title, optional right-aligned meta, then content. *@
<section class="term-panel @Class" data-test="@Test" aria-labelledby="@_headingId">
    <header class="term-panel-head">
        @if (HeadingLevel == 1)
        {
            <h1 id="@_headingId">@Title</h1>
        }
        else
        {
            <h2 id="@_headingId">@Title</h2>
        }
        @if (Aside is not null)
        {
            <span class="term-panel-meta">@Aside</span>
        }
        @PanelTools
    </header>
    <div class="term-panel-body @(Flush ? "term-panel-body--flush" : string.Empty)">
        @* One failing panel shows a retry box; the rest of the page keeps working. *@
        <ErrorBoundary @ref="_boundary">
            <ChildContent>
                @ChildContent
            </ChildContent>
            <ErrorContent>
                <div class="panel-error" role="alert" data-test="panel-error">
                    <span>This panel hit an error.</span>
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Click="() => _boundary?.Recover()">Retry</RadzenButton>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </div>
</section>

@code {
    private readonly string _headingId = $"panel-{Guid.NewGuid():N}";
    private ErrorBoundary? _boundary;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Aside { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Test { get; set; }

    /// <summary>1 when the panel is the page's only content and its title is the page's h1 (the not-found page).</summary>
    [Parameter] public int HeadingLevel { get; set; } = 2;

    /// <summary>No inner padding — for tables and camera feeds that run edge to edge.</summary>
    [Parameter] public bool Flush { get; set; }

    /// <summary>A page that lets panels be moved or hidden (Live) cascades its grip and hide button here.</summary>
    [CascadingParameter(Name = "PanelTools")] public RenderFragment? PanelTools { get; set; }
}
