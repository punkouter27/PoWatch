@inherits StatsTabBase<EnvironmentStatsDto>
@using PoWatch.Shared.Services
@inject SensingSession Sensing

@* Always rendered to prevent 3×3 grid jumps: shows live light curve with when the lights went on and off,
   mic level & sound freshness, and clickable Most Said chips that filter Narration. *@
<TerminalPanel Title="Room insights" Class="cell-env" Test="live-environment" Flush="true">
    <ChildContent>
        @if (HasReadings)
        {
            <div class="term-stats">
                @if (L.Light is not null)
                {
                    <StatCell Label="Light" Value="@Light" Hint="@Lights" Test="metric-light" />
                }
                @if (!string.IsNullOrEmpty(L.LastSound) || Sensing.Listening)
                {
                    <div class="term-stat" data-test="metric-sound">
                        <span class="term-stat-label">Last sound</span>
                        <span class="term-stat-value">@Sound</span>
                        <span class="term-stat-hint">@SoundHint</span>
                        @if (Sensing.Listening && L.AudioStatus == "listening")
                        {
                            <div class="mic-level" title="Live microphone level" aria-hidden="true">
                                <span style="width: @((int)Math.Round(L.SoundLevel * 100))%"></span>
                            </div>
                            @if (L.SoundMinutes.Average is { } sAvg)
                            {
                                <Sparkline Values="@L.SoundMinutes.Points" Max="1" Average="@sAvg"
                                           AverageLabel="@($"1m avg {sAvg:P0}")"
                                           Label="Ambient sound level per minute" />
                            }
                        }
                    </div>
                }
            </div>
        }
        @if (LightSeries() is { Count: > 1 } lightCurve)
        {
            var lightAvg = Sensing.IsRunning ? L.LightMinutes.Average : lightCurve.Average();
            <div class="env-light-spark" data-test="env-light-curve">
                <Sparkline Values="@lightCurve" Max="1" Cyan="true"
                           Average="@lightAvg"
                           AverageLabel="@(lightAvg is { } la ? $"1m avg {la:P0} light" : null)"
                           Label="Room brightness per minute over this session" />
            </div>
        }
        @if (Data is { } env)
        {
            <FactRow Test="env-facts" Facts="@([
                new("Light switches", env.LightCurve.Count > 0 ? env.Switches.Count.ToString(CultureInfo.InvariantCulture) : null, LastSwitch(env)),
                new("Sunrise", env.SunriseUtc is { } rise ? DisplayText.LocalTime(rise) : null, "Today's sunrise where you are"),
                new("Sunset", env.SunsetUtc is { } set ? DisplayText.LocalTime(set) : null, "Today's sunset where you are"),
                new("Captions", env.CaptionCount > 0 ? env.CaptionCount.ToString(CultureInfo.InvariantCulture) : null, "How many times the scene was described in words this session"),
            ])" />
            @* When the light changed, which the curve above shows only as a step. *@
            @if (env.Switches.Count > 0)
            {
                <p class="live-census" data-test="env-switches" title="When the room's lights went on or off this session">
                    <span class="live-heat-label">LIGHTS</span>
                    @for (var i = 0; i < Math.Min(4, env.Switches.Count); i++)
                    {
                        var sw = env.Switches[env.Switches.Count - 1 - i];
                        @if (i > 0)
                        {
                            <span aria-hidden="true"> · </span>
                        }
                        <span>@(sw.On ? "on" : "off") <b>@DisplayText.LocalTime(sw.AtUtc)</b></span>
                    }
                </p>
            }
            @if (env.Words.Count > 0)
            {
                <p class="live-census env-words" data-test="env-words" title="Click a word to filter Narration">
                    <span class="live-heat-label">MOST SAID</span>
                    @foreach (var word in env.Words.Take(8))
                    {
                        var w = word.Word;
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain word-chip"
                                      Click="() => OnWordPick.InvokeAsync(w)" title="@($"Filter narration by '{w}'")">
                            @w <b>@word.Count</b>
                        </RadzenButton>
                    }
                </p>
            }
        }
        @if (Data?.WeirdestCaption is { } caption)
        {
            <p class="stats-weird" data-test="weirdest-caption" title="The caption least like the others in this session">@Local(Data.WeirdestAtUtc, "HH:mm:ss") — “@caption”</p>
        }
        else if (Loading)
        {
            <Skeleton Heights="@([60])" />
        }
        else if (!Query.IsEmpty && Data is null)
        {
            <p class="live-error" role="status">Could not load this session's insights. Check System status or try again shortly.</p>
        }
        else if (!HasReadings && !HasHistory)
        {
            <p class="term-empty" data-test="env-empty">Light level and when the lights switch, ambient sounds and caption themes appear here once watching begins.</p>
        }
    </ChildContent>
</TerminalPanel>

@code {
    [Parameter] public EventCallback<string> OnWordPick { get; set; }

    private LiveSensingState L => Sensing.Live;
    private bool HasHistory => Data is { } d && (d.WeirdestCaption is not null || d.Words.Count > 0 || d.CaptionCount > 0 || d.LightCurve.Count > 0);

    private IReadOnlyList<double> LightSeries()
    {
        if (Sensing.IsRunning && L.LightMinutes.Points.Count > 1) return L.LightMinutes.Points;
        return Data?.LightCurve.Select(p => p.Luminance).ToList() ?? [];
    }

    private static string? LastSwitch(EnvironmentStatsDto env) => env.Switches.Count == 0
        ? "The lights have not been switched this session"
        : $"Lights last switched {(env.Switches[^1].On ? "on" : "off")} at {DisplayText.LocalTime(env.Switches[^1].AtUtc)}";

    private bool HasReadings => Sensing.IsRunning && (L.Light is not null || !string.IsNullOrEmpty(L.LastSound) || Sensing.Listening);

    protected override Task<EnvironmentStatsDto?> LoadAsync(StatsQuery query) => Api.GetEnvironmentAsync(query);
    protected override bool ShouldRender() => true;

    private string Light => L.Light is { } light ? light.ToString("P0", CultureInfo.InvariantCulture) : "—";

    /// <summary>Rough daylight guess from mean brightness: enough to say whether the lights are on.</summary>
    private string Lights => L.Light switch
    {
        null => "NO READING",
        > 0.35 => "LIGHTS ON",
        > 0.12 => "DIM",
        _ => "DARK",
    };

    private string Sound => string.IsNullOrEmpty(L.LastSound) ? "Quiet" : L.LastSound!;

    private string SoundHint
    {
        get
        {
            if (L.LastSoundUtc is { } at)
            {
                var ago = Math.Max(0, (int)(DateTimeOffset.UtcNow - at).TotalSeconds);
                var fresh = ago < 5 ? "just now" : $"{DisplayText.Duration(ago)} ago";
                return $"{fresh} · {(Sensing.Listening ? (L.AudioStatus ?? "listening") : "muted")}".ToUpperInvariant();
            }
            return Sensing.Listening ? (L.AudioStatus ?? "listening").ToUpperInvariant() : "NOT LISTENING";
        }
    }
}
