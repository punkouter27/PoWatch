@inherits SettingsTab

<TerminalPanel Title="Recording" Test="settings-recording" Flush="true">
    <Aside>REMEMBERED IN THIS BROWSER</Aside>
    <ChildContent>
        <div class="settings-list">
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" role="switch" aria-checked="@(Sensing.Listening ? "true" : "false")" Click="() => Sensing.SetListeningAsync(!Sensing.Listening)" data-test="listening-toggle">
                <span>Listening <i>the microphone, heard on this machine: words, sounds, loudness (never the audio itself)</i></span><b>@(Sensing.Listening ? "ON" : "OFF")</b>
            </RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" role="switch" aria-checked="@(Sensing.ReadPosture ? "true" : "false")" Click="() => Sensing.SetPostureAsync(!Sensing.ReadPosture)" data-test="posture-toggle">
                <span>Posture <i>sitting, standing or lying, read from body joints on this machine (never a face)</i></span><b>@(Sensing.ReadPosture ? "ON" : "OFF")</b>
            </RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" Disabled="@(!Sensing.ReadPosture)" Click="CycleSitNudgeAsync" data-test="sit-nudge-toggle">
                <span>Sitting nudge <i>"time to stand up" after this long sitting without a break: off · 30 · 45 · 60 · 90 minutes</i></span><b>@(Sensing.SitNudgeMinutes == 0 ? "OFF" : $"{Sensing.SitNudgeMinutes} MIN")</b>
            </RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" Click="CycleSoundAsync" data-test="sound-toggle">
                <span>Sound cues <i>off · low · mid · high</i></span><b>@_sound.ToUpperInvariant()</b>
            </RadzenButton>
            @* Which camera opens: a remembered choice, read when Start is pressed. *@
            <div class="settings-camera">
                <label for="camera-choice">Camera <i>opened when a session starts, remembered in this browser</i></label>
                <RadzenDropDown TValue="string" Data="@CameraKeys" Value="@(_camera.Length == 0 ? DefaultCamera : _camera)"
                                Change="@(v => SelectCameraAsync(v as string))" Name="camera-choice" data-test="camera-select"
                                InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Camera opened when a session starts" })">
                    <Template Context="id">@PickOption.Render((object)id, CameraLabel)</Template>
                    <ValueTemplate Context="id">@PickOption.Text((object)id, CameraLabel)</ValueTemplate>
                </RadzenDropDown>
            </div>
        </div>
    </ChildContent>
</TerminalPanel>

@code {
    private string _sound = "low";
    private string _camera = string.Empty;
    private (string Id, string Label)[] _cameras = [];

    protected override async Task OnInitializedAsync()
    {
        _sound = await JS.TryInvokeAsync<string>("powatchCues.level") ?? _sound;
        _camera = await JS.TryInvokeAsync<string>("powatchCamera.selected") ?? string.Empty;
        _cameras = Parse(await JS.TryInvokeAsync<string>("powatchCamera.list"));
    }

    /// <summary>"id&lt;TAB&gt;label" per line, as powatchCamera.list writes it.</summary>
    private static (string Id, string Label)[] Parse(string? raw) =>
        (raw ?? string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Split('\t'))
            .Where(parts => parts.Length == 2)
            .Select(parts => (Id: parts[0], Label: parts[1]))
            .ToArray();

    // The device's own default camera has no id; the dropdown needs a non-empty key for it.
    private const string DefaultCamera = "default";

    private string[] CameraKeys => [DefaultCamera, .. _cameras.Select(c => c.Id)];

    private string CameraLabel(string id) => id == DefaultCamera ? "Front camera (default)" : _cameras.FirstOrDefault(c => c.Id == id).Label ?? id;

    private async Task SelectCameraAsync(string? id) =>
        _camera = await JS.TryInvokeAsync<string>("powatchCamera.select", id is null or DefaultCamera ? string.Empty : id) ?? string.Empty;

    private Task CycleSitNudgeAsync()
    {
        var choices = SensingSession.SitNudgeChoices;
        return Sensing.SetSitNudgeAsync(choices[(Array.IndexOf(choices, Sensing.SitNudgeMinutes) + 1) % choices.Length]);
    }

    private async Task CycleSoundAsync() => _sound = await JS.TryInvokeAsync<string>("powatchCues.cycle") ?? _sound;
}
