@* Every optional choice, grouped by what it is about: what is recorded, who is known, what alerts you,
   what is shared, how it looks, and your account. Browser choices start on the values that suit most
   rooms and are remembered here; "Show power features" (Look) shows the extras here and across the app,
   and anything already switched on stays visible without it. One column: it opens in the gear's drawer,
   and as the /settings page (?section= opens a tab). Each tab is its own component and loads what it
   shows when it opens. *@
<div class="settings-stack" data-test="settings-page">
    <nav class="term-tabbar settings-tabs" aria-label="Settings sections">
        @foreach (var (key, label) in Sections)
        {
            <button type="button" class="term-tab @(_section == key ? "term-tab--on" : null)" aria-pressed="@(_section == key ? "true" : "false")"
                    @onclick="() => _section = key" data-test="@($"settings-tab-{key}")">@label</button>
        }
    </nav>

    @switch (_section)
    {
        case "recording":
            <RecordingSettings />
            break;
        case "people":
            <KnownRegulars />
            break;
        case "alerts":
            <AlertSettings />
            break;
        case "sharing":
            <SharingSettings />
            break;
        case "look":
            <LookSettings />
            break;
        default:
            <AccountSettings />
            break;
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Sections =
    [
        ("recording", "Recording"), ("people", "People"), ("alerts", "Alerts"), ("sharing", "Sharing"), ("look", "Look"), ("account", "Account"),
    ];

    /// <summary>The tab to open on: recording, people, alerts, sharing, look or account.</summary>
    [Parameter] public string? Section { get; set; }

    private string _section = "recording";

    protected override void OnParametersSet()
    {
        if (Section is { } section && Sections.Any(t => t.Key == section)) _section = section;
    }
}
