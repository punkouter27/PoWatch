@* Who is tracked right now, dwell percentiles, categorized object census, unified posture breakdown,
   sit-break progress with snooze, and a visual uprightness meter (BodyReadings, on-device). *@
@using PoWatch.Shared.Services
@inject SensingSession Sensing

@{ var census = CensusRows(); }
<TerminalPanel Title="In frame" Class="cell-inframe" Test="live-tracks" Flush="true">
    <Aside>@if (Sensing.IsRunning)
        {
            <span>@L.PeopleNow NOW · PEAK @L.PeakConcurrency · <span data-test="metric-visits">@L.Visits</span> VISITS</span>
        }
        else
        {
            <span>@census.Count THINGS SEEN</span>
        }</Aside>
    <ChildContent>
        @if (Presence is { } stay)
        {
            <FactRow Test="inframe-dwell" Facts="@([
                new("Typical (med)", stay.DwellP50Seconds is { } p50 ? DisplayText.Duration(p50) : null, "Median: half of all visits this session were shorter than this"),
                new("Long (90th)", stay.DwellP90Seconds is { } p90 ? DisplayText.Duration(p90) : null, "90th percentile: nine visits in ten were shorter than this"),
                new("Longest", stay.DwellMaxSeconds >= 1 ? DisplayText.Duration(stay.DwellMaxSeconds) : null, "The longest single visit this session"),
                new("Empty for", stay.LongestEmptySeconds >= 1 ? DisplayText.Duration(stay.LongestEmptySeconds) : null, "The longest stretch with nobody in frame"),
            ])" />
        }
        @if (L.Tracks.Count > 0)
        {
            <WhoList Rows="@WhoIsHere()" Label="Tracked right now" />
        }
        @if (census.Count == 0)
        {
            <p class="term-empty">Nothing seen yet.</p>
        }
        else
        {
            <div class="census-groups" data-test="live-census" title="Everything seen this session grouped by kind; currently in frame is bold">
                @foreach (var (group, items) in Categorize(census))
                {
                    <p class="live-census">
                        <span class="live-heat-label">@group</span>
                        @for (var i = 0; i < items.Count; i++)
                        {
                            var row = items[i];
                            var nowCount = L.ClassesNow.GetValueOrDefault(row.Name);
                            @if (i > 0)
                            {
                                <span aria-hidden="true"> · </span>
                            }
                            @if (nowCount > 0)
                            {
                                <b title="@nowCount now, @row.Peak at most">@row.Name@(nowCount > 1 ? $" ×{nowCount}" : null)</b>
                            }
                            else
                            {
                                <span title="@row.Peak at most">@row.Name</span>
                            }
                        }
                    </p>
                }
            </div>
        }
        @if (Presence is { } split && (split.SittingSeconds + split.StandingSeconds + split.LyingSeconds) >= 1)
        {
            <ShareBar Label="Person-time by posture this session" Test="posture-split" Legend="true"
                      Parts="@([
                          new("sitting", split.SittingSeconds, Note: DisplayText.Duration(split.SittingSeconds)),
                          new("standing", split.StandingSeconds, Note: DisplayText.Duration(split.StandingSeconds)),
                          new("lying", split.LyingSeconds, Note: DisplayText.Duration(split.LyingSeconds))
                      ])" />
            @if (split.LongestSittingSeconds >= 60)
            {
                <p class="live-census" data-test="live-posture">
                    <span class="live-heat-label">LONGEST SIT</span>@DisplayText.Duration(split.LongestSittingSeconds)
                </p>
            }
        }
        @if (Sensing.IsRunning && Sensing.SitNudgeMinutes > 0 && L.SittingFor >= TimeSpan.FromMinutes(1))
        {
            var limit = TimeSpan.FromMinutes(Sensing.SitNudgeMinutes);
            var pct = Math.Clamp((int)Math.Round(100 * L.SittingFor.TotalSeconds / limit.TotalSeconds), 0, 100);
            var due = L.SittingFor >= limit && DateTimeOffset.UtcNow >= _snoozedUntil;
            <div class="meter-row" data-test="sit-progress">
                <span class="live-heat-label">SIT BREAK</span>
                <div class="meter-track" role="img" aria-label="@($"{DisplayText.Duration(L.SittingFor.TotalSeconds)} of {Sensing.SitNudgeMinutes}m sit limit")">
                    <span class="meter-fill @(pct >= 100 ? "meter-fill--low" : pct >= 75 ? "meter-fill--warn" : "meter-fill--good")" style="width: @pct%"></span>
                </div>
                <span class="meter-val">@DisplayText.Duration(L.SittingFor.TotalSeconds) / @(Sensing.SitNudgeMinutes)m</span>
            </div>
            @if (due)
            {
                <div class="live-nudge" role="status" data-test="live-break-nudge">
                    <span>Sitting @DisplayText.Duration(L.SittingFor.TotalSeconds) straight. Time to stand up and stretch.</span>
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Click="SnoozeBreak" data-test="sit-snooze">Snooze 15m</RadzenButton>
                </div>
            }
        }
        @if (Sensing.IsRunning && Sensing.Bodies.PostureScore is { } score)
        {
            var rounded = (int)Math.Round(score);
            var grade = rounded >= 80 ? "Good" : rounded >= 60 ? "Fair" : "Slouching";
            var tone = rounded >= 80 ? "meter-fill--good" : rounded >= 60 ? "meter-fill--warn" : "meter-fill--low";
            <div class="meter-row" data-test="body-posture-score" title="Share of the time shoulders, hips and ears were seen that the back and neck were upright rather than slumped forward, from body points on this machine.">
                <span class="live-heat-label">UPRIGHT</span>
                <div class="meter-track" role="img" aria-label="@($"{rounded}% upright ({grade})")">
                    <span class="meter-fill @tone" style="width: @rounded%"></span>
                </div>
                <span class="meter-val">@rounded% · @grade@(Sensing.Bodies.SlumpedSeconds >= 1 ? $" (slumped {DisplayText.Duration(Sensing.Bodies.SlumpedSeconds)})" : null)</span>
            </div>
        }
        @* When each thing was around, not just whether it ever was: one line per presence class. *@
        @if (Sensing.IsRunning && Sparks() is { Count: > 0 } sparks)
        {
            <div class="live-class-sparks" data-test="class-sparks" aria-label="Each thing over this session">
                @foreach (var (name, values) in sparks)
                {
                    <span class="live-class-spark">
                        <Sparkline Values="@values" Max="@Math.Max(1, values.Max())" Label="@($"{name} over this session")" />
                        <span>@name</span>
                    </span>
                }
            </div>
        }
    </ChildContent>
</TerminalPanel>

@code {
    /// <summary>Classes seen in the range; kept until the next answer, so a failed refresh keeps the table.</summary>
    [Parameter] public ObjectStatsDto? Objects { get; set; }

    /// <summary>The session's presence numbers, for its posture split; null before the first answer.</summary>
    [Parameter] public PresenceStatsDto? Presence { get; set; }

    private ObjectStatsDto? _indexed;
    private Dictionary<string, ClassStatDto> _knownClasses = new(StringComparer.OrdinalIgnoreCase);
    private DateTimeOffset _snoozedUntil;

    private LiveSensingState L => Sensing.Live;

    private void SnoozeBreak() => _snoozedUntil = DateTimeOffset.UtcNow.AddMinutes(15);

    /// <summary>Who is tracked right now, how long they have been and, for a person whose posture was read, what it is.</summary>
    private List<WhoList.Row> WhoIsHere() =>
        L.Tracks.Take(8)
            .Select(t => new WhoList.Row(
                L.RegularFor(t.TrackId)?.DisplayName ?? t.Label,
                DisplayText.Duration((DateTimeOffset.UtcNow - t.FirstSeenUtc).TotalSeconds)
                    + (t.Posture == Posture.Unknown ? null : $" · {t.Posture.ToString().ToLowerInvariant()}")))
            .ToList();

    private static IEnumerable<(string Group, List<ClassStatDto> Items)> Categorize(List<ClassStatDto> rows)
    {
        var people = rows.Where(r => string.Equals(r.Name, "person", StringComparison.OrdinalIgnoreCase)).ToList();
        var pets = rows.Where(r => !string.Equals(r.Name, "person", StringComparison.OrdinalIgnoreCase) && CentroidTracker.IsPresence(r.Name)).ToList();
        var objects = rows.Where(r => !CentroidTracker.IsPresence(r.Name)).ToList();
        if (people.Count > 0) yield return ("PEOPLE", people);
        if (pets.Count > 0) yield return ("PETS", pets);
        if (objects.Count > 0) yield return ("OBJECTS", objects);
    }

    protected override void OnParametersSet()
    {
        // Live renders four times a second; re-index only when a new answer arrives.
        if (Objects is null || ReferenceEquals(Objects, _indexed)) return;
        _indexed = Objects;
        _knownClasses = Objects.Classes.GroupBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>Built once per render: what is in frame now first, then history.</summary>
    private List<ClassStatDto> CensusRows() =>
        L.ClassesSeen.Keys.Concat(_knownClasses.Keys)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(name => _knownClasses.GetValueOrDefault(name) ?? new ClassStatDto { Name = name, Peak = L.ClassesNow.GetValueOrDefault(name) })
            .OrderByDescending(c => L.ClassesNow.GetValueOrDefault(c.Name))
            .ThenByDescending(c => c.TicksPresent)
            .ToList();

    /// <summary>The busiest four presence classes with at least two samples, as sparkline series.</summary>
    private List<(string Name, IReadOnlyList<double> Values)> Sparks() =>
        L.ClassesSeen.Keys
            .Select(name => (Name: name, Counts: L.ClassHistory(name)))
            .Where(s => s.Counts.Count > 1)
            .OrderByDescending(s => s.Counts.Max())
            .Take(4)
            .Select(s => (s.Name, (IReadOnlyList<double>)s.Counts.Select(c => (double)c).ToList()))
            .ToList();
}
