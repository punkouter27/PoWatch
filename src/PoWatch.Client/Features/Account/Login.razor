@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager Nav

<PageTitle>Sign in · PoWatch</PageTitle>

@* The sign-in page is the title and one button, Microsoft, in every environment (AGENTS.md). Local and Test
   hosts sign in through the developer URL /auth/login/fake instead (AGENTS.md, Verification); it has no
   button here and answers 404 in Production. *@
<div class="login-shell" data-test="login-shell">
    <div class="login-card" data-test="login-card">
        <h1>Sign in to PoWatch</h1>
        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain login-btn login-btn-ms" Click="SignIn" data-test="login-microsoft">Sign in with Microsoft</RadzenButton>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    // A server route (the redirect to Microsoft), so a full load. The server keeps only local return paths.
    private void SignIn() =>
        Nav.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl)}", forceLoad: true);
}
