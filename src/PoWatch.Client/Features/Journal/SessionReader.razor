@inject PoWatchApiClient Api

@* The reader for one session, laid out like a day's: the story (with every chapter, newest first) and its
   numbers at the top, then the replay of just its minutes with its timeline. Every link to a session lands
   here (the index, the recap card); Live view shows its panels, Day the rest of that day. *@
@if (!_loaded)
{
    <Skeleton Heights="@([240])" />
}
else if (_session is null)
{
    <p class="term-empty" data-test="session-missing">That session was not found. <a class="term-link" href="journal">The Journal →</a></p>
}
else
{
    var tag = SessionDto.Tag(_session.Id);
    <TerminalPanel Title="@Heading(_session)" Class="reader story-card" Test="session-page">
        <Aside>
            <span class="story-meta">@tag · @(_session.IsRunning ? "RECORDING" : DisplayText.Duration(_session.DurationSeconds))</span>
            <a class="term-link" href="@($"?session={_session.Id}")" title="This session on Live">Live view →</a>
            <a class="term-link" href="@StoryLinks.DayOf(_session)" title="That day's recap, replay and timeline">Day →</a>
            <ExportMenu Test="session-export">
                <a class="term-menu-item" href="@PoWatchApiClient.SessionRecapPdfUrl(_session.Id)" download="PoWatch-session-@(tag[1..]).pdf" onclick="return powatchFiles.save(event, this)" data-test="session-pdf"><span>Recap <i>the session, as a PDF</i></span><b>PDF</b></a>
                <a class="term-menu-item" href="@PoWatchApiClient.AllStatsUrl(StatsQuery.For("session", _session.Id))" download="PoWatch-session-@(tag[1..]).json" data-test="session-json"><span>Everything stored <i>every tick, event and stat of the session</i></span><b>JSON</b></a>
            </ExportMenu>
        </Aside>
        <ChildContent>
            <SessionStory SessionId="@_session.Id" NewestFirst="true" />
            @if (_presence is { } p)
            {
                <div class="term-stats reader-numbers session-numbers" data-test="session-numbers">
                    <StatCell Label="Visits" Value="@p.Visits.ToString(CultureInfo.InvariantCulture)" />
                    <StatCell Label="Occupancy" Value="@p.Occupancy.ToString("0%", CultureInfo.InvariantCulture)" />
                    <StatCell Label="Peak at once" Value="@p.PeakConcurrency.ToString(CultureInfo.InvariantCulture)" />
                    <StatCell Label="Seen" Value="@(_objects?.Classes.Count.ToString(CultureInfo.InvariantCulture) ?? "0")" Hint="@string.Join(", ", _objects?.Classes.Take(4).Select(c => c.Name) ?? [])" />
                    <PostureCell Presence="@p" />
                </div>
            }
        </ChildContent>
    </TerminalPanel>

    <TerminalPanel Title="Replay and timeline" Class="reader" Test="reader-timeline">
        <ChildContent>
            <TimelineReplay Day="@DateOnly.FromDateTime(_session.StartedUtc.LocalDateTime)" From="@_session.StartedUtc" To="@(_session.EndedUtc ?? DateTimeOffset.UtcNow)" />
        </ChildContent>
    </TerminalPanel>
}

@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }

    private Guid _shown;
    private bool _loaded;
    private SessionDto? _session;
    private PresenceStatsDto? _presence;
    private ObjectStatsDto? _objects;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _shown) return;
        (_shown, _loaded, _session, _presence, _objects) = (Id, false, null, null, null);
        var id = Id;
        var session = await Api.GetSessionAsync(id);
        if (id != Id) return;
        (_session, _loaded) = (session, true);
        if (session is null) return;
        var query = StatsQuery.For("session", id);
        var presence = Api.GetPresenceAsync(query);
        var objects = Api.GetObjectsAsync(query);
        await Task.WhenAll(presence, objects);
        if (id == Id) (_presence, _objects) = (presence.Result, objects.Result);
    }

    private static string Heading(SessionDto session)
    {
        var start = session.StartedUtc.ToLocalTime();
        var end = (session.EndedUtc ?? DateTimeOffset.Now).ToLocalTime();
        return $"{start.ToString("ddd d MMM · HH:mm", CultureInfo.CurrentCulture)}–{end.ToString("HH:mm", CultureInfo.CurrentCulture)}";
    }
}
