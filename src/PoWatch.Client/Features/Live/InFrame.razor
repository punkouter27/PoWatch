@* Who is tracked right now and how long they have been, the session's head counts, then every other
   thing seen as one line (what is in frame now first, in bold). *@
@inject SensingSession Sensing

@{ var census = CensusRows(); }
<TerminalPanel Title="In frame" Class="cell-inframe" Test="live-tracks" Flush="true">
    <Aside>@if (Sensing.IsRunning)
        {
            <span>@L.PeopleNow NOW · PEAK @L.PeakConcurrency · <span data-test="metric-visits">@L.Visits</span> VISITS</span>
        }
        else
        {
            <span>@census.Count THINGS SEEN</span>
        }</Aside>
    <ChildContent>
        @if (L.Tracks.Count > 0)
        {
            <WhoList Rows="@WhoIsHere()" Label="Tracked right now" />
        }
        @if (census.Count == 0)
        {
            <p class="term-empty">Nothing seen yet.</p>
        }
        else
        {
            <p class="live-census" data-test="live-census" title="Everything seen this session; what is in frame now is bold">
                <span class="live-heat-label">SEEN</span>
                @for (var i = 0; i < census.Count; i++)
                {
                    var row = census[i];
                    @if (i > 0)
                    {
                        <span aria-hidden="true"> · </span>
                    }
                    @if (L.ClassesNow.GetValueOrDefault(row.Name) > 0)
                    {
                        <b title="@L.ClassesNow.GetValueOrDefault(row.Name) now, @row.Peak at most">@row.Name</b>
                    }
                    else
                    {
                        <span title="@row.Peak at most">@row.Name</span>
                    }
                }
            </p>
        }
        @* When each thing was around, not just whether it ever was: one line per presence class. *@
        @if (Sensing.IsRunning && Sparks() is { Count: > 0 } sparks)
        {
            <div class="live-class-sparks" data-test="class-sparks" aria-label="Each thing over this session">
                @foreach (var (name, values) in sparks)
                {
                    <span class="live-class-spark">
                        <Sparkline Values="@values" Max="@Math.Max(1, values.Max())" Label="@($"{name} over this session")" />
                        <span>@name</span>
                    </span>
                }
            </div>
        }
    </ChildContent>
</TerminalPanel>

@code {
    /// <summary>Classes seen in the range; kept until the next answer, so a failed refresh keeps the table.</summary>
    [Parameter] public ObjectStatsDto? Objects { get; set; }

    private ObjectStatsDto? _indexed;
    private Dictionary<string, ClassStatDto> _knownClasses = new(StringComparer.OrdinalIgnoreCase);

    private LiveSensingState L => Sensing.Live;

    /// <summary>Who is tracked right now and how long they have been.</summary>
    private List<WhoList.Row> WhoIsHere() =>
        L.Tracks.Take(8)
            .Select(t => new WhoList.Row(
                L.RegularFor(t.TrackId)?.DisplayName ?? t.Label,
                DisplayText.Duration((DateTimeOffset.UtcNow - t.FirstSeenUtc).TotalSeconds)))
            .ToList();

    protected override void OnParametersSet()
    {
        // Live renders four times a second; re-index only when a new answer arrives.
        if (Objects is null || ReferenceEquals(Objects, _indexed)) return;
        _indexed = Objects;
        _knownClasses = Objects.Classes.GroupBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>Built once per render: what is in frame now first, then history.</summary>
    private List<ClassStatDto> CensusRows() =>
        L.ClassesSeen.Keys.Concat(_knownClasses.Keys)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(name => _knownClasses.GetValueOrDefault(name) ?? new ClassStatDto { Name = name, Peak = L.ClassesNow.GetValueOrDefault(name) })
            .OrderByDescending(c => L.ClassesNow.GetValueOrDefault(c.Name))
            .ThenByDescending(c => c.TicksPresent)
            .ToList();

    /// <summary>The busiest four presence classes with at least two samples, as sparkline series.</summary>
    private List<(string Name, IReadOnlyList<double> Values)> Sparks() =>
        L.ClassesSeen.Keys
            .Select(name => (Name: name, Counts: L.ClassHistory(name)))
            .Where(s => s.Counts.Count > 1)
            .OrderByDescending(s => s.Counts.Max())
            .Take(4)
            .Select(s => (s.Name, (IReadOnlyList<double>)s.Counts.Select(c => (double)c).ToList()))
            .ToList();
}
