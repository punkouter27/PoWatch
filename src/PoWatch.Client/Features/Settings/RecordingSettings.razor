@inherits SettingsTab

<TerminalPanel Title="Recording" Test="settings-recording" Flush="true">
    <Aside>REMEMBERED IN THIS BROWSER</Aside>
    <ChildContent>
        <div class="settings-list">
            <button class="term-menu-item" role="switch" aria-checked="@(Sensing.Listening ? "true" : "false")" @onclick="() => Sensing.SetListeningAsync(!Sensing.Listening)" data-test="listening-toggle">
                <span>Listening <i>the microphone, heard on this machine: words, sounds, loudness (never the audio itself)</i></span><b>@(Sensing.Listening ? "ON" : "OFF")</b>
            </button>
            <button class="term-menu-item" role="switch" aria-checked="@(Sensing.ReadPosture ? "true" : "false")" @onclick="() => Sensing.SetPostureAsync(!Sensing.ReadPosture)" data-test="posture-toggle">
                <span>Posture <i>sitting, standing or lying, read from body joints on this machine (never a face)</i></span><b>@(Sensing.ReadPosture ? "ON" : "OFF")</b>
            </button>
            <button class="term-menu-item" disabled="@(!Sensing.ReadPosture)" @onclick="CycleSitNudgeAsync" data-test="sit-nudge-toggle">
                <span>Sitting nudge <i>"time to stand up" after this long sitting without a break: off · 30 · 45 · 60 · 90 minutes</i></span><b>@(Sensing.SitNudgeMinutes == 0 ? "OFF" : $"{Sensing.SitNudgeMinutes} MIN")</b>
            </button>
            <button class="term-menu-item" @onclick="CycleSoundAsync" data-test="sound-toggle">
                <span>Sound cues <i>off · low · mid · high</i></span><b>@_sound.ToUpperInvariant()</b>
            </button>
            @* Which camera opens: a remembered choice, read when Start is pressed. *@
            <div class="settings-camera">
                <label for="camera-choice">Camera <i>opened when a session starts, remembered in this browser</i></label>
                <select id="camera-choice" value="@_camera" @onchange="SelectCameraAsync" data-test="camera-select">
                    <option value="">Front camera (default)</option>
                    @foreach (var (id, label) in _cameras)
                    {
                        <option value="@id">@label</option>
                    }
                </select>
            </div>
        </div>
    </ChildContent>
</TerminalPanel>

@code {
    private string _sound = "low";
    private string _camera = string.Empty;
    private (string Id, string Label)[] _cameras = [];

    protected override async Task OnInitializedAsync()
    {
        _sound = await JS.TryInvokeAsync<string>("powatchCues.level") ?? _sound;
        _camera = await JS.TryInvokeAsync<string>("powatchCamera.selected") ?? string.Empty;
        _cameras = Parse(await JS.TryInvokeAsync<string>("powatchCamera.list"));
    }

    /// <summary>"id&lt;TAB&gt;label" per line, as powatchCamera.list writes it.</summary>
    private static (string Id, string Label)[] Parse(string? raw) =>
        (raw ?? string.Empty).Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Split('\t'))
            .Where(parts => parts.Length == 2)
            .Select(parts => (Id: parts[0], Label: parts[1]))
            .ToArray();

    private async Task SelectCameraAsync(ChangeEventArgs e) =>
        _camera = await JS.TryInvokeAsync<string>("powatchCamera.select", e.Value?.ToString() ?? string.Empty) ?? string.Empty;

    private Task CycleSitNudgeAsync()
    {
        var choices = SensingSession.SitNudgeChoices;
        return Sensing.SetSitNudgeAsync(choices[(Array.IndexOf(choices, Sensing.SitNudgeMinutes) + 1) % choices.Length]);
    }

    private async Task CycleSoundAsync() => _sound = await JS.TryInvokeAsync<string>("powatchCues.cycle") ?? _sound;
}
