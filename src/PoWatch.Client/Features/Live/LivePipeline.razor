@* Is the feed actually being sensed right now: the pixel layer's rate, how long a detection takes, and
   what still has to reach the server. The numbers behind the picture. *@
@using System.Globalization
@inject SensingSession Sensing

<TerminalPanel Title="Pipeline" Class="cell-pipeline" Test="live-pipeline" Flush="true">
    <Aside>@(Sensing.IsRunning ? "RUNNING" : "IDLE")</Aside>
    <ChildContent>
        <div class="term-stats">
            <StatCell Label="PIXELS" Value="@PixelRate" Unit="Hz" Hint="pixel layer, 4 Hz target" Test="metric-pixel-hz" />
            <StatCell Label="DETECTOR" Value="@DetectorMs" Unit="ms" Hint="@DetectorHint" Test="metric-detector-latency" />
            <StatCell Label="SENT" Value="@L.BatchesSent.ToString(CultureInfo.InvariantCulture)" Hint="@QueueHint" Test="metric-batches" />
        </div>
    </ChildContent>
</TerminalPanel>

@code {
    private LiveSensingState L => Sensing.Live;

    private string PixelRate => L.PixelSamples == 0 ? "—" : L.PixelHz.ToString("0.0", CultureInfo.InvariantCulture);

    private string DetectorMs => L.DetectorLatencyMs <= 0 ? "—" : L.DetectorLatencyMs.ToString("0", CultureInfo.InvariantCulture);

    private string DetectorHint => L.DetectorModel is { Length: > 0 } model
        ? $"{model} · {L.DetectorDevice ?? "unknown"}"
        : "no detection yet";

    private string QueueHint => $"{L.PendingBatches} queued · {L.LostTicks} lost";
}
