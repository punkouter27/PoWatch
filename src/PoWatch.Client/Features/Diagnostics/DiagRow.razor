@* One store or service on the diagnostics page: name, status badge, what it is for, latency, last checked. *@
<div class="po-diag__card diag-row" data-test="health-check">
    <span class="diag-name">@Entry.Name</span>
    <span class="po-badge po-badge--@Badge(Entry.Status)">@Entry.Status</span>
    <span class="diag-purpose">@Entry.Purpose@(Entry.Problem is { } problem ? $" Problem: {problem}." : null)</span>
    <span class="diag-latency">
        @(Entry.LatencyMs is { } ms ? $"{ms.ToString("0", CultureInfo.CurrentCulture)} ms · " : null)checked @Entry.LastCheckedUtc.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture)
    </span>
</div>

@code {
    [Parameter, EditorRequired] public DiagEntryDto Entry { get; set; } = default!;

    private static string Badge(string status) => status switch
    {
        "Healthy" => "ok",
        "Degraded" => "warn",
        _ => "bad"
    };
}
