@baseUrl = http://localhost

### ─── Sign in (Development) ─────────────────────────────────────────────────
# Becomes the guest; the cookie it sets signs every request below.

GET {{baseUrl}}/auth/login/fake?returnUrl=/

###

# Fill the guest with 60 days of history (once per user)
POST {{baseUrl}}/api/dev/seed?days=60&tz=America/New_York

### ─── Health ────────────────────────────────────────────────────────────────

GET {{baseUrl}}/health
Accept: application/json

### ─── Sessions ──────────────────────────────────────────────────────────────

POST {{baseUrl}}/api/sessions
Content-Type: application/json

{ "timeZoneId": "UTC" }

###

GET {{baseUrl}}/api/sessions

### ─── Stats, recaps, regulars ───────────────────────────────────────────────

GET {{baseUrl}}/api/stats/presence?range=today

###

GET {{baseUrl}}/api/recaps/day/2026-09-25?tz=UTC

###

GET {{baseUrl}}/api/regulars

### ─── AI models ─────────────────────────────────────────────────────────────

# Safe model labels and this browser's selection
GET {{baseUrl}}/api/ai/models

###

# Use the local Ollama model for later requests
PUT {{baseUrl}}/api/ai/models
Content-Type: application/json

{"modelId":"Ollama"}

###

# Deterministic recaps
PUT {{baseUrl}}/api/ai/models
Content-Type: application/json

{"modelId":"Template"}

###

# An unknown model is refused with a 400 Problem Details response
PUT {{baseUrl}}/api/ai/models
Content-Type: application/json

{"modelId":"not-configured"}

### ─── Diagnostics ───────────────────────────────────────────────────────────

# Masked system health snapshot (CPU, memory, storage status, masked credentials)
GET {{baseUrl}}/api/diagnostics/status
Accept: application/json

###

# OpenAPI spec JSON (Development only)
GET {{baseUrl}}/openapi/v1.json
Accept: application/json
