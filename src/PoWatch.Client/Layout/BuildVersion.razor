@using System.Reflection
@* The version badge, v{YYMMDD} (the HEAD commit's UTC date), a <footer> pinned to the bottom-right of every page
   (po-tokens.css .po-version), so a bug report can say which build it came from. Directory.Build.props
   stamps it into every assembly as [AssemblyMetadata("BuildVersion")]; /api/diag reports the same value. *@
@if (Stamp.Length > 0)
{
    <footer class="po-version" title="Build version (vYYMMDD)" data-test="build-stamp-corner">v@(Stamp)</footer>
}

@code {
    private static readonly string Stamp = typeof(BuildVersion).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildVersion")?.Value ?? string.Empty;
}
