@inherits SettingsTab

<TerminalPanel Title="Watch rules" Test="watch-rules">
    <Aside>@_rules.Count OF @WatchRules.Max</Aside>
    <ChildContent>
        @foreach (var rule in _rules)
        {
            <div class="rule-row">
                <span>@rule</span>
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-icon-button" Click="() => RemoveRuleAsync(rule)" aria-label="@($"Remove rule: {rule}")">✕</RadzenButton>
            </div>
        }
        @if (_rules.Count < WatchRules.Max)
        {
            <RadzenTemplateForm TItem="WatchRuleInputDto" Data="@_rule" Submit="@(_ => AddRuleAsync())" class="rule-form" data-test="rule-form">
                <FluentValidationValidator TModel="WatchRuleInputDto" Validator="@RuleRules" />
                <label class="visually-hidden" for="rule-class">Alert me when this appears</label>
                <RadzenDropDown TValue="string" Data="@RuleClasses" @bind-Value="_rule.Class" Name="rule-class" data-test="rule-class"
                                InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Alert me when this appears" })">
                    <Template Context="c">@PickOption.Render((object)c, k => k == WatchRules.Any ? "anything" : k)</Template>
                    <ValueTemplate Context="c">@PickOption.Text((object)c, k => k == WatchRules.Any ? "anything" : k)</ValueTemplate>
                </RadzenDropDown>
                <label class="visually-hidden" for="rule-from">From hour</label>
                <RadzenNumeric TValue="int" id="rule-from" Name="rule-from" Min="0" Max="23" @bind-Value="_rule.FromHour" ShowUpDown="false" InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "From hour" })" class="rule-hour" />
                <span aria-hidden="true">→</span>
                <label class="visually-hidden" for="rule-to">Until hour</label>
                <RadzenNumeric TValue="int" id="rule-to" Name="rule-to" Min="0" Max="23" @bind-Value="_rule.ToHour" ShowUpDown="false" InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Until hour" })" class="rule-hour" />
                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Disabled="@_adding" data-test="rule-add">@(_adding ? "…" : "Add")</RadzenButton>
                <ValidationMessage For="@(() => _rule.Class)" class="form-error" />
                <ValidationMessage For="@(() => _rule.FromHour)" class="form-error" />
                <ValidationMessage For="@(() => _rule.ToHour)" class="form-error" />
            </RadzenTemplateForm>
            @* Or in plain words: the server's model drafts the rule, which shows here to confirm before it is kept. *@
            <RadzenTemplateForm TItem="RuleDraftRequestDto" Data="@_words" Submit="@(_ => DraftRuleAsync())" class="rule-form rule-form--words" data-test="rule-words">
                <FluentValidationValidator TModel="RuleDraftRequestDto" Validator="@WordsRules" />
                <label class="visually-hidden" for="rule-words">Describe a rule in your own words</label>
                <RadzenTextBox id="rule-words" Name="Text" @bind-Value="_words.Text" Immediate="true" MaxLength="@RuleDraftRequestDto.MaxLength" autocomplete="off"
                               Placeholder="Or say it: tell me if a dog shows up at night" Disabled="@_drafting" />
                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Disabled="@_drafting">@(_drafting ? "…" : "Draft")</RadzenButton>
                <ValidationMessage For="@(() => _words.Text)" class="form-error" />
            </RadzenTemplateForm>
            @if (_draft is { } draft)
            {
                <div class="rule-row rule-row--draft" data-test="rule-draft">
                    <span>@draft</span>
                    <span>
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Click="KeepDraftAsync" data-test="rule-draft-keep">Keep</RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-icon-button" Click="() => _draft = null" aria-label="Discard the drafted rule">✕</RadzenButton>
                    </span>
                </div>
            }
            else if (_draftError is not null)
            {
                <p class="term-stat-hint" role="status">@_draftError</p>
            }
        }
        <p class="term-stat-hint">Alerts land in the bell. Hours are local; the same hour twice means any time. @(_notifications ?? "They also show as desktop notifications if you allow them.")</p>
    </ChildContent>
</TerminalPanel>
<TerminalPanel Title="Weekly email" Test="settings-email" Flush="true">
    <ChildContent>
        <SettingsBody Profile="@Profile" Missing="@ProfileMissing" Message="@ProfileMessage" Context="profile">
            <div class="settings-list">
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" role="switch" aria-checked="@(profile.DigestEmail ? "true" : "false")" Click="ToggleDigestEmailAsync"
                        Disabled="@(Saving || !profile.DigestEmailAvailable)" data-test="digest-toggle">
                    <span>Weekly email <i>@(profile.DigestEmailAvailable ? (profile.DigestEmail ? $"Mondays, to {profile.Email}" : "the week in review, Monday mornings") : "this server cannot send email; the week is in the Journal")</i></span>
                    <b>@(profile.DigestEmail ? "ON" : "OFF")</b>
                </RadzenButton>
            </div>
        </SettingsBody>
    </ChildContent>
</TerminalPanel>

@code {
    private List<WatchRule> _rules = [];
    private string? _notifications;
    [Inject] private FluentValidation.IValidator<WatchRuleInputDto> RuleRules { get; set; } = default!;
    private static readonly string[] RuleClasses = ["person", "cat", "dog", WatchRules.Any];
    [Inject] private FluentValidation.IValidator<RuleDraftRequestDto> WordsRules { get; set; } = default!;
    private readonly WatchRuleInputDto _rule = new();
    private readonly RuleDraftRequestDto _words = new();
    private bool _adding;
    private bool _drafting;
    private WatchRule? _draft;
    private string? _draftError;


    protected override async Task OnInitializedAsync()
    {
        var profile = LoadProfileAsync();
        _rules = await WatchRules.LoadAsync(JS);
        await profile;
    }

    private Task ToggleDigestEmailAsync() =>
        SaveProfileAsync(p => new() { RetentionDays = p.RetentionDays, Place = p.Place, DigestEmail = !p.DigestEmail },
            Profile?.DigestEmail == true ? "The weekly email is off." : "The weekly email is on.");

    private async Task DraftRuleAsync()
    {
        if (_drafting || !WordsRules.Validate(_words).IsValid) return;
        (_drafting, _draft, _draftError) = (true, null, null);
        var draft = await Api.DraftRuleAsync(_words.Text.Trim());
        _draft = draft is null ? null : new WatchRule(draft.Class, draft.FromHour, draft.ToHour);
        _draftError = draft is null ? "That did not read as a rule, or this server has no AI model. Try: a person between 22 and 6." : null;
        _drafting = false;
    }

    private async Task KeepDraftAsync()
    {
        if (_draft is not { } rule) return;
        if (!RuleRules.Validate(new WatchRuleInputDto { Class = rule.Class, FromHour = rule.FromHour, ToHour = rule.ToHour }).IsValid)
        {
            (_draft, _draftError) = (null, "That draft is not a rule PoWatch can watch for. Try: a person between 22 and 6.");
            return;
        }
        (_rule.Class, _rule.FromHour, _rule.ToHour, _draft, _words.Text) = (rule.Class, rule.FromHour, rule.ToHour, null, string.Empty);
        await AddRuleAsync();
    }

    private async Task AddRuleAsync()
    {
        // A drafted rule arrives from the model, not the form, so it passes the same rules here.
        if (_adding || !RuleRules.Validate(_rule).IsValid) return;
        _adding = true;
        try
        {
            var rule = new WatchRule(_rule.Class, _rule.FromHour, _rule.ToHour);
            if (!_rules.Contains(rule)) _rules.Add(rule);
            await SaveRulesAsync();
            // Asking needs a click, and this is one: the first rule is the moment the permission makes sense.
            _notifications = await JS.TryInvokeAsync<string>("powatchCues.allowNotifications") switch
            {
                "granted" => "Desktop notifications are on.",
                "denied" => "Desktop notifications are blocked for this site; alerts still show in the bell and play a sound.",
                _ => null
            };
        }
        finally
        {
            _adding = false;
        }
    }

    private Task RemoveRuleAsync(WatchRule rule)
    {
        _rules.Remove(rule);
        return SaveRulesAsync();
    }

    private async Task SaveRulesAsync()
    {
        await WatchRules.SaveAsync(JS, _rules);
        Sensing.Rules = [.. _rules];
    }
}
