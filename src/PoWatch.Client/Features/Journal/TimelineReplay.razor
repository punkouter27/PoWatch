@* The reader's replay and timeline in one: a day (or one session of it) minute by minute (replay.js draws
   and plays), and under it every line of what happened (MomentLine). A line moves the playhead to its
   moment; the playhead lights the line it is on and keeps it in view. For a session (From/To) the replay
   covers only the session's own minutes and lines. *@
@using System.Text.Json
@using PoWatch.Shared.Services
@implements IAsyncDisposable
@inject PoWatchApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="replay" @ref="_root" data-test="history-replay">
    @if (_data is null)
    {
        @if (_loaded)
        {
            <p class="term-empty">Could not load the replay — the server did not answer.</p>
        }
        else
        {
            <Skeleton Heights="@([180, 60])" />
        }
    }
    else if (_data.Minutes.Count == 0 && _lines.Count == 0)
    {
        <p class="term-empty" data-test="replay-empty">Nothing to replay: no minute was observed.</p>
    }
    else
    {
        @if (_data.Minutes.Count > 0)
        {
            <div class="replay-stage">
                <figure class="replay-view">
                    <canvas class="replay-heat" data-replay="heat" aria-label="Where things moved in the chosen minute"></canvas>
                    <figcaption>MOTION</figcaption>
                </figure>
                <figure class="replay-view" data-replay="camera-box" hidden>
                    <img data-replay="frame" alt="This device's time-lapse frame nearest the chosen minute" />
                    <figcaption>CAMERA · THIS DEVICE</figcaption>
                </figure>
                <div class="replay-readout">
                    <b class="replay-clock" data-replay="clock" data-test="replay-clock">--:--</b>
                    <span class="term-stat-hint" data-replay="stats"></span>
                    <p class="replay-caption" data-replay="caption"></p>
                </div>
            </div>

            <div class="replay-track-wrap">
                <canvas class="replay-track" data-replay="track" aria-hidden="true"></canvas>
                <input type="range" class="replay-scrub" data-replay="scrub" aria-label="Time of day" data-test="replay-scrub" />
            </div>

            <div class="replay-actions">
                <button class="term-button term-button--primary" data-replay="play" data-test="replay-play">▶ Play</button>
                <span class="term-stat-hint">@_data.Minutes.Count OBSERVED MINUTES · DRAG, OR ← → A MINUTE · CLICK A LINE TO JUMP</span>
            </div>
        }

        <h3 class="history-sub">Timeline · @_lines.Count @(_lines.Count == 1 ? "line" : "lines")</h3>
        var shown = _lines.Where(e => TimelineEntry.Passes(e, _filter)).ToList();
        <TimelineFilters @bind-Value="_filter">
            @* What is shown, filter and all. *@
            <ExportMenu Test="timeline-export">
                <TranscriptLink Entries="@shown" Title="@TranscriptTitle" FileName="@TranscriptFile" />
                @if (_frames > 0)
                {
                    <button class="term-menu-item" disabled="@(_saving || !_canRecord)" title="@(_canRecord ? "Download this browser's time-lapse as WebM" : "This browser cannot record video.")"
                            @onclick="SaveVideoAsync" data-test="replay-save-video">@(_saving ? "Saving…" : "Time-lapse")</button>
                    <button class="term-menu-item" disabled="@(_saving || _cutting || !_canRecord)" title="@(_canRecord ? "Download this browser's highlight reel as WebM" : "This browser cannot record video.")"
                            @onclick="SaveReelAsync" data-test="replay-save-reel">@(_cutting ? "Cutting…" : "Highlight reel")</button>
                }
            </ExportMenu>
        </TimelineFilters>
        @if (shown.Count == 0)
        {
            <p class="term-empty">@(_lines.Count == 0 ? "Nothing was written down: no captions, words or sounds were kept." : "Nothing of that kind.")</p>
        }
        else
        {
            <ol class="moment-list replay-lines" data-replay-lines data-test="timeline-lines">
                @foreach (var entry in shown)
                {
                    <MomentLine @key="entry" Entry="@entry" Jump="@(_data.Minutes.Count > 0)" />
                }
            </ol>
        }
    }
</div>

@code {
    private static readonly PoWatchJsonContext Json = PoWatchJsonContext.Default;

    /// <summary>A 16×9 motion grid per minute, one byte a cell.</summary>
    private const int Cells = 144;

    /// <summary>Ingest keeps ticks this far either side of their session (Tick.MaxClockSkew), so a session's replay reaches as far.</summary>
    private static readonly TimeSpan SessionSkew = TimeSpan.FromMinutes(5);

    /// <summary>Time-lapse frames per second in the saved video.</summary>
    private const int VideoFps = 12;

    /// <summary>The day the replay is of (the time-lapse is kept by day).</summary>
    [Parameter, EditorRequired] public DateOnly Day { get; set; }

    /// <summary>With <see cref="To"/>, only this stretch (a session); null replays the whole day.</summary>
    [Parameter] public DateTimeOffset? From { get; set; }
    [Parameter] public DateTimeOffset? To { get; set; }

    /// <summary>The minute to open on (Unix ms), e.g. from a caption search; null opens on the first observed minute.</summary>
    [Parameter] public long? StartAt { get; set; }

    private string TranscriptTitle => From is { } from && To is { } to
        ? $"PoWatch · session {from.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)}–{to.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)}"
        : $"PoWatch · {Day.ToString("dddd d MMMM yyyy", CultureInfo.CurrentCulture)}";

    private string TranscriptFile => From is { } from
        ? $"powatch-session-{from.ToLocalTime().ToString("yyyy-MM-dd-HHmm", CultureInfo.InvariantCulture)}.txt"
        : $"powatch-{DayKey}.txt";

    private ElementReference _root;
    private (DateOnly, DateTimeOffset?, DateTimeOffset?)? _shown;
    private ReplayDayDto? _data;
    private List<TimelineEntry> _lines = [];
    private string _filter = "all";
    private bool _loaded;
    private bool _mounted;
    private int _frames;
    private bool _canRecord;
    private bool _saving;
    private bool _cutting;

    private string DayKey => DisplayText.DayKey(Day);

    protected override async Task OnParametersSetAsync()
    {
        if (_shown == (Day, From, To)) return;
        _shown = (Day, From, To);
        if (_mounted) await JS.TryInvokeVoidAsync("powatchReplay.unmount", _root);
        (_data, _lines, _loaded, _mounted) = (null, [], false, false);

        var shown = _shown;
        var days = new List<DateOnly> { Day };
        if (From - SessionSkew is { } from && To + SessionSkew is { } to)
        {
            days.Clear();
            for (var d = DateOnly.FromDateTime(from.LocalDateTime); d <= DateOnly.FromDateTime(to.LocalDateTime); d = d.AddDays(1)) days.Add(d);
        }
        var replays = await Task.WhenAll(days.Select(d => Api.GetReplayAsync(d)));
        var frames = await JS.TryInvokeAsync<int>("powatchTimelapse.count", DayKey);
        var canRecord = await JS.TryInvokeAsync<bool>("powatchTimelapse.canRecord");
        if (_shown != shown) return; // A newer day or session owns the reader now.

        _data = replays.Any(r => r is null) ? null
            : From - SessionSkew is { } start && To + SessionSkew is { } end ? Window(replays!, start, end)
            : replays[0];
        _lines = _data?.Events.Select(TimelineEntry.From).OfType<TimelineEntry>().OrderBy(e => e.AtUtc).ToList() ?? [];
        (_frames, _canRecord, _loaded) = (frames, canRecord, true);
    }

    /// <summary>The minutes, grids and events of the days that fall inside [from, to], as one replay.</summary>
    private static ReplayDayDto Window(IEnumerable<ReplayDayDto> days, DateTimeOffset from, DateTimeOffset to)
    {
        var start = new DateTimeOffset(from.Ticks - (from.Ticks % TimeSpan.TicksPerMinute), from.Offset);
        var end = new DateTimeOffset(to.Ticks - (to.Ticks % TimeSpan.TicksPerMinute), to.Offset).AddMinutes(1);
        var minutes = new List<ReplayMinuteDto>();
        var grids = new List<byte>();
        var events = new List<ReplayEventDto>();
        var zone = string.Empty;
        foreach (var day in days)
        {
            zone = day.Window.TimeZoneId;
            var bytes = Convert.FromBase64String(day.Grids);
            for (var i = 0; i < day.Minutes.Count; i++)
            {
                if (day.Minutes[i].AtUtc < start || day.Minutes[i].AtUtc >= end) continue;
                minutes.Add(day.Minutes[i]);
                grids.AddRange(bytes.Length >= (i + 1) * Cells ? bytes[(i * Cells)..((i + 1) * Cells)] : new byte[Cells]);
            }
            events.AddRange(day.Events.Where(e => e.AtUtc >= from && e.AtUtc <= to));
        }
        return new ReplayDayDto
        {
            Window = new StatsWindowDto { Range = "session", FromUtc = start, ToUtc = end, Grain = "Minute", TimeZoneId = zone },
            Minutes = minutes,
            Grids = Convert.ToBase64String([.. grids]),
            Events = events,
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mounted || _data is not { Minutes.Count: > 0 }) return;
        _mounted = true;
        // The grids go over as raw bytes when they can (ReplayGrids), so the JSON carries everything else.
        var data = _data;
        if (await ReplayGrids.TryStageAsync(Nav.BaseUri, DayKey, data.Grids))
            data = new ReplayDayDto { Window = data.Window, Minutes = data.Minutes, Events = data.Events };
        await JS.TryInvokeVoidAsync("powatchReplay.mount", _root, JsonSerializer.Serialize(data, Json.ReplayDayDto), DayKey, StartAt ?? From?.ToUnixTimeMilliseconds());
    }

    /// <summary>Encodes the day's time-lapse frames (kept only in this browser) to a WebM and downloads it.</summary>
    private async Task SaveVideoAsync()
    {
        _saving = true;
        await JS.TryInvokeAsync<bool>("powatchTimelapse.saveVideo", DayKey, VideoFps);
        _saving = false;
    }

    /// <summary>
    /// Cuts the time-lapse to its highlights (<see cref="ReelPlanner"/>, from the replay already loaded:
    /// a session's reel covers only the session) and has timelapse.js paint and download it.
    /// </summary>
    private async Task SaveReelAsync()
    {
        if (_data is null) return;
        _cutting = true;
        try
        {
            var times = JsonSerializer.Deserialize(await JS.TryInvokeAsync<string>("powatchTimelapse.times", DayKey) ?? "[]", Json.ListDouble) ?? [];
            var (from, to) = (_data.Window.FromUtc.ToUnixTimeMilliseconds(), _data.Window.ToUtc.ToUnixTimeMilliseconds());
            var plan = ReelPlanner.Plan(
                times.Select(t => (long)t).Where(t => From is null || (t >= from && t < to)),
                _data,
                TranscriptTitle.Replace("PoWatch · ", string.Empty, StringComparison.Ordinal),
                TimeZoneInfo.Local);
            if (plan.Shots.Count > 0)
                await JS.TryInvokeAsync<bool>("powatchTimelapse.saveReel", DayKey, JsonSerializer.Serialize(plan, Json.ReelPlan));
        }
        catch (JsonException)
        {
            // The frame list could not be read: nothing to cut.
        }
        finally
        {
            _cutting = false;
        }
    }

    public async ValueTask DisposeAsync() => await JS.TryInvokeVoidAsync("powatchReplay.unmount", _root);
}
