@* A day minute by minute (replay.js does the drawing and playing). Loaded when its tab opens, so
   History stays as quick as before for anyone who never replays. *@
@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable
@inject PoWatchApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="replay" @ref="_root" data-test="history-replay">
    @if (_data is null)
    {
        @if (_loaded)
        {
            <p class="term-empty">Could not load the replay — the server did not answer.</p>
        }
        else
        {
            <Skeleton Heights="@([180, 60])" />
        }
    }
    else if (_data.Minutes.Count == 0)
    {
        <p class="term-empty" data-test="replay-empty">Nothing to replay: no minute of this day was observed.</p>
    }
    else
    {
        <div class="replay-stage">
            <figure class="replay-view">
                <canvas class="replay-heat" data-replay="heat" aria-label="Where things moved in the chosen minute"></canvas>
                <figcaption>MOTION</figcaption>
            </figure>
            <figure class="replay-view" data-replay="camera-box" hidden>
                <img data-replay="frame" alt="This device's time-lapse frame nearest the chosen minute" />
                <figcaption>CAMERA · THIS DEVICE</figcaption>
            </figure>
            <div class="replay-readout">
                <b class="replay-clock" data-replay="clock" data-test="replay-clock">--:--</b>
                <span class="term-stat-hint" data-replay="stats"></span>
                <p class="replay-caption" data-replay="caption"></p>
            </div>
        </div>

        <div class="replay-track-wrap">
            <canvas class="replay-track" data-replay="track" aria-hidden="true"></canvas>
            <input type="range" class="replay-scrub" data-replay="scrub" aria-label="Time of day" data-test="replay-scrub" />
        </div>

        <div class="replay-actions">
            <button class="term-button term-button--primary" data-replay="play" data-test="replay-play">▶ Play</button>
            <span class="term-stat-hint">@_data.Minutes.Count OBSERVED MINUTES · DRAG, OR ← → A MINUTE</span>
            <button class="term-button" disabled="@(_saving || VideoBlocker is not null)" title="@(VideoBlocker ?? "Download this browser's time-lapse of the day as a WebM")"
                    @onclick="SaveVideoAsync" data-test="replay-save-video">@(_saving ? "Saving…" : "Save video")</button>
            @if (VideoBlocker is not null)
            {
                <span class="term-stat-hint" data-test="replay-save-video-reason">@VideoBlocker</span>
            }
        </div>

        @if (_moments.Count > 0)
        {
            <h3 class="history-sub">Moments · jump to one</h3>
            <div class="replay-moments">
                @foreach (var moment in _moments)
                {
                    <button class="term-button" data-replay-jump="@moment.AtUtc.ToUnixTimeMilliseconds()" title="@moment.Text">
                        @moment.AtUtc.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture)
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    private static readonly PoWatchJsonContext Json = PoWatchJsonContext.Default;

    private ElementReference _root;
    private ReplayDayDto? _data;
    private List<ReplayEventDto> _moments = [];
    private bool _loaded;
    private bool _mounted;
    private int _frames;
    private bool _canRecord;
    private bool _saving;

    /// <summary>Time-lapse frames per second in the saved video.</summary>
    private const int VideoFps = 12;

    [Parameter, EditorRequired] public DateOnly Day { get; set; }

    /// <summary>The minute to open on (Unix ms), e.g. from a caption search; null opens on the first observed minute.</summary>
    [Parameter] public long? StartAt { get; set; }

    private string DayKey => Day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    /// <summary>Why "Save video" is off, or null when it can run: the frames live only in the browser that took them.</summary>
    private string? VideoBlocker =>
        _frames == 0 ? "This browser kept no time-lapse frames for this day."
        : !_canRecord ? "This browser cannot record video."
        : null;

    protected override async Task OnParametersSetAsync()
    {
        (_data, _loaded, _mounted) = (null, false, false);
        var day = Day;
        var data = await Api.GetReplayAsync(day);
        var frames = await JS.TryInvokeAsync<int>("powatchTimelapse.count", DayKey);
        var canRecord = await JS.TryInvokeAsync<bool>("powatchTimelapse.canRecord");
        if (day != Day) return; // A newer day owns the tab now.
        (_data, _frames, _canRecord) = (data, frames, canRecord);
        _moments = data?.Events.Where(e => e.Kind == "moment").ToList() ?? [];
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mounted || _data is not { Minutes.Count: > 0 }) return;
        _mounted = true;
        // The grids go over as raw bytes when they can (ReplayGrids), so the JSON carries everything else.
        var data = _data;
        if (await ReplayGrids.TryStageAsync(Nav.BaseUri, DayKey, data.Grids))
            data = new ReplayDayDto { Window = data.Window, Minutes = data.Minutes, Events = data.Events };
        await JS.TryInvokeVoidAsync("powatchReplay.mount", _root, JsonSerializer.Serialize(data, Json.ReplayDayDto), DayKey, StartAt);
    }

    /// <summary>Encodes the day's time-lapse frames (kept only in this browser) to a WebM and downloads it.</summary>
    private async Task SaveVideoAsync()
    {
        _saving = true;
        await JS.TryInvokeAsync<bool>("powatchTimelapse.saveVideo", DayKey, VideoFps);
        _saving = false;
    }

    public async ValueTask DisposeAsync() => await JS.TryInvokeVoidAsync("powatchReplay.unmount", _root);
}
