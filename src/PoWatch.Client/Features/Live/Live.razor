@page "/"
@implements IAsyncDisposable
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject StatsFeed Feed
@using PoWatch.Shared.Services

<PageTitle>Live · PoWatch</PageTitle>
@* The page's one h1, for screen readers; the lit section key in the header is its visible title. *@
<h1 class="visually-hidden">Live</h1>

@* One session, one toolbar; configuration folds away, diagnostics live on /diag.
   Desktop reads as three by three, by default with the camera in the middle cell and eight panels around
   it; each account can hide panels and reorder them (Panels menu, or drag a panel's grip). Below 1100px
   the panels stack in that order, camera first, so a phone still opens on the picture. *@
<div class="dash" data-inference-ms="@L.DetectorLatencyMs.ToString(CultureInfo.InvariantCulture)">
    <div class="stats-toolbar" data-test="stats-toolbar">
        <span class="stats-window term-stat-hint" data-test="stats-window">@WindowLabel</span>
        <SessionControls>
            <StartActions>
                <RadzenButton Text="@(_starting ? "Starting..." : "Start camera")" Icon="videocam"
                              Disabled="@_starting" Click="@(() => StartAsync(demo: false))" data-test="start-camera" />
                @* No demo button (owner, 2026-11-23): the demo scene starts from ?start=demo or Ctrl+K. *@
            </StartActions>
        </SessionControls>
        <a href="diag" class="term-button session-health" data-test="session-health">
            @(L.LastError is not null || L.LostTicks > 0 ? "Needs attention" : L.PendingBatches > 0 ? "Saving queued" : Sensing.IsRunning ? (Sensing.Paused ? "Paused" : "Sensing active") : "System status")
        </a>
        @* Which panels show and in what order, saved to the account. Dragging a panel's grip does the same. *@
        <details class="export-menu panels-menu" data-test="panels-menu">
            <summary class="term-button" title="Show, hide and reorder the panels">Panels @(VisiblePanels.Count)/@LivePanels.All.Count ▾</summary>
            <div class="export-menu-items panels-menu-items">
                <div class="panels-menu-all">
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Disabled="@(_hidden.Count == 0)" Click="ShowAllAsync" data-test="panels-show-all">Show all</RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Disabled="@(VisiblePanels.Count == 0)" Click="HideAllAsync" data-test="panels-hide-all">Hide all</RadzenButton>
                </div>
                @foreach (var id in _order)
                {
                    var shown = !_hidden.Contains(id);
                    <div @key="id" class="panels-menu-row">
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" role="switch" aria-checked="@(shown ? "true" : "false")"
                                      Click="() => SetHiddenAsync(id, shown)" data-test="@($"panel-toggle-{id}")">
                            <span>@LivePanels.Title(id)</span><b>@(shown ? "ON" : "OFF")</b>
                        </RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-icon-button" Disabled="@(_order[0] == id)" title="Move earlier" aria-label="@($"Move {LivePanels.Title(id)} earlier")"
                                      Click="() => StepAsync(id, -1)" data-test="@($"panel-up-{id}")">↑</RadzenButton>
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-icon-button" Disabled="@(_order[^1] == id)" title="Move later" aria-label="@($"Move {LivePanels.Title(id)} later")"
                                      Click="() => StepAsync(id, 1)" data-test="@($"panel-down-{id}")">↓</RadzenButton>
                    </div>
                }
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-menu-item" Disabled="@IsDefaultLayout" Click="ResetLayoutAsync" data-test="panels-reset">
                    <span>Reset <i>every panel, in the original order</i></span><b>↺</b>
                </RadzenButton>
            </div>
        </details>
        @if (_sessionMissing)
        {
            <span class="live-error" role="status" data-test="session-missing">That session was not found, so this is your latest one.</span>
        }

        @if (_error is not null)
        {
            <p class="live-error" role="alert" data-test="live-error">@_error</p>
        }
    </div>

    @* Which models see, hear and write, each switchable right here. *@
    <AiSelectors />

    <AwayCard />

    @* The nine panels in the user's order (saved per account); hidden ones leave no gap, the rest fill the
       grid in order. Each panel's title bar carries a grip to drag it onto another panel's place and a ×. *@
    <div class="dash-grid @(_cameraExpanded ? "dash-grid--cam-expanded" : null)" @ref="_grid" data-test="live-grid">
        @foreach (var (id, index) in VisiblePanels.Select((id, i) => (id, i + 1)))
        {
            <div @key="id" class="live-slot @(id == LivePanels.Camera && _cameraExpanded ? "live-slot--expanded" : null)" data-slot="@index" data-panel="@id" data-test="live-slot-@id">
                <CascadingValue Name="PanelTools" Value="@PanelTools(id)">
                    @switch (id)
                    {
                        case LivePanels.Camera:
                            <TerminalPanel Title="Camera" Class="live-camera" Test="live-camera" Flush="true">
                                <Aside>
                                    @if (Sensing.IsRunning)
                                    {
                                        <span class="space-switch" role="group" aria-label="Camera overlays">
                                            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_showBoxes ? "pw-plain on" : "pw-plain")" aria-pressed="@(_showBoxes ? "true" : "false")" Click="() => _showBoxes = !_showBoxes" title="Toggle object boxes" data-test="cam-toggle-boxes">BOXES</RadzenButton>
                                            @if (!L.Demo)
                                            {
                                                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_showFaces ? "pw-plain on" : "pw-plain")" aria-pressed="@(_showFaces ? "true" : "false")" Click="ToggleFaceOverlayAsync" title="Toggle face points and labels" data-test="cam-toggle-faces">FACES</RadzenButton>
                                                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_showPose ? "pw-plain on" : "pw-plain")" aria-pressed="@(_showPose ? "true" : "false")" Click="TogglePoseOverlayAsync" title="Toggle pose skeleton" data-test="cam-toggle-pose">POSE</RadzenButton>
                                            }
                                            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_privacyBlur ? "pw-plain on" : "pw-plain")" aria-pressed="@(_privacyBlur ? "true" : "false")" Click="() => _privacyBlur = !_privacyBlur" title="Blur video preview while keeping stats live" data-test="cam-toggle-blur">BLUR</RadzenButton>
                                            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_voiceAlerts ? "pw-plain on" : "pw-plain")" aria-pressed="@(_voiceAlerts ? "true" : "false")" Click="ToggleVoiceAlertsAsync" title="Speak alerts and sit-break nudges on-device" data-test="cam-toggle-tts">VOICE</RadzenButton>
                                        </span>
                                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(Sensing.Paused ? "pw-plain cam-ctrl on" : "pw-plain cam-ctrl")" Click="TogglePause" title="Pause or resume sensing without ending the session" data-test="cam-pause">
                                            @(Sensing.Paused ? "Resume" : "Pause")
                                        </RadzenButton>
                                    }
                                    else
                                    {
                                        <span>STANDBY</span>
                                    }
                                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain cam-ctrl" Click="ToggleCameraExpandAsync" title="@(_cameraExpanded ? "Exit expanded view" : "Expand camera")" data-test="cam-expand">
                                        @(_cameraExpanded ? "⤡" : "⤢")
                                    </RadzenButton>
                                </Aside>
                                <ChildContent>
                                    @* The camera element itself lives in the layout and is docked over this slot. *@
                                    <div class="live-stage">
                                        <div class="live-feed @(_privacyBlur ? "live-feed--blur" : null)" @ref="_slot">
                                            @if (!Sensing.IsRunning || L.Demo)
                                            {
                                                <canvas class="demo-flow" @ref="_demoCanvas" aria-hidden="true"></canvas>
                                                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button demo-effects" aria-pressed="@(_demoEffects ? "true" : "false")"
                                                        Click="ToggleDemoEffects" data-test="demo-effects" title="Decorative simulation, not measured motion">
                                                    Effects @(_demoEffects ? "on" : "off")
                                                </RadzenButton>
                                            }
                                            @if (Sensing.IsRunning && !Sensing.Paused && _showBoxes)
                                            {
                                                @foreach (var track in L.Tracks)
                                                {
                                                    var reg = L.RegularFor(track.TrackId);
                                                    var selected = _selectedRegularId is not null && reg?.Id == _selectedRegularId;
                                                    var dwell = DisplayText.Duration((DateTimeOffset.UtcNow - track.FirstSeenUtc).TotalSeconds);
                                                    var distM = Math.Clamp(0.85 / Math.Max(0.15, track.Box.Y1 - track.Box.Y0), 0.4, 6.0);
                                                    <div @key="track.TrackId" class="live-box @(track.Label == "person" ? "live-box--person" : string.Empty) @(selected ? "live-box--selected" : string.Empty)"
                                                         data-uncertain="@(track.Box.Score < 0.6 ? "true" : "false")"
                                                         style="left: @Pct(track.Box.X0 * 100)%; top: @Pct(track.Box.Y0 * 100)%; width: @Pct((track.Box.X1 - track.Box.X0) * 100)%; height: @Pct((track.Box.Y1 - track.Box.Y0) * 100)%;">
                                                        <span title="@($"Confidence {track.Box.Score:P0} · ~{distM:0.0}m · Track {track.TrackId}")">@(reg?.DisplayName ?? track.Label) · @dwell · ~@(distM.ToString("0.0", CultureInfo.InvariantCulture))m</span>
                                                    </div>
                                                }
                                            }

                                            @if (!Sensing.IsRunning)
                                            {
                                                <div class="live-standby" data-test="live-standby">
                                                    <p>Point a camera at anything, press Start, walk away.</p>
                                                    <p class="term-stat-hint">Use Start camera above.</p>
                                                </div>
                                            }
                                            else if (Sensing.Paused)
                                            {
                                                <div class="live-paused" data-test="live-paused">
                                                    <p>PAUSED · PRIVACY SHUTTER</p>
                                                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Click="TogglePause">Resume sensing</RadzenButton>
                                                </div>
                                            }
                                            else if (Sensing.Live.Demo)
                                            {
                                                <div class="live-demo-note" aria-hidden="true">DEMO SCENE · SYNTHETIC</div>
                                            }
                                            @if (Sensing.IsRunning)
                                            {
                                                @* A broadcast-style corner readout: on air, the clock, who is in view, how long it has run. *@
                                                <div class="live-hud" aria-hidden="true" data-test="live-hud">
                                                    <span class="@(Sensing.Paused ? "live-hud-paused" : "live-hud-rec")">●</span> @DateTime.Now.ToString("HH:mm:ss", CultureInfo.InvariantCulture)
                                                    · @(Sensing.Paused ? "PAUSED" : $"{L.PeopleNow} IN VIEW")
                                                    @if (L.Session?.StartedUtc is { } began)
                                                    {
                                                        <text> · @DisplayText.Duration((DateTimeOffset.UtcNow - began).TotalSeconds)</text>
                                                    }
                                                </div>
                                                @if (L.LastSnapshotUtc is { } snapAt && DateTimeOffset.UtcNow - snapAt < TimeSpan.FromSeconds(4))
                                                {
                                                    <div class="live-snap-toast" role="status" data-test="live-snap-toast">Snapshot saved</div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </ChildContent>
                            </TerminalPanel>
                            break;
                        case "metrics":
                            <KeyMetrics Range="session" Presence="@_presence" Patterns="@_patterns" OccupancyTrend="@_occupancyTrend" VisitsTrend="@_visitsTrend" />
                            break;
                        case "inframe":
                            <InFrame Objects="@_objects" Presence="@_presence" />
                            break;
                        case "faces":
                            <LiveFaces />
                            break;
                        case "narration":
                            @* What the camera and the microphone are turning into words, newest first, with the session's map. *@
                            <TerminalPanel Title="Narration" Class="cell-narration" Test="live-narration-panel" Flush="true">
                                <Aside>NEWEST FIRST</Aside>
                                <ChildContent>
                                    <LiveNarration SessionId="@_sessionId" SearchQuery="@_narrationSearch" SearchQueryChanged="OnNarrationSearchChanged" />
                                </ChildContent>
                            </TerminalPanel>
                            break;
                        case "space":
                            @* The room's space in one 16×9 grid with edge labels, colour legend, clickable cell details, human zone names, and net doorway traffic. *@
                            <TerminalPanel Title="Space" Class="cell-heat" Test="live-motion-grid">
                                <Aside>
                                    <span class="space-switch" role="group" aria-label="Which heat to show">
                                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_spaceMode == "motion" ? "pw-plain on" : "pw-plain")" aria-pressed="@(_spaceMode == "motion" ? "true" : "false")" Click='() => SetSpaceModeAsync("motion")' data-test="space-motion">MOTION</RadzenButton>
                                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_spaceMode == "people" ? "pw-plain on" : "pw-plain")" aria-pressed="@(_spaceMode == "people" ? "true" : "false")" Click='() => SetSpaceModeAsync("people")' data-test="space-people">PEOPLE</RadzenButton>
                                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_spaceMode == "thermal" ? "pw-plain on" : "pw-plain")" aria-pressed="@(_spaceMode == "thermal" ? "true" : "false")" Click='() => SetSpaceModeAsync("thermal")' data-test="space-thermal">THERMAL</RadzenButton>
                                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="@(_spaceMode == "fluid" ? "pw-plain on" : "pw-plain")" aria-pressed="@(_spaceMode == "fluid" ? "true" : "false")" Click='() => SetSpaceModeAsync("fluid")' data-test="space-fluid">FLUID</RadzenButton>
                                    </span>
                                </Aside>
                                <ChildContent>
                                    <div class="live-heat-frame">
                                        <span class="heat-edge heat-edge--top" aria-hidden="true">TOP</span>
                                        <div class="live-heat-mid">
                                            <span class="heat-edge heat-edge--side" aria-hidden="true">L</span>
                                            <div class="live-heat">
                                                @if (_spaceMode is "thermal" or "fluid")
                                                {
                                                    <canvas class="fluid-canvas" @ref="_fluidCanvas" aria-label="Room motion thermal and fluid field"></canvas>
                                                }
                                                else if (_spaceMode == "people")
                                                {
                                                    <HeatGrid Values="@(_space?.PresenceHeat ?? [])" Label="Where tracked people and animals were centred today"
                                                              Selected="@_pickedCell" OnCellClick="PickSpaceCell"
                                                              CellTitle="@((i, v) => $"{ColorNamer.ZoneName(i)} · {v:P0}")" />
                                                }
                                                else
                                                {
                                                    <HeatGrid Values="@L.Heat.Select(v => (double)v).ToList()" Label="Where motion is happening right now"
                                                              Selected="@_pickedCell" OnCellClick="PickSpaceCell"
                                                              CellTitle="@((i, v) => $"{ColorNamer.ZoneName(i)} · {v:P0} motion")" />
                                                }
                                            </div>
                                            <span class="heat-edge heat-edge--side" aria-hidden="true">R</span>
                                        </div>
                                        <span class="heat-edge heat-edge--bottom" aria-hidden="true">BOTTOM</span>
                                    </div>
                                    <div class="heat-legend" aria-hidden="true" data-test="space-legend">
                                        <span>Quiet</span>
                                        <span class="heat-legend-bar"></span>
                                        <span>Busy</span>
                                    </div>
                                    @if (_pickedCell >= 0)
                                    {
                                        var val = _peopleHeat
                                            ? (_space is { PresenceHeat.Count: > 0 } && _pickedCell < _space.PresenceHeat.Count ? _space.PresenceHeat[_pickedCell] : 0)
                                            : (_pickedCell < L.Heat.Count ? L.Heat[_pickedCell] : 0);
                                        <p class="live-census space-picked" data-test="space-picked">
                                            <span class="live-heat-label">CELL</span>
                                            <b>@ColorNamer.ZoneName(_pickedCell)</b> · @val.ToString("P0", CultureInfo.InvariantCulture) @(_peopleHeat ? "presence today" : "motion now")
                                        </p>
                                    }
                                    @if (_space is { } space)
                                    {
                                        var cameIn = space.Entries.Values.Sum();
                                        var wentOut = space.Exits.Values.Sum();
                                        var net = cameIn - wentOut;
                                        var netLabel = net == 0 ? "balanced" : $"{(net > 0 ? "+" : "")}{net} net";
                                        <FactRow Test="stats-space" Facts="@([
                                            new("Hot spot", space.HottestCell >= 0 ? ColorNamer.ZoneName(space.HottestCell) : "—", "The grid zone with the most motion today"),
                                            new("Favourite", space.FavouriteSpotCell >= 0 ? ColorNamer.ZoneName(space.FavouriteSpotCell) : "—", "Where tracked people and animals were centred most today"),
                                            new("Traffic", $"{cameIn} in · {wentOut} out", $"Tracks crossing frame edges today ({netLabel})"),
                                            new("Net flow", netLabel, space.BusiestEdge != "None" ? $"Busiest door: {space.BusiestEdge}" : "Entries minus exits today"),
                                        ])" />
                                        @* Which edge of the frame is the door: entries and exits together, per edge. *@
                                        <ShareBar Label="Comings and goings by frame edge today" Test="space-edges"
                                                  Parts="@([.. space.Entries.Keys.Union(space.Exits.Keys).Select(edge => new ShareBar.Part(edge.ToLowerInvariant(), space.Entries.GetValueOrDefault(edge) + space.Exits.GetValueOrDefault(edge), Note: $"{space.Entries.GetValueOrDefault(edge)} in · {space.Exits.GetValueOrDefault(edge)} out")).OrderByDescending(p => p.Value)])" />
                                    }
                                    else
                                    {
                                        <p class="term-empty" data-test="space-empty">Spots and doors appear after the first minute of watching today.</p>
                                    }
                                </ChildContent>
                            </TerminalPanel>
                            break;
                        case "environment":
                            <LiveEnvironment Query="@_query" OnWordPick="PickWord" />
                            break;
                        case "regulars":
                            <LiveRegulars SelectedRegularId="@_selectedRegularId" OnSelectRegular="SelectRegular" />
                            break;
                        case "activity":
                            <LiveActivity Patterns="@_patterns" Presence="@_presence" />
                            break;
                    }
                </CascadingValue>
            </div>
        }
        @if (VisiblePanels.Count == 0)
        {
            <div class="live-all-hidden" data-test="live-all-hidden">
                <p>Every panel is hidden.</p>
                <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain term-button" Click="ShowAllAsync" data-test="panels-show-all-empty">Show all panels</RadzenButton>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>The grip and the hide button each panel's title bar shows (TerminalPanel renders them).</summary>
    private RenderFragment PanelTools(string id) =>
        @<span class="panel-tools">
            <span class="panel-grip" data-grip title="Drag onto another panel to move it there" aria-hidden="true">⠿</span>
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain panel-hide" title="@($"Hide {LivePanels.Title(id)}")" aria-label="@($"Hide {LivePanels.Title(id)}")"
                          Click="() => SetHiddenAsync(id, true)" data-test="@($"panel-hide-{id}")">×</RadzenButton>
        </span>;
}
