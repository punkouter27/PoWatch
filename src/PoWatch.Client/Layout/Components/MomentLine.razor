@* One line of what happened (TimelineEntry): the time, an icon + colour-coded tag (SAW · SAID · HEARD · IN · OUT · ★)
   and the sentence, with an optional repeat badge (×N) and clickable snapshot thumbnail when one was kept. *@
<li class="moment @(Lit ? "is-now" : null)" data-test="moment-line" data-kind="@Entry.Kind">
    @if (Jump)
    {
        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain moment-jump" data-replay-jump="@Entry.AtUtc.ToUnixTimeMilliseconds()" title="@($"Replay from {Time}")">
            <time class="num">@Time</time>
            <span class="moment-tag"><span aria-hidden="true">@Icon</span> @Entry.Tag</span>
            <span class="moment-text">@Entry.Sentence</span>
            @if (RepeatCount > 1)
            {
                <span class="moment-repeat" title="@($"Repeated {RepeatCount} times")">×@RepeatCount</span>
            }
        </RadzenButton>
    }
    else
    {
        <time class="num">@Time</time>
        <span class="moment-tag"><span aria-hidden="true">@Icon</span> @Entry.Tag</span>
        <span class="moment-text">@Entry.Sentence</span>
        @if (RepeatCount > 1)
        {
            <span class="moment-repeat" title="@($"Repeated {RepeatCount} times")">×@RepeatCount</span>
        }
    }
    @if (Entry.ImageUrl is { } url)
    {
        <a class="moment-thumb" href="@url" target="_blank" rel="noopener" title="Open snapshot">
            <img src="@url" alt="Snapshot: @Entry.Text" loading="lazy" />
        </a>
    }
</li>

@code {
    [Parameter, EditorRequired] public TimelineEntry Entry { get; set; } = default!;

    /// <summary>A button that moves the surrounding replay's playhead to this line.</summary>
    [Parameter] public bool Jump { get; set; }

    /// <summary>Lit for a moment (Live's minimap picked it).</summary>
    [Parameter] public bool Lit { get; set; }

    /// <summary>When consecutive identical lines were collapsed, how many were merged.</summary>
    [Parameter] public int RepeatCount { get; set; } = 1;

    private string Time => Entry.AtUtc.ToLocalTime().ToString("HH:mm:ss", CultureInfo.CurrentCulture);

    private string Icon => Entry.Kind switch
    {
        "caption" => "◉",
        "speech" => "“”",
        "sound" => "♪",
        "enter" => "→",
        "exit" => "←",
        _ => "★"
    };
}
