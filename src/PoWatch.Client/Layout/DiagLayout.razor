@inherits LayoutComponentBase

@* /diag and the not-found page answer everyone. Signed out it gets the bare shell (title, Sign in, gear), so a visitor's page
   asks the server for nothing login-only; signed in it gets the full app shell (section keys, bottom
   tab bar, session controls), like any other page. *@
<AuthorizeView>
    <Authorized>
        <MainLayout Body="@Body" />
    </Authorized>
    <NotAuthorized>
        <BareLayout Body="@Body" />
    </NotAuthorized>
</AuthorizeView>
