<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- The Po build stamp (v{YYMMDD}), on every assembly: the HEAD commit's UTC date, so a deploy is
       named by the code it shipped. The one generation path: the client shows it bottom-right
       (Layout/Components/BuildStamp.razor) and /api/diag reports it (DiagEndpoints), from the same
       BuildDate metadata. rev-list rather than a log format string: its % is eaten by the cmd shell
       Exec uses on Windows. No git (a source zip) falls back to today's UTC date. -->
  <Target Name="PoBuildStamp" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-list -1 --timestamp HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PoHeadCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_PoHeadCommitExit" />
    </Exec>
    <PropertyGroup>
      <PoStamp Condition="'$(_PoHeadCommitExit)' == '0' and '$(_PoHeadCommit)' != ''">$([System.DateTime]::new(1970, 1, 1, 0, 0, 0, System.DateTimeKind.Utc).AddSeconds($(_PoHeadCommit.Split(' ')[0])).ToString('yyMMdd'))</PoStamp>
      <PoStamp Condition="'$(PoStamp)' == ''">$([System.DateTime]::UtcNow.ToString('yyMMdd'))</PoStamp>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildDate</_Parameter1>
        <_Parameter2>$(PoStamp)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildVersion</_Parameter1>
        <_Parameter2>$(PoStamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
