<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoWatch.Mobile.Pages.SentryPage"
             Title="PoWatch Sentry">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="PoWatch Mobile Sentry" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="StatusLabel" Text="Standby — ready to start camera/sensor session." FontSize="14" />

            <Border Padding="14" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Device Telemetry" FontAttributes="Bold" />
                    <Label x:Name="BatteryLabel" Text="Battery: checking..." />
                    <Label x:Name="NetworkLabel" Text="Network: checking..." />
                    <HorizontalStackLayout Spacing="10">
                        <Switch x:Name="WakeLockSwitch" IsToggled="True" Toggled="OnWakeLockToggled" />
                        <Label Text="Keep screen awake during sentry" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10">
                <Button x:Name="StartButton" Text="Start Session" Clicked="OnStartClicked" />
                <Button x:Name="StopButton" Text="Stop Session" Clicked="OnStopClicked" IsEnabled="False" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Capture Snapshot" Clicked="OnCapturePhotoClicked" />
                <Button x:Name="SendTickButton" Text="Send/Queue 10s Tick" Clicked="OnSendTickClicked" IsEnabled="False" />
            </HorizontalStackLayout>

            <Image x:Name="SnapshotPreview" HeightRequest="180" Aspect="AspectFit" IsVisible="False" />
            <Label x:Name="HubStatusLabel" Text="SignalR Hub: disconnected" FontSize="12" Opacity="0.8" />
            <Label x:Name="OutboxCountLabel" Text="Pending offline batches: 0" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
