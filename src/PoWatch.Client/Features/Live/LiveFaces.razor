@* Face readings (temporary labels, classical beauty breakdown, age, presentation) and a clearly separated
   Body language sub-card with colour-coded cues. Hovering a face highlights its hairline chip on Camera. *@
@using PoWatch.Shared.Services
@implements IDisposable
@inject SensingSession Sensing
@inject IJSRuntime JS

<TerminalPanel Title="Faces" Class="cell-faces" Test="live-faces" Flush="true">
    <Aside>ON DEVICE@(Sensing.FacesLabelled > 0 ? $" · {Sensing.FacesLabelled} LABELLED" : null)</Aside>
    <ChildContent>
        @if (!Sensing.IsRunning)
        {
            <p class="term-empty" data-test="faces-idle">Faces are read while the camera runs.</p>
        }
        else if (Sensing.Live.Demo)
        {
            <p class="term-empty" data-test="faces-idle">The demo has no camera, so there are no faces to read.</p>
        }
        else
        {
            <div class="metric-cards" data-test="face-trends">
                <RadzenCard class="metric-card">
                    <StatCell Label="Beauty" Value="@Now(f => f.Beauty, "0")" Hint="@Span(T.SessionBeauty, T.BeautyRange, "0")" Test="face-beauty-trend" />
                    <Sparkline Values="@T.BeautyMinutes.Points" Max="100"
                               Average="@T.BeautyMinutes.Average"
                               AverageLabel="@(T.BeautyMinutes.Average is { } ba ? $"1m avg {ba:0}" : null)"
                               Label="Mean beauty per minute over this session" />
                </RadzenCard>
                <RadzenCard class="metric-card">
                    <StatCell Label="Age" Value="@Now(f => f.AgeYears, "0")" Unit="yrs" Hint="@Span(T.SessionAge, T.AgeRange, "0")" Test="face-age-trend" />
                    <Sparkline Values="@T.AgeMinutes.Points" Cyan="true"
                               Average="@T.AgeMinutes.Average"
                               AverageLabel="@(T.AgeMinutes.Average is { } aa ? $"1m avg {aa:0} yrs" : null)"
                               Label="Mean estimated age per minute over this session" />
                </RadzenCard>
            </div>
            <FactRow Test="faces-facts" Facts="@([
                new("In view", Sensing.Faces.Count.ToString(CultureInfo.InvariantCulture), "Faces the landmarker sees right now"),
                new("Most at once", T.FacesHistory.Count > 0 ? T.FacesHistory.Max().ToString("0", CultureInfo.InvariantCulture) : null, "The most faces in view together this session"),
                new("Labelled", Sensing.FacesLabelled.ToString(CultureInfo.InvariantCulture), "Temporary Person labels given this session; forgotten when it ends"),
            ])" />

            @if (Sensing.Faces.Count == 0)
            {
                <p class="term-empty" data-test="faces-list-empty">No face in view.</p>
            }
            else
            {
                <ul class="live-who face-rows" aria-label="Faces in view" data-test="faces-list">
                    @foreach (var face in Sensing.Faces)
                    {
                        var slot = face.Slot;
                        var expanded = _expandedSlot == slot;
                        var profile = Sensing.PersonProfileFor(slot);
                        var returning = Sensing.IsReturningPerson(slot);
                        <li @key="slot" class="face-row" @onmouseenter="() => HighlightAsync(slot)" @onmouseleave="() => HighlightAsync(null)">
                            <div class="face-row-head">
                                <b>@(profile?.DisplayName ?? face.Label ?? "Reading…")</b>
                                @if (returning && profile is not null)
                                {
                                    <span class="face-returning-badge" title="Recognised from previous sessions in Azure Table Storage">Returning · @profile.SessionsSeen sessions</span>
                                }
                                @if (face.QualityLabel is { } qual)
                                {
                                    <span class="cue-pill cue-pill--neutral" title="Pose and framing quality for Age &amp; Beauty">@qual</span>
                                }
                                <span>@Note(face)</span>
                                @if (face.Symmetry is not null)
                                {
                                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="pw-plain face-why-btn"
                                                  Click="() => _expandedSlot = expanded ? null : slot"
                                                  title="Show classical beauty canon breakdown" data-test="face-breakdown-toggle">
                                        @(expanded ? "Hide" : "Why?")
                                    </RadzenButton>
                                }
                            </div>
                            <div class="face-metrics-strip" data-test="face-extra-metrics">
                                @if (face.AttentionShare is { } att) { <span>Focus <b>@($"{att:P0}")</b></span> }
                                @if (face.SmileScore is { } sm) { <span>Smile <b>@($"{sm:0}")</b></span> }
                                @if (face.ConcentrationScore is { } cc) { <span>Focus brow <b>@($"{cc:0}")</b></span> }
                                @if (face.BlinkRatePerMin is { } br) { <span>Blinks <b>@($"{br:0}/m")</b></span> }
                                @if (face.FatigueShare is { } ft && ft >= 0.05) { <span>Fatigue <b>@($"{ft:P0}")</b></span> }
                                @if (face.IsTalking) { <span><b>Talking</b></span> }
                                @if (face.DistanceBand is { } dist) { <span>Dist <b>@dist</b></span> }
                                @if (face.FaceShape is { } shape) { <span>Shape <b>@shape</b></span> }
                            </div>
                            @if (profile is { Stats: { } hs } && (hs.FaceSamples > 1 || hs.BodySamples > 0))
                            {
                                <div class="face-history" data-test="face-history">
                                    <span>All-time: @HistoryLine(hs)</span>
                                </div>
                            }
                            @if (expanded && face.Symmetry is { } sym)
                            {
                                <div class="face-breakdown" data-test="face-breakdown">
                                    <span>Symmetry <b>@($"{sym:P0}")</b></span>
                                    @if (face.Golden is { } phi) { <span>φ ratio <b>@($"{phi:P0}")</b></span> }
                                    @if (face.Thirds is { } th) { <span>Thirds <b>@($"{th:P0}")</b></span> }
                                    @if (face.Fifths is { } fi) { <span>Fifths <b>@($"{fi:P0}")</b></span> }
                                </div>
                            }
                        </li>
                    }
                </ul>
            }

            @if (!Sensing.FacesRead && Sensing.Faces.Count > 0)
            {
                <div class="model-progress" data-test="faces-loading" role="status">
                    <span class="term-stat-hint">Loading face models (~190 MB first time) for age, presentation &amp; labels…</span>
                    <div class="model-progress-track"><span class="model-progress-bar"></span></div>
                </div>
            }

            @if (Sensing.Bodies.InView.Count > 0 || BodySummary() is not null)
            {
                <div class="sub-card" data-test="body-language-card">
                    <p class="panel-subhead" data-test="body-language-now">BODY LANGUAGE</p>
                    @if (Sensing.Bodies.InView.Count > 0)
                    {
                        <ul class="live-who body-cue-list" aria-label="Body language of each body in view" data-test="body-language">
                            @foreach (var body in Sensing.Bodies.InView)
                            {
                                <li @key="body.Slot">
                                    <b>Body @body.Slot</b>
                                    <span class="cue-pills">
                                        @if (body.Cues == BodyCues.None)
                                        {
                                            <span class="cue-pill cue-pill--open">open</span>
                                        }
                                        else
                                        {
                                            @foreach (var cue in Cues(body.Cues))
                                            {
                                                <span class="cue-pill @CueTone(cue)">@Words(cue)</span>
                                            }
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    @if (BodySummary() is { } summary)
                    {
                        <p class="live-census" data-test="body-language-summary" title="Person-time this session, read from body points on this machine">
                            <span class="live-heat-label">SESSION</span>@summary
                        </p>
                    }
                </div>
            }
        }
        <p class="term-stat-hint">Beauty is the classical canon (symmetry, thirds, fifths, φ) read from landmarks. Age &amp; presentation are model estimates. Session aggregates may be saved to your Journal; raw face descriptors never leave this device.</p>
    </ChildContent>
</TerminalPanel>

@code {
    private int? _expandedSlot;

    // Live passes this panel no parameters, so its re-renders skip it: it follows the session itself.
    protected override void OnInitialized() => Sensing.Changed += OnSensingChanged;

    private void OnSensingChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Sensing.Changed -= OnSensingChanged;
        _ = JS.TryInvokeVoidAsync("powatchFaces.highlight", (object?)null);
    }

    private Task HighlightAsync(int? slot) => JS.TryInvokeVoidAsync("powatchFaces.highlight", slot);

    private FaceTrends T => Sensing.FaceTrends;

    /// <summary>One reading averaged over the faces in view right now; "—" when none has it.</summary>
    private string Now(Func<FaceReadout, double?> read, string format)
    {
        var values = Sensing.Faces.Select(read).OfType<double>().ToList();
        return values.Count == 0 ? "—" : values.Average().ToString(format, CultureInfo.InvariantCulture);
    }

    /// <summary>"Session 54 · range 49–61"; waiting text before the first point.</summary>
    private static string Span(double? mean, (double Low, double High)? range, string format)
    {
        var ic = CultureInfo.InvariantCulture;
        if (mean is not { } m) return "Waiting for a face";
        var text = $"Session {m.ToString(format, ic)}";
        return range is { } r ? $"{text} · range {r.Low.ToString(format, ic)}–{r.High.ToString(format, ic)}" : text;
    }

    private static IEnumerable<BodyCues> Cues(BodyCues cues) =>
        Enum.GetValues<BodyCues>().Where(c => c != BodyCues.None && cues.HasFlag(c));

    private static string CueTone(BodyCues cue) => cue switch
    {
        BodyCues.ArmsCrossed or BodyCues.HandToFace => "cue-pill--closed",
        BodyCues.LeaningIn or BodyCues.HandsOnHips => "cue-pill--engaged",
        _ => "cue-pill--neutral",
    };

    private static string Words(BodyCues cue) => cue switch
    {
        BodyCues.ArmsCrossed => "arms crossed",
        BodyCues.HandsOnHips => "hands on hips",
        BodyCues.HandToFace => "hand to face",
        BodyCues.HandsBehindHead => "hands behind head",
        BodyCues.LeaningIn => "leaning in",
        BodyCues.LeaningBack => "leaning back",
        _ => cue.ToString(),
    };

    /// <summary>"mostly open (84%) · arms crossed 2m 10s · leaning in 5m 00s"; null before a body was read for a few seconds.</summary>
    private string? BodySummary()
    {
        var b = Sensing.Bodies;
        if (b.ObservedSeconds < 5) return null;
        var open = b.OpenSeconds / b.ObservedSeconds;
        var parts = new List<string> { $"{(open >= 0.5 ? "mostly open" : "mostly closed")} ({open.ToString("P0", CultureInfo.InvariantCulture)} open)" };
        parts.AddRange(b.CueSeconds.Where(p => p.Value >= 1).OrderByDescending(p => p.Value).Select(p => $"{Words(p.Key)} {DisplayText.Duration(p.Value)}"));
        return string.Join(" · ", parts);
    }

    private static string Note(FaceReadout face)
    {
        var ic = CultureInfo.InvariantCulture;
        var parts = new List<string>(3)
        {
            face.Beauty is { } beauty ? string.Create(ic, $"beauty {beauty:0}") : "beauty —",
        };
        if (face.AgeBand is { } age) parts.Add(string.Create(ic, $"age {age} ({face.AgeConfidence * 100:0}%)"));
        if (face.Readings > 0)
        {
            parts.Add(face.Presentation is { } presentation
                ? string.Create(ic, $"{presentation}-presenting ({face.PresentationConfidence * 100:0}%)")
                : "presentation unclear");
        }
        return string.Join(" · ", parts);
    }

    private static string HistoryLine(PersonAppearanceStatsDto s)
    {
        var ic = CultureInfo.InvariantCulture;
        var parts = new List<string>();
        if (s.BeautyMean is { } bm)
            parts.Add(string.Create(ic, $"beauty {bm:0}") + (s.BeautyLow is { } bl && s.BeautyHigh is { } bh ? string.Create(ic, $" ({bl:0}–{bh:0})") : ""));
        if (s.AgeMean is { } am) parts.Add(string.Create(ic, $"age {am:0}"));
        if (s.FaceShape is { } sh) parts.Add(sh);
        if (s.AttentionShare is { } at) parts.Add(string.Create(ic, $"focus {at:P0}"));
        if (s.SmileMean is { } sm) parts.Add(string.Create(ic, $"smile {sm:0}"));
        if (s.BlinkRateMean is { } br) parts.Add(string.Create(ic, $"{br:0} blinks/m"));
        if (s.UprightScore is { } up) parts.Add(string.Create(ic, $"upright {up:0}%"));
        if (s.OpenPostureShare is { } op) parts.Add(string.Create(ic, $"open {op:P0}"));
        if (s.ArmBalance is { } ab) parts.Add(string.Create(ic, $"arms {ab * 100:0}/{(1 - ab) * 100:0}"));
        return string.Join(" · ", parts);
    }
}
