@* Face readings: the temporary labels the camera gives the people in front of it, and what its landmarks
   and the face models say about them. Read on this device and never stored — the labels last one
   session (docs/adr/0001-face-statistics-on-device.md, docs/adr/0002-session-scoped-face-labels.md).
   Under them, the body language the body points show (arms crossed, leaning in…), also this session's only (ADR 0003). *@
@using PoWatch.Shared.Services
@implements IDisposable
@inject SensingSession Sensing

<TerminalPanel Title="Faces" Class="cell-faces" Test="live-faces" Flush="true">
    <Aside>ON DEVICE@(Sensing.FacesLabelled > 0 ? $" · {Sensing.FacesLabelled} LABELLED" : null)</Aside>
    <ChildContent>
        @if (!Sensing.IsRunning)
        {
            <p class="term-empty" data-test="faces-idle">Faces are read while the camera runs.</p>
        }
        else if (Sensing.Live.Demo)
        {
            <p class="term-empty" data-test="faces-idle">The demo has no camera, so there are no faces to read.</p>
        }
        else
        {
            @* Moving averages over the session: one point per 5 s while a face was in view (FaceTrends). *@
            <div class="metric-cards" data-test="face-trends">
                <RadzenCard class="metric-card">
                    <StatCell Label="Beauty" Value="@Now(f => f.Beauty, "0")" Hint="@Span(T.SessionBeauty, T.BeautyRange, "0")" Test="face-beauty-trend" />
                    <Sparkline Values="@T.BeautyHistory" Max="100" Label="Mean beauty of the faces in view over this session" />
                </RadzenCard>
                <RadzenCard class="metric-card">
                    <StatCell Label="Age" Value="@Now(f => f.AgeYears, "0")" Unit="yrs" Hint="@Span(T.SessionAge, T.AgeRange, "0")" Test="face-age-trend" />
                    <Sparkline Values="@T.AgeHistory" Cyan="true" Label="Mean estimated age of the faces in view over this session" />
                </RadzenCard>
            </div>
            <FactRow Test="faces-facts" Facts="@([
                new("In view", Sensing.Faces.Count.ToString(CultureInfo.InvariantCulture), "Faces the landmarker sees right now"),
                new("Most at once", T.FacesHistory.Count > 0 ? T.FacesHistory.Max().ToString("0", CultureInfo.InvariantCulture) : null, "The most faces in view together this session"),
                new("Labelled", Sensing.FacesLabelled.ToString(CultureInfo.InvariantCulture), "Temporary Person labels given this session; forgotten when it ends"),
            ])" />
            <WhoList Rows="@Rows()" Label="Faces in view" Test="faces-list" Empty="No face in view." />
            @if (!Sensing.FacesRead && Sensing.Faces.Count > 0)
            {
                <p class="term-stat-hint" data-test="faces-loading">Loading the face models (about 190 MB the first time) for age, presentation and labels.</p>
            }
            @if (Sensing.Bodies.InView.Count > 0)
            {
                <p class="live-census" data-test="body-language-now"><span class="live-heat-label">BODY LANGUAGE</span></p>
                <WhoList Rows="@BodyRows()" Label="Body language of each body in view" Test="body-language" />
            }
            @if (BodySummary() is { } summary)
            {
                <p class="live-census" data-test="body-language-summary" title="Person-time this session, read from body points on this machine">
                    <span class="live-heat-label">SESSION</span>@summary
                </p>
            }
        }
        <p class="term-stat-hint">Beauty is the classical canon (symmetry, thirds, fifths, φ) read from the landmarks. Age and presentation are model estimates and can be wrong. Nothing about a face leaves this device or is stored.</p>
    </ChildContent>
</TerminalPanel>

@code {
    // Live passes this panel no parameters, so its re-renders skip it: it follows the session itself.
    protected override void OnInitialized() => Sensing.Changed += OnSensingChanged;

    private void OnSensingChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Sensing.Changed -= OnSensingChanged;

    private List<WhoList.Row> Rows() =>
        [.. Sensing.Faces.Select(f => new WhoList.Row(f.Label ?? "Reading…", Note(f)))];

    private FaceTrends T => Sensing.FaceTrends;

    /// <summary>One reading averaged over the faces in view right now; "—" when none has it.</summary>
    private string Now(Func<FaceReadout, double?> read, string format)
    {
        var values = Sensing.Faces.Select(read).OfType<double>().ToList();
        return values.Count == 0 ? "—" : values.Average().ToString(format, CultureInfo.InvariantCulture);
    }

    /// <summary>"Session 54 · range 49–61"; waiting text before the first point.</summary>
    private static string Span(double? mean, (double Low, double High)? range, string format)
    {
        var ic = CultureInfo.InvariantCulture;
        if (mean is not { } m) return "Waiting for a face";
        var text = $"Session {m.ToString(format, ic)}";
        return range is { } r ? $"{text} · range {r.Low.ToString(format, ic)}–{r.High.ToString(format, ic)}" : text;
    }

    private List<WhoList.Row> BodyRows() =>
        [.. Sensing.Bodies.InView.Select(b => new WhoList.Row($"Body {b.Slot}", b.Cues == BodyCues.None ? "open" : string.Join(" · ", Cues(b.Cues))))];

    private static IEnumerable<string> Cues(BodyCues cues) =>
        Enum.GetValues<BodyCues>().Where(c => c != BodyCues.None && cues.HasFlag(c)).Select(Words);

    private static string Words(BodyCues cue) => cue switch
    {
        BodyCues.ArmsCrossed => "arms crossed",
        BodyCues.HandsOnHips => "hands on hips",
        BodyCues.HandToFace => "hand to face",
        BodyCues.HandsBehindHead => "hands behind head",
        BodyCues.LeaningIn => "leaning in",
        BodyCues.LeaningBack => "leaning back",
        _ => cue.ToString(),
    };

    /// <summary>"mostly open (84%) · arms crossed 2m 10s · leaning in 5m 00s"; null before a body was read for a few seconds.</summary>
    private string? BodySummary()
    {
        var b = Sensing.Bodies;
        if (b.ObservedSeconds < 5) return null;
        var open = b.OpenSeconds / b.ObservedSeconds;
        var parts = new List<string> { $"{(open >= 0.5 ? "mostly open" : "mostly closed")} ({open.ToString("P0", CultureInfo.InvariantCulture)} open)" };
        parts.AddRange(b.CueSeconds.Where(p => p.Value >= 1).OrderByDescending(p => p.Value).Select(p => $"{Words(p.Key)} {DisplayText.Duration(p.Value)}"));
        return string.Join(" · ", parts);
    }

    private static string Note(FaceReadout face)
    {
        var ic = CultureInfo.InvariantCulture;
        var parts = new List<string>(3)
        {
            face.Beauty is { } beauty ? string.Create(ic, $"beauty {beauty:0}") : "beauty —",
        };
        if (face.AgeBand is { } age) parts.Add(string.Create(ic, $"age {age} ({face.AgeConfidence * 100:0}%)"));
        if (face.Readings > 0)
        {
            parts.Add(face.Presentation is { } presentation
                ? string.Create(ic, $"{presentation}-presenting ({face.PresentationConfidence * 100:0}%)")
                : "presentation unclear");
        }
        return string.Join(" · ", parts);
    }
}
