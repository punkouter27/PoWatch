@page "/"
@implements IAsyncDisposable
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject StatsFeed Feed

<PageTitle>Live · PoWatch</PageTitle>

@* One session, one toolbar; configuration folds away, diagnostics live on System.
   The desktop grid stays three columns, with page scrolling instead of scrollable cards. *@
<div class="dash" data-inference-ms="@L.DetectorLatencyMs.ToString(CultureInfo.InvariantCulture)">
    <div class="stats-toolbar" data-test="stats-toolbar">
        <span class="stats-window term-stat-hint" data-test="stats-window">@WindowLabel</span>
        <SessionControls>
            <StartActions>
                <RadzenButton Text="@(_starting ? "Starting..." : "Start camera")" Icon="videocam"
                              Disabled="@_starting" Click="@(() => StartAsync(demo: false))" data-test="start-camera" />
                <RadzenButton Text="Try demo" ButtonStyle="ButtonStyle.Light" Disabled="@_starting"
                              Click="@(() => StartAsync(demo: true))" data-test="start-demo" />
            </StartActions>
        </SessionControls>
        <RadzenButton Text="Ask" Icon="chat_bubble_outline" ButtonStyle="ButtonStyle.Light"
                      Click="@(() => _askOpen = !_askOpen)" aria-expanded="@(_askOpen ? "true" : "false")"
                      aria-controls="session-ask" data-test="ask-toggle" />
        <a href="system" class="term-button session-health" data-test="session-health">
            @(L.LastError is not null || L.LostTicks > 0 ? "Needs attention" : L.PendingBatches > 0 ? "Saving queued" : Sensing.IsRunning ? "Sensing active" : "System status")
        </a>
        @if (_sessionMissing)
        {
            <span class="live-error" role="status" data-test="session-missing">That session was not found, so this is your latest one.</span>
        }

        <div class="stats-ask-row" id="session-ask" hidden="@(!_askOpen)">
            <form class="stats-ask" @onsubmit="AskAsync" @onsubmit:preventDefault data-test="stats-ask">
                <label class="visually-hidden" for="ask">Ask a question about your stats</label>
                <input id="ask" @bind="_question" @bind:event="oninput" maxlength="300" autocomplete="off" placeholder="Ask: when is it usually busiest?" disabled="@_asking" />
                <button type="submit" class="term-button" disabled="@(_asking || string.IsNullOrWhiteSpace(_question))">@(_asking ? "…" : "Ask")</button>
            </form>
        </div>
        @if (_error is not null)
        {
            <p class="live-error" role="alert" data-test="live-error">@_error</p>
        }
    </div>

    @* Which models see, hear and write, each switchable right here. *@
    <AiSelectors />

    <AwayCard />

    @if (_answer is not null)
    {
        <p class="stats-answer" role="status" data-test="stats-answer"><b>ANSWER</b> @_answer</p>
    }

    <div class="dash-grid">
        <TerminalPanel Title="Camera" Class="live-camera" Test="live-camera" Flush="true">
            <Aside>
                @(Sensing.IsRunning ? (L.Demo ? "DEMO SCENE" : "CAMERA") : "STANDBY")
            </Aside>
            <ChildContent>
                @* The camera element itself lives in the layout and is docked over this slot. *@
                <div class="live-stage">
                    <div class="live-feed" @ref="_slot">
                        @if (!Sensing.IsRunning || L.Demo)
                        {
                            <canvas class="demo-flow" @ref="_demoCanvas" aria-hidden="true"></canvas>
                            <button type="button" class="term-button demo-effects" aria-pressed="@(_demoEffects ? "true" : "false")"
                                    @onclick="ToggleDemoEffects" data-test="demo-effects" title="Decorative simulation, not measured motion">
                                Effects @(_demoEffects ? "on" : "off")
                            </button>
                        }
                        @foreach (var track in Sensing.IsRunning ? L.Tracks : [])
                        {
                            <div @key="track.TrackId" class="live-box @(track.Label == "person" ? "live-box--person" : string.Empty)"
                                 data-uncertain="@(track.Box.Score < 0.6 ? "true" : "false")"
                                 style="left: @Pct(track.Box.X0 * 100)%; top: @Pct(track.Box.Y0 * 100)%; width: @Pct((track.Box.X1 - track.Box.X0) * 100)%; height: @Pct((track.Box.Y1 - track.Box.Y0) * 100)%;">
                                <span title="@($"Confidence {track.Box.Score:P0} · Track {track.TrackId}")">@(L.RegularFor(track.TrackId)?.DisplayName ?? track.Label)@(track.Box.Score < 0.6 ? " · uncertain" : null)</span>
                            </div>
                        }

                        @if (!Sensing.IsRunning)
                        {
                            <div class="live-standby" data-test="live-standby">
                                <p>Point a camera at anything, press Start, walk away.</p>
                                <p class="term-stat-hint">Use Start camera above, or try a private, scripted demo.</p>
                            </div>
                        }
                        else if (Sensing.Live.Demo)
                        {
                            <div class="live-demo-note" aria-hidden="true">DEMO SCENE · SYNTHETIC</div>
                        }
                    </div>
                </div>
            </ChildContent>
        </TerminalPanel>

        <KeyMetrics Range="session" Presence="@_presence" Patterns="@_patterns" OccupancyTrend="@_occupancyTrend" VisitsTrend="@_visitsTrend"
                    OnExplain="@EventCallback.Factory.Create(this, ExplainAsync)" Asking="@_asking" />
        <InFrame Objects="@_objects" Presence="@_presence" />

        @* What the camera and the microphone are turning into words, newest first, with the session's map. *@
        <TerminalPanel Title="Narration" Class="cell-narration" Test="live-narration-panel" Flush="true">
            <Aside>NEWEST FIRST</Aside>
            <ChildContent>
                <LiveNarration SessionId="@_sessionId" />
            </ChildContent>
        </TerminalPanel>

        @* The room's space in one grid: where motion is right now, or where people and animals were centred
           today; then the hottest spots and the edge of the frame things mostly come and go by. *@
        <TerminalPanel Title="Space" Class="cell-heat" Test="live-motion-grid">
            <Aside>
                <span class="space-switch" role="group" aria-label="Which heat to show">
                    <button type="button" class="@(_peopleHeat ? null : "on")" aria-pressed="@(_peopleHeat ? "false" : "true")" @onclick="() => _peopleHeat = false" data-test="space-motion">MOTION NOW</button>
                    <button type="button" class="@(_peopleHeat ? "on" : null)" aria-pressed="@(_peopleHeat ? "true" : "false")" @onclick="() => _peopleHeat = true" data-test="space-people">PEOPLE TODAY</button>
                </span>
            </Aside>
            <ChildContent>
                <div class="live-heat">
                    @if (_peopleHeat)
                    {
                        <HeatGrid Values="@(_space?.PresenceHeat ?? [])" Label="Where tracked people and animals were centred today" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0}")" />
                    }
                    else
                    {
                        <HeatGrid Values="@L.Heat.Select(v => (double)v).ToList()" Label="Where motion is happening right now" />
                    }
                </div>
                @if (_space is { } space)
                {
                    <p class="live-spots" data-test="stats-space">
                        MOTION <b>@(space.HottestCell >= 0 ? Cell(space.HottestCell) : "—")</b> · PEOPLE <b>@(space.FavouriteSpotCell >= 0 ? Cell(space.FavouriteSpotCell) : "—")</b> · DOOR <b>@space.BusiestEdge.ToUpperInvariant()</b>
                    </p>
                }
            </ChildContent>
        </TerminalPanel>

        <LiveEnvironment Query="@_query" />

        <LiveRegulars />
    </div>
</div>
