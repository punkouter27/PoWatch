@* Live's headline numbers for the range beside your usual day, and how far today sits from it (σ).
   Head counts (now, peak, visits) are In frame's. *@
@inject SensingSession Sensing

<TerminalPanel Title="Key metrics" Class="cell-metrics" Test="live-metrics" Flush="true">
    <Aside>@Range.ToUpperInvariant() vs USUAL</Aside>
    <ChildContent>
        <table class="term-table">
            <thead><tr><th>Metric</th><th class="r">Value</th><th class="r">Usual</th><th class="live-trend">Trend</th></tr></thead>
            <tbody>
                <tr data-test="metric-occupancy">
                    <td>OCCUPANCY</td>
                    <td class="r live-metric"><span data-test="stats-occupancy">@DisplayText.Percent(Presence?.Occupancy)</span> <ZChip Z="@Anomaly("occupancy")?.Z" /></td>
                    <td class="r">@DisplayText.Percent(Anomaly("occupancy")?.Mean)</td>
                    <td><Sparkline Values="@OccupancyTrend" Max="1" Label="Occupancy over the range" /></td>
                </tr>
                @* Visits an hour from a few minutes says nothing: the row waits for ten. *@
                @if (!RateTooEarly)
                {
                    <tr>
                        <td>VISITS/HR</td>
                        <td class="r live-metric">@DisplayText.Number(Presence?.VisitsPerHour, "0.0") <ZChip Z="@Anomaly("visits/hour")?.Z" /></td>
                        <td class="r">@DisplayText.Number(Anomaly("visits/hour")?.Mean, "0.0")</td>
                        <td><Sparkline Values="@VisitsTrend" Cyan="true" Label="Visits over the range" /></td>
                    </tr>
                }
                <tr>
                    <td title="Motion right now; usual is your daily mean">MOTION</td>
                    <td class="r live-metric"><span data-test="metric-motion">@L.Motion.ToString("0.000", CultureInfo.InvariantCulture)</span> <ZChip Z="@Anomaly("motion")?.Z" /></td>
                    <td class="r">@DisplayText.Number(Anomaly("motion")?.Mean, "0.000")</td>
                    <td><Sparkline Values="@L.MotionHistory" Label="Motion, last minute" /></td>
                </tr>
            </tbody>
        </table>
        @if (OnExplain.HasDelegate && Patterns?.Anomalies.Any(a => a.Flagged) == true)
        {
            @* The σ chips say how unusual today is; the model says what stands out, from the same tools Ask uses. *@
            <button class="term-button live-explain" @onclick="OnExplain" disabled="@Asking" data-test="metrics-explain">✦ Explain today</button>
        }
    </ChildContent>
</TerminalPanel>

@code {
    /// <summary>Visits an hour from a few minutes (342/h after 55 s) says nothing; the row waits for ten.</summary>
    private bool RateTooEarly => Presence is null || Presence.SecondsObserved < 600;

    [Parameter, EditorRequired] public string Range { get; set; } = "today";
    [Parameter] public PresenceStatsDto? Presence { get; set; }
    [Parameter] public PatternStatsDto? Patterns { get; set; }
    [Parameter] public IReadOnlyList<double> OccupancyTrend { get; set; } = [];
    [Parameter] public IReadOnlyList<double> VisitsTrend { get; set; } = [];

    /// <summary>Unset hides "Explain today" (the simple app has no Ask).</summary>
    [Parameter] public EventCallback OnExplain { get; set; }
    [Parameter] public bool Asking { get; set; }

    private LiveSensingState L => Sensing.Live;

    private AnomalyDto? Anomaly(string metric) => Patterns?.Anomalies.FirstOrDefault(a => a.Metric == metric);
}
