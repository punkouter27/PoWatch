@page "/"
@implements IAsyncDisposable
@using System.Globalization
@inject SensingSession Sensing
@inject PoWatchApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject StatsFeed Feed

<PageTitle>PoWatch</PageTitle>

@* Everything on one screen, always about one session: the one recording now, else the latest (or the
   one a Journal link names, ?session=). One bar (which session, the question box and
   the download), then a 3×3 around the camera (CSS dissolves each family's own grid into this one). Under
   the camera runs its narration: everything seen, said and heard, and who came and went. On a phone the
   panels after "In frame" become a strip you swipe through. Longer views live in the Journal. *@
<div class="dash">
    <div class="stats-toolbar" data-test="stats-toolbar">
        <span class="stats-window term-stat-hint" data-test="stats-window">@WindowLabel</span>
        @if (_sessionMissing)
        {
            <span class="live-error" role="status" data-test="session-missing">That session was not found, so this is your latest one.</span>
        }

        <div class="stats-ask-row">
            <form class="stats-ask" @onsubmit="AskAsync" data-test="stats-ask">
                <label class="visually-hidden" for="ask">Ask a question about your stats</label>
                <input id="ask" @bind="_question" @bind:event="oninput" maxlength="300" autocomplete="off" placeholder="Ask: when is it usually busiest?" disabled="@_asking" />
                <button type="submit" class="term-button" disabled="@(_asking || string.IsNullOrWhiteSpace(_question))">@(_asking ? "…" : "Ask")</button>
            </form>
            @* The grid shows the headlines; this file has every number behind them. *@
            <a class="term-button" href="@PoWatchApiClient.AllStatsUrl(_query)" download="PoWatch-session.json"
               title="Every number for this session, as one JSON file" aria-label="Download every number for this session (JSON)" data-test="stats-json">JSON ↓</a>
        </div>
    </div>

    @if (_answer is not null)
    {
        <p class="stats-answer" role="status" data-test="stats-answer"><b>ANSWER</b> @_answer</p>
    }

    <div class="dash-grid">
        <TerminalPanel Title="Camera" Class="live-camera" Test="live-camera" Flush="true">
            <Aside>
                @(Sensing.IsRunning ? (L.Demo ? "DEMO SCENE" : "CAMERA") : "STANDBY")
            </Aside>
            <ChildContent>
                @* The camera element itself lives in the layout and is docked over this slot. *@
                <div class="live-stage">
                    <div class="live-feed" @ref="_slot">
                        @foreach (var track in Sensing.IsRunning ? L.Tracks : [])
                        {
                            <div class="live-box @(track.Label == "person" ? "live-box--person" : string.Empty)"
                                 style="left: @Pct(track.Box.X0 * 100)%; top: @Pct(track.Box.Y0 * 100)%; width: @Pct((track.Box.X1 - track.Box.X0) * 100)%; height: @Pct((track.Box.Y1 - track.Box.Y0) * 100)%;">
                                <span>@(L.RegularFor(track.TrackId)?.DisplayName ?? track.Label) @track.Box.Score.ToString("0.00", CultureInfo.InvariantCulture) · #@track.TrackId</span>
                            </div>
                        }

                        @if (!Sensing.IsRunning)
                        {
                            <div class="live-standby" data-test="live-standby">
                                <p>Point a camera at anything, press Start, walk away.</p>
                                <div class="live-actions">
                                    <button class="term-button term-button--primary" @onclick="() => StartAsync(demo: false)" disabled="@_starting" data-test="start-camera">Start camera</button>
                                    <button class="term-button" @onclick="() => StartAsync(demo: true)" disabled="@_starting" data-test="start-demo">No camera? Try the demo</button>
                                </div>
                                @if (_error is not null)
                                {
                                    <p class="live-error" role="alert" data-test="live-error">@_error</p>
                                }
                            </div>
                        }
                        else if (Sensing.Live.Demo)
                        {
                            <div class="live-demo-note" aria-hidden="true">DEMO SCENE · SYNTHETIC</div>
                        }
                    </div>
                </div>
                @* What the camera and the microphone are turning into words, newest first. *@
                <LiveNarration SessionId="@_sessionId" />
            </ChildContent>
        </TerminalPanel>

        <KeyMetrics Range="session" Presence="@_presence" Patterns="@_patterns" OccupancyTrend="@_occupancyTrend" VisitsTrend="@_visitsTrend"
                    OnExplain="@EventCallback.Factory.Create(this, ExplainAsync)" Asking="@_asking" />
        <InFrame Objects="@_objects" />

        @* On a phone the rest is a strip you swipe through, with keys to jump; elsewhere it melts into the grid. *@
        <nav class="dash-pager" aria-label="Stat panels">
            @for (var i = 0; i < Pages.Length; i++)
            {
                var index = i;
                <button type="button" class="term-button" @onclick="() => ShowPanelAsync(index)">@Pages[i]</button>
            }
        </nav>
        <div class="dash-more" @ref="_more">
            @* The room's space in one panel: motion right now, or the session's motion or people heat, then
               where things mostly happen and which edge of the frame they come and go by. *@
            <TerminalPanel Title="Space" Class="cell-heat" Test="live-motion-grid">
                <Aside>
                    <span class="heat-modes" role="group" aria-label="What the grid shows">
                        @foreach (var (mode, label) in HeatModes)
                        {
                            <button type="button" class="heat-mode @(_heatMode == mode ? "heat-mode--on" : null)" aria-pressed="@(_heatMode == mode ? "true" : "false")"
                                    @onclick="() => _heatMode = mode" data-test="@($"heat-mode-{mode}")">@label</button>
                        }
                    </span>
                </Aside>
                <ChildContent>
                    <div class="live-heat">
                        @switch (_heatMode)
                        {
                            case "session":
                                <HeatGrid Values="@(_space?.MotionHeat ?? [])" Label="Motion across the frame this session" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0} of the hottest")" />
                                break;
                            case "people":
                                <HeatGrid Values="@(_space?.PresenceHeat ?? [])" Label="Where tracked people and animals were centred this session" CellTitle="@((i, v) => $"{Cell(i)} · {v:P0}")" />
                                break;
                            default:
                                <HeatGrid Values="@L.Heat.Select(v => (double)v).ToList()" Label="Where motion is happening right now" />
                                break;
                        }
                    </div>
                    @if (_space is { } space)
                    {
                        <p class="live-spots" data-test="stats-space">
                            MOTION <b>@(space.HottestCell >= 0 ? Cell(space.HottestCell) : "—")</b> · PEOPLE <b>@(space.FavouriteSpotCell >= 0 ? Cell(space.FavouriteSpotCell) : "—")</b> · DOOR <b>@space.BusiestEdge.ToUpperInvariant()</b>
                        </p>
                    }
                    <div class="live-edges">
                        @foreach (var edge in Edges)
                        {
                            <span>@edge <b>@(_space?.Entries.GetValueOrDefault(edge) ?? 0)↓ @(_space?.Exits.GetValueOrDefault(edge) ?? 0)↑</b></span>
                        }
                    </div>
                </ChildContent>
            </TerminalPanel>

            @* Pipeline numbers are operations, not the room: they live on System. *@
            <PresenceTab Query="@_query" />
            <PatternsTab Query="@_query" />
            <EnvironmentTab Query="@_query" />
        </div>
    </div>
</div>
